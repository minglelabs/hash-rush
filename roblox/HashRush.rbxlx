<roblox version="4"><Item class="Workspace"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Players"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool></Properties></Item><Item class="Lighting"><Properties><string name="Name">Lighting</string><bool name="GlobalShadows">false</bool><float name="Brightness">2</float><string name="TimeOfDay">15:00:00</string><float name="EnvironmentSpecularScale">0</float><Color3 name="Ambient"><R>0.75</R><G>0.75</G><B>0.75</B></Color3><Color3 name="OutdoorAmbient"><R>0.75</R><G>0.75</G><B>0.75</B></Color3></Properties></Item><Item class="ReplicatedStorage"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Every tuning value of the game. Distances are studs (10 web pixels = 1 stud),
-- times are seconds.

local Config = {}

Config.TICK_RATE = 60
Config.DT = 1 / Config.TICK_RATE

Config.HAMSTER_R = 1.5
Config.SPEED = 18.5
-- A hamster with a seed is slower, and slower still right before home.
Config.CARRY_SPEED = 0.85
Config.ALARM_RANGE = 19
Config.LAST_STRETCH_SPEED = 0.7

Config.COUNTDOWN = 3

-- Stalemate breaker: after `start` the home edge creeps towards the flower, from
-- `rush` it comes on fast. A seed comes loose quicker (down to `nibble` of the
-- usual time at `rush`), and whoever is knocked out sits dazed for `daze`.
-- At `finish` the round is called on bonks.
Config.OVERTIME = { start = 40, speed = 0.65, rush = 70, rushSpeed = 2.0, nibble = 0.45, daze = 1.5, finish = 105 }

Config.GATHER_TIME = 2.2
-- Four players is the baseline; more players nibble quicker.
function Config.gatherTime(players: number, time: number?): number
	local ot = Config.OVERTIME
	local late = math.clamp(((time or 0) - ot.start) / (ot.rush - ot.start), 0, 1)
	return (Config.GATHER_TIME * 4 / math.max(4, players)) * (1 - (1 - ot.nibble) * late)
end

-- Pickpocketing: an empty-handed rival who keeps rubbing up against a seed
-- carrier, moving or not, takes the seed in a third of the time a seed takes to
-- nibble. Whoever lost it cannot take it straight back for `block` seconds.
Config.PICK = { reach = 2 * Config.HAMSTER_R + 0.6, share = 1 / 3, block = 1 }
function Config.pickTime(players: number, time: number?): number
	return Config.gatherTime(players, time) * Config.PICK.share
end

Config.BONK = {
	windup = 0.14, -- standing still before the hit lands
	recovery = 0.42, -- stuck after the hit; a whiff is punishable
	cooldown = 0.8, -- from swing start until the next swing
	reach = 4, -- centre-to-centre distance that still hits
	arcCos = math.cos(math.rad(75)),
	recoveryMove = 0.15,
	chain = 2, -- a knock-out this soon after the last one makes a double, a triple...
	assist = 8, -- auto-aim picks the nearest rival inside this radius
}

Config.THROW = { charge = 0.4, max = 1.6, range = 12, width = 2.1 }

-- Lobby and round flow.
Config.MIN_PLAYERS = 2
Config.MAX_PLAYERS = 8
-- Once enough players are ready, the rest get this long to join in.
Config.LOBBY_COUNTDOWN = 10

-- One colour per seat, as { r, g, b } 0..255.
Config.COLORS = {
	{ 244, 162, 97 },
	{ 255, 255, 255 },
	{ 120, 144, 156 },
	{ 255, 213, 79 },
	{ 161, 136, 127 },
	{ 240, 98, 146 },
	{ 100, 181, 246 },
	{ 174, 213, 129 },
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Map</string><ProtectedString name="Source"><![CDATA[-- The meadow: home on the left, the sunflower on the right and a hedge maze in
-- between. Everything is data, in studs. Sim x runs left to right (world X), sim y
-- runs top to bottom on screen (world Z).

local CELL = 4
local COLS = 12
local ROWS = 13
local HEDGE_X1 = 21

-- Runs of open grid cells, { col, row, col, row }, counted from 0.
local LANES = {
	-- top
	{ 0, 1, 2, 1 }, { 2, 1, 2, 3 }, { 2, 3, 5, 3 }, { 5, 3, 5, 1 }, { 5, 1, 8, 1 }, { 8, 1, 8, 3 }, { 8, 3, 11, 3 },
	-- middle
	{ 0, 5, 3, 5 }, { 3, 5, 3, 7 }, { 3, 7, 6, 7 }, { 6, 7, 6, 5 }, { 6, 5, 9, 5 }, { 9, 5, 9, 7 }, { 9, 7, 11, 7 },
	-- bottom
	{ 0, 11, 2, 11 }, { 2, 11, 2, 9 }, { 2, 9, 5, 9 }, { 5, 9, 5, 11 }, { 5, 11, 8, 11 }, { 8, 11, 8, 9 }, { 8, 9, 11, 9 },
	-- cross links
	{ 3, 3, 3, 5 }, { 4, 7, 4, 9 }, { 8, 3, 8, 5 }, { 10, 7, 10, 9 },
}

local BOUNDS = { x1 = 2.4, y1 = 2, x2 = 89, y2 = 2 + ROWS * CELL }
local FLOWER = { x = 79, y = 28, r = 3, gatherR = 6.6 }
local HOME = { x1 = BOUNDS.x1, y1 = BOUNDS.y1, x2 = 15, y2 = BOUNDS.y2 }

-- Nests sit on an arc, top to bottom, so everyone starts as far from the middle lane.
local function arcNests(cx, cy, r, angles)
	local nests = {}
	for _, deg in angles do
		local a = math.rad(deg)
		table.insert(nests, { x = cx - math.cos(a) * r, y = cy + math.sin(a) * r })
	end
	return nests
end

local bigAngles = {}
for i = 0, 7 do
	table.insert(bigAngles, -66 + i * 132 / 7)
end

-- Every wall cell is covered by its longest horizontal and vertical run. The two
-- sets overlap, so the union only has rounded corners where a wall really ends.
local function hedgeRects()
	local open = {}
	for r = 0, ROWS - 1 do
		open[r] = {}
	end
	for _, lane in LANES do
		for c = math.min(lane[1], lane[3]), math.max(lane[1], lane[3]) do
			for r = math.min(lane[2], lane[4]), math.max(lane[2], lane[4]) do
				open[r][c] = true
			end
		end
	end
	local rects = {}
	for r = 0, ROWS - 1 do
		for c = 0, COLS - 1 do
			if not open[r][c] and (c == 0 or open[r][c - 1]) then
				local last = c
				while last + 1 < COLS and not open[r][last + 1] do
					last += 1
				end
				table.insert(rects, { x = HEDGE_X1 + c * CELL, y = BOUNDS.y1 + r * CELL, w = (last - c + 1) * CELL, h = CELL })
			end
		end
	end
	for c = 0, COLS - 1 do
		for r = 0, ROWS - 1 do
			if not open[r][c] and (r == 0 or open[r - 1][c]) then
				local last = r
				while last + 1 < ROWS and not open[last + 1][c] do
					last += 1
				end
				if last > r then
					table.insert(rects, { x = HEDGE_X1 + c * CELL, y = BOUNDS.y1 + r * CELL, w = CELL, h = (last - r + 1) * CELL })
				end
			end
		end
	end
	return rects
end

local Map = {
	world = { w = 91.4, h = 56 },
	bounds = BOUNDS,
	home = HOME,
	flower = FLOWER,
	-- Tunnels above and below the flower: an empty-handed hamster goes straight home.
	warps = {
		{ x = FLOWER.x, y = 6.4, r = 3.4 },
		{ x = FLOWER.x, y = 49.6, r = 3.4 },
	},
	nests = arcNests(HOME.x2, FLOWER.y, 10, { -36, -12, 12, 36 }),
	-- Used once more than four hamsters play.
	bigNests = arcNests(HOME.x2 + 2, FLOWER.y, 12.5, bigAngles),
	-- Hedges collide as rounded rectangles with this corner radius.
	rects = hedgeRects(),
	corner = 2,
}

-- Builds the map as anchored parts under Workspace.HashRushMap, and sets the
-- light. The folder's attributes tell the client where things are.
function Map.render()
	local Lighting = game:GetService("Lighting")
	local folder = Instance.new("Folder")
	folder.Name = "HashRushMap"
	local rng = Random.new(11)

	local function rgb(r, g, b)
		return Color3.fromRGB(r, g, b)
	end
	local function part(name, color, material, parent)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Material = material or Enum.Material.SmoothPlastic
		p.Color = color
		p.Parent = parent or folder
		return p
	end
	-- A box over the sim rectangle (x1, y1)-(x2, y2), standing on `base`.
	local function box(name, x1, y1, x2, y2, base, height, color, material, parent)
		local p = part(name, color, material, parent)
		p.Size = Vector3.new(x2 - x1, height, y2 - y1)
		p.Position = Vector3.new((x1 + x2) / 2, base + height / 2, (y1 + y2) / 2)
		return p
	end
	local function disc(name, x, y, r, base, height, color, material, parent)
		local p = part(name, color, material, parent)
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(height, 2 * r, 2 * r)
		p.CFrame = CFrame.new(x, base + height / 2, y) * CFrame.Angles(0, 0, math.rad(90))
		return p
	end
	-- An ellipsoid: a part wearing a sphere mesh.
	local function blob(name, cframe, size, color, parent)
		local p = part(name, color, nil, parent)
		p.Size = size
		p.CFrame = cframe
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		return p
	end
	local function sign(parent, text, studs)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromScale(studs, studs * 0.5)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.Parent = parent
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeTransparency = 1
		label.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2.5
		stroke.Color = rgb(74, 50, 30)
		stroke.Parent = label
	end

	local w = Map.world

	-- Light: an afternoon sun with soft shadows, colours a little richer than life.
	Lighting.GlobalShadows = true
	Lighting.Brightness = 2.4
	Lighting.ClockTime = 14.3
	Lighting.GeographicLatitude = 28
	Lighting.Ambient = rgb(150, 150, 165)
	Lighting.OutdoorAmbient = rgb(165, 165, 175)
	Lighting.EnvironmentSpecularScale = 0
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.ShadowSoftness = 0.35
	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "HashRushGrade"
	grade.Saturation = 0.2
	grade.Contrast = 0.06
	grade.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "HashRushBloom"
	bloom.Intensity = 0.3
	bloom.Size = 18
	bloom.Threshold = 1.5
	bloom.Parent = Lighting

	-- The meadow around the field.
	box("Ground", -400, -400, w.w + 400, w.h + 400, -1, 1, rgb(96, 170, 90), Enum.Material.Grass)

	-- The field: mown in a checkerboard of two greens.
	local TILE = 4
	local cols = math.ceil((BOUNDS.x2 - BOUNDS.x1) / TILE)
	local rows = math.ceil((BOUNDS.y2 - BOUNDS.y1) / TILE)
	for c = 0, cols - 1 do
		for r = 0, rows - 1 do
			local x1 = BOUNDS.x1 + c * TILE
			local y1 = BOUNDS.y1 + r * TILE
			local light = (c + r) % 2 == 0
			box("Field", x1, y1, math.min(BOUNDS.x2, x1 + TILE), math.min(BOUNDS.y2, y1 + TILE), 0, 0.1, if light then rgb(168, 222, 118) else rgb(154, 212, 106))
		end
	end

	-- The maze floor: a sandy path with a darker rim.
	local laneX2 = HEDGE_X1 + COLS * CELL
	box("LaneRim", HEDGE_X1 - 0.5, BOUNDS.y1, laneX2 + 0.5, BOUNDS.y2, 0.1, 0.04, rgb(206, 180, 128))
	for c = 0, COLS - 1 do
		for r = 0, ROWS - 1 do
			local x1 = HEDGE_X1 + c * CELL
			local y1 = BOUNDS.y1 + r * CELL
			local light = (c + r) % 2 == 0
			box("LaneFloor", x1, y1, x1 + CELL, y1 + CELL, 0.14, 0.04, if light then rgb(247, 232, 196) else rgb(241, 224, 184))
		end
	end

	-- Home. The client stretches these two as the home edge moves in overtime.
	box("Home", HOME.x1, HOME.y1, HOME.x2, HOME.y2, 0.2, 0.08, rgb(255, 226, 170), Enum.Material.Sand)
	local edge = box("HomeEdge", HOME.x2 - 0.25, HOME.y1, HOME.x2 + 0.25, HOME.y2, 0.28, 0.5, rgb(255, 150, 60), Enum.Material.Neon)
	edge.Transparency = 0.15
	local function nest(n)
		disc("Nest", n.x, n.y, 2.2, 0.28, 0.12, rgb(196, 150, 86))
		disc("Nest", n.x, n.y, 1.6, 0.4, 0.06, rgb(232, 196, 130))
	end
	for _, n in Map.bigNests do
		nest(n)
	end
	for _, n in Map.nests do
		nest(n)
	end

	-- A hedge is a rounded rectangle: two crossing boxes and a disc in each corner,
	-- with a lighter cap on top so it reads as a plump bush.
	local c = Map.corner
	local HEDGE_H = 1.9
	local side = rgb(52, 138, 70)
	local cap = rgb(98, 186, 92)
	local INSET = 0.6
	local corners = {}
	for _, r in Map.rects do
		if r.w > 2 * c then
			box("Hedge", r.x + c, r.y, r.x + r.w - c, r.y + r.h, 0.1, HEDGE_H, side, Enum.Material.Grass).CastShadow = true
		end
		if r.h > 2 * c then
			box("Hedge", r.x, r.y + c, r.x + r.w, r.y + r.h - c, 0.1, HEDGE_H, side, Enum.Material.Grass).CastShadow = true
		end
		for _, x in { r.x + c, r.x + r.w - c } do
			for _, y in { r.y + c, r.y + r.h - c } do
				local key = x .. "," .. y
				if not corners[key] then
					corners[key] = true
					disc("Hedge", x, y, c, 0.1, HEDGE_H, side, Enum.Material.Grass).CastShadow = true
					-- A blossom on some of the corners.
					if rng:NextNumber() < 0.45 then
						local petals = ({ rgb(255, 255, 255), rgb(255, 170, 200), rgb(255, 224, 110) })[rng:NextInteger(1, 3)]
						local bx = x + rng:NextNumber(-0.7, 0.7)
						local by = y + rng:NextNumber(-0.7, 0.7)
						blob("Blossom", CFrame.new(bx, 0.1 + HEDGE_H + 0.32, by), Vector3.new(0.85, 0.3, 0.85), petals)
						blob("Blossom", CFrame.new(bx, 0.1 + HEDGE_H + 0.42, by), Vector3.new(0.35, 0.25, 0.35), rgb(255, 200, 60))
					end
				end
			end
		end
	end

	-- The lighter cap, one piece per wall cell, drawn in from every side that
	-- faces a lane so the darker rim shows all the way round.
	local wall = {}
	for r = 0, ROWS - 1 do
		wall[r] = table.create(COLS, true)
		wall[r][0] = true
	end
	for _, lane in LANES do
		for col = math.min(lane[1], lane[3]), math.max(lane[1], lane[3]) do
			for r = math.min(lane[2], lane[4]), math.max(lane[2], lane[4]) do
				wall[r][col] = false
			end
		end
	end
	local function isWall(col, r)
		return r >= 0 and r < ROWS and col >= 0 and col < COLS and wall[r][col]
	end
	for r = 0, ROWS - 1 do
		for col = 0, COLS - 1 do
			if wall[r][col] then
				local x1 = HEDGE_X1 + col * CELL
				local y1 = BOUNDS.y1 + r * CELL
				box(
					"HedgeCap",
					x1 + (if isWall(col - 1, r) then 0 else INSET),
					y1 + (if isWall(col, r - 1) then 0 else INSET),
					x1 + CELL - (if isWall(col + 1, r) then 0 else INSET),
					y1 + CELL - (if isWall(col, r + 1) then 0 else INSET),
					0.1 + HEDGE_H,
					0.25,
					cap,
					Enum.Material.Grass
				)
			end
		end
	end

	-- The sunflower. The client sways the head.
	disc("GatherRing", FLOWER.x, FLOWER.y, FLOWER.gatherR, 0.12, 0.05, rgb(255, 246, 170)).Transparency = 0.55
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		disc("GatherDot", FLOWER.x + math.cos(a) * FLOWER.gatherR, FLOWER.y + math.sin(a) * FLOWER.gatherR, 0.32, 0.14, 0.06, rgb(255, 255, 255)).Transparency = 0.15
	end
	local flower = Instance.new("Model")
	flower.Name = "Sunflower"
	local HEAD_Y = 2.6
	local heart = disc("Heart", FLOWER.x, FLOWER.y, FLOWER.r * 0.62, HEAD_Y, 0.7, rgb(120, 76, 40), nil, flower)
	heart.CastShadow = true
	disc("HeartTop", FLOWER.x, FLOWER.y, FLOWER.r * 0.45, HEAD_Y + 0.7, 0.12, rgb(92, 56, 30), nil, flower)
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		local reach = FLOWER.r * 0.62 + 0.75
		local at = CFrame.new(FLOWER.x, HEAD_Y + 0.3 + (i % 2) * 0.12, FLOWER.y) * CFrame.Angles(0, -a, 0) * CFrame.new(reach, 0, 0)
		blob("Petal", at, Vector3.new(2.3, 0.45, 1.25), if i % 2 == 0 then rgb(255, 212, 50) else rgb(255, 190, 30), flower).CastShadow = true
	end
	-- No primary part: the pivot stays upright, so the client can nod the head.
	flower.WorldPivot = CFrame.new(FLOWER.x, HEAD_Y, FLOWER.y)
	flower.Parent = folder
	local stem = part("Stem", rgb(86, 160, 70))
	stem.Shape = Enum.PartType.Cylinder
	stem.Size = Vector3.new(HEAD_Y, 0.9, 0.9)
	stem.CFrame = CFrame.new(FLOWER.x, HEAD_Y / 2, FLOWER.y) * CFrame.Angles(0, 0, math.rad(90))
	for _, a in { 0.6, 3.6 } do
		blob("Leaf", CFrame.new(FLOWER.x, 0.5, FLOWER.y) * CFrame.Angles(0, a, 0) * CFrame.new(2.3, 0, 0), Vector3.new(3, 0.3, 1.5), rgb(98, 176, 78))
	end
	sign(heart, "🌻", 5)

	-- Burrows: a mound with a dark hole.
	for _, warp in Map.warps do
		disc("WarpMound", warp.x, warp.y, warp.r + 0.7, 0.1, 0.3, rgb(170, 122, 78))
		disc("WarpRim", warp.x, warp.y, warp.r, 0.4, 0.1, rgb(120, 82, 52))
		local hole = disc("Warp", warp.x, warp.y, warp.r - 0.8, 0.5, 0.05, rgb(46, 30, 22))
		sign(hole, "🏠 굴", 5)
	end

	-- A picket fence around the field.
	local wood = rgb(214, 170, 112)
	local function post(x, y)
		local p = part("FencePost", wood)
		p.Size = Vector3.new(0.6, 2, 0.6)
		p.Position = Vector3.new(x, 1, y)
		p.CastShadow = true
	end
	for x = BOUNDS.x1, BOUNDS.x2, 3.33 do
		post(x, BOUNDS.y1 - 0.5)
		post(x, BOUNDS.y2 + 0.5)
	end
	for y = BOUNDS.y1 + 3, BOUNDS.y2 - 3, 3.25 do
		post(BOUNDS.x1 - 0.5, y)
		post(BOUNDS.x2 + 0.5, y)
	end
	box("FenceRail", BOUNDS.x1 - 0.5, BOUNDS.y1 - 0.65, BOUNDS.x2 + 0.5, BOUNDS.y1 - 0.35, 1.1, 0.4, wood)
	box("FenceRail", BOUNDS.x1 - 0.5, BOUNDS.y2 + 0.35, BOUNDS.x2 + 0.5, BOUNDS.y2 + 0.65, 1.1, 0.4, wood)
	box("FenceRail", BOUNDS.x1 - 0.65, BOUNDS.y1 - 0.5, BOUNDS.x1 - 0.35, BOUNDS.y2 + 0.5, 1.1, 0.4, wood)
	box("FenceRail", BOUNDS.x2 + 0.35, BOUNDS.y1 - 0.5, BOUNDS.x2 + 0.65, BOUNDS.y2 + 0.5, 1.1, 0.4, wood)

	-- Outside the fence: bushes, rocks, wild flowers and a few trees.
	local function outside()
		while true do
			local x = rng:NextNumber(-26, w.w + 26)
			local y = rng:NextNumber(-20, w.h + 20)
			if x < BOUNDS.x1 - 2.5 or x > BOUNDS.x2 + 2.5 or y < BOUNDS.y1 - 2.5 or y > BOUNDS.y2 + 2.5 then
				return x, y
			end
		end
	end
	for _ = 1, 26 do
		local x, y = outside()
		-- A bush is a clump of three low mounds.
		for i = 1, 3 do
			local size = rng:NextNumber(2.2, 3.6)
			local bx = x + rng:NextNumber(-1.4, 1.4)
			local by = y + rng:NextNumber(-1.4, 1.4)
			local bush = blob("Bush", CFrame.new(bx, size * 0.2, by), Vector3.new(size, size * 0.6, size), if i % 2 == 0 then rgb(62, 142, 72) else rgb(76, 158, 80))
			bush.Material = Enum.Material.Grass
			bush.CastShadow = true
		end
	end
	for _ = 1, 16 do
		local x, y = outside()
		local size = rng:NextNumber(1.2, 2.6)
		blob("Rock", CFrame.new(x, size * 0.12, y) * CFrame.Angles(0, rng:NextNumber(0, 6), 0), Vector3.new(size * 1.3, size * 0.5, size), rgb(150, 152, 160)).CastShadow = true
	end
	for _ = 1, 60 do
		local x, y = outside()
		local petals = ({ rgb(255, 255, 255), rgb(255, 170, 200), rgb(255, 224, 110), rgb(190, 170, 255) })[rng:NextInteger(1, 4)]
		blob("WildFlower", CFrame.new(x, 0.25, y), Vector3.new(0.9, 0.3, 0.9), petals)
		blob("WildFlower", CFrame.new(x, 0.35, y), Vector3.new(0.38, 0.28, 0.38), rgb(255, 200, 60))
	end
	for _ = 1, 9 do
		local x, y = outside()
		if x < BOUNDS.x1 - 6 or x > BOUNDS.x2 + 6 or y < BOUNDS.y1 - 6 or y > BOUNDS.y2 + 6 then
			local trunk = part("Trunk", rgb(140, 98, 62))
			trunk.Shape = Enum.PartType.Cylinder
			trunk.Size = Vector3.new(3, 1.6, 1.6)
			trunk.CFrame = CFrame.new(x, 1.5, y) * CFrame.Angles(0, 0, math.rad(90))
			local crown = blob("Crown", CFrame.new(x, 4.2, y), Vector3.new(7.5, 5, 7.5), rgb(64, 146, 76))
			crown.Material = Enum.Material.Grass
			crown.CastShadow = true
			blob("Crown", CFrame.new(x + 0.8, 6, y - 0.6), Vector3.new(5, 3.6, 5), rgb(88, 170, 88)).Material = Enum.Material.Grass
		end
	end

	folder:SetAttribute("WorldW", w.w)
	folder:SetAttribute("WorldH", w.h)
	folder:SetAttribute("HomeX1", HOME.x1)
	folder:SetAttribute("HomeX2", HOME.x2)
	folder:SetAttribute("FlowerX", FLOWER.x)
	folder:SetAttribute("FlowerY", FLOWER.y)
	folder:SetAttribute("GatherR", FLOWER.gatherR)
	folder.Parent = workspace
	return folder
end

return Map
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Sim</string><ProtectedString name="Source"><![CDATA[-- The game itself, as plain logic: no Instances, no remotes, no clock. Every tick
-- it takes one input per player and advances the world by Config.DT.
--   input = { mx, my, bonk, throw }   move vector and the two buttons, held or not
-- Ported from the web game's src/sim/game.js (meadow, free-for-all).

local Config = require(script.Parent:WaitForChild("Config"))

local DT = Config.DT
local R = Config.HAMSTER_R
local BONK = Config.BONK
local THROW = Config.THROW
local OVERTIME = Config.OVERTIME
local PICK = Config.PICK

local Sim = {}

local EMPTY_INPUT = table.freeze({ mx = 0, my = 0, bonk = false, throw = false })

local function hypot(x, y)
	return math.sqrt(x * x + y * y)
end

-- Collision ---------------------------------------------------------------

-- Hedges collide as rounded rectangles: a core rect grown by the corner radius.
local function pushOutHedge(p, rect, corner)
	local cx = math.clamp(p.x, rect.x + corner, rect.x + rect.w - corner)
	local cy = math.clamp(p.y, rect.y + corner, rect.y + rect.h - corner)
	local dx = p.x - cx
	local dy = p.y - cy
	local min = R + corner
	local d2 = dx * dx + dy * dy
	if d2 >= min * min then
		return
	end
	if d2 > 1e-9 then
		local d = math.sqrt(d2)
		p.x = cx + dx / d * min
		p.y = cy + dy / d * min
		return
	end
	-- Centre is inside the core: leave through the nearest side.
	local left = p.x - rect.x
	local right = rect.x + rect.w - p.x
	local top = p.y - rect.y
	local bottom = rect.y + rect.h - p.y
	local m = math.min(left, right, top, bottom)
	if m == left then
		p.x = rect.x - R
	elseif m == right then
		p.x = rect.x + rect.w + R
	elseif m == top then
		p.y = rect.y - R
	else
		p.y = rect.y + rect.h + R
	end
end

local function pushOutFlower(p, f)
	local dx = p.x - f.x
	local dy = p.y - f.y
	local min = R + f.r
	local d2 = dx * dx + dy * dy
	if d2 >= min * min then
		return
	end
	local d = math.sqrt(d2)
	if d < 1e-6 then
		p.x = f.x + min
		return
	end
	p.x = f.x + dx / d * min
	p.y = f.y + dy / d * min
end

-- Walls, the flower and the map edge.
local function collide(map, p)
	local b = map.bounds
	for _ = 1, 2 do
		for _, rect in map.rects do
			pushOutHedge(p, rect, map.corner)
		end
		pushOutFlower(p, map.flower)
		p.x = math.clamp(p.x, b.x1 + R, b.x2 - R)
		p.y = math.clamp(p.y, b.y1 + R, b.y2 - R)
	end
end

local function segmentHitsRect(ax, ay, bx, by, x1, y1, x2, y2)
	local t0 = 0
	local t1 = 1
	local dx = bx - ax
	local dy = by - ay
	if math.abs(dx) < 1e-9 then
		if ax < x1 or ax > x2 then
			return false
		end
	else
		local ta = (x1 - ax) / dx
		local tb = (x2 - ax) / dx
		t0 = math.max(t0, math.min(ta, tb))
		t1 = math.min(t1, math.max(ta, tb))
		if t0 > t1 then
			return false
		end
	end
	if math.abs(dy) < 1e-9 then
		if ay < y1 or ay > y2 then
			return false
		end
	else
		local ta = (y1 - ay) / dy
		local tb = (y2 - ay) / dy
		t0 = math.max(t0, math.min(ta, tb))
		t1 = math.min(t1, math.max(ta, tb))
		if t0 > t1 then
			return false
		end
	end
	return true
end

local function distToSegment(px, py, ax, ay, bx, by)
	local dx = bx - ax
	local dy = by - ay
	local len2 = dx * dx + dy * dy
	local t = if len2 > 1e-9 then math.clamp(((px - ax) * dx + (py - ay) * dy) / len2, 0, 1) else 0
	return hypot(px - (ax + dx * t), py - (ay + dy * t))
end

local function pointRectDistance(px, py, x1, y1, x2, y2)
	return hypot(px - math.clamp(px, x1, x2), py - math.clamp(py, y1, y2))
end

local function segmentRectDistance(ax, ay, bx, by, x1, y1, x2, y2)
	if segmentHitsRect(ax, ay, bx, by, x1, y1, x2, y2) then
		return 0
	end
	return math.min(
		pointRectDistance(ax, ay, x1, y1, x2, y2),
		pointRectDistance(bx, by, x1, y1, x2, y2),
		distToSegment(x1, y1, ax, ay, bx, by),
		distToSegment(x2, y1, ax, ay, bx, by),
		distToSegment(x1, y2, ax, ay, bx, by),
		distToSegment(x2, y2, ax, ay, bx, by)
	)
end

-- A clear line from a to b: no hedge and no flower in between.
local function sight(map, a, b)
	local c = map.corner
	for _, r in map.rects do
		if segmentRectDistance(a.x, a.y, b.x, b.y, r.x + c, r.y + c, r.x + r.w - c, r.y + r.h - c) < c then
			return false
		end
	end
	local f = map.flower
	return distToSegment(f.x, f.y, a.x, a.y, b.x, b.y) >= f.r
end

-- The client uses this too, to place its own hamster ahead of the server.
Sim.collide = collide

-- Rules -------------------------------------------------------------------

-- Inside home nobody can bonk or be bonked, and a carrier who gets here wins.
local function inHome(g, p)
	return p.x < g.homeX
end
Sim.inHome = inHome

-- A carrier this close to home sets the alarm off and is slowest.
local function lastStretch(g, p)
	return p.carrying and p.x - g.homeX < Config.ALARM_RANGE
end
Sim.lastStretch = lastStretch

local function shuffle(list, rng)
	for i = #list, 2, -1 do
		local j = math.floor(rng() * i) + 1
		list[i], list[j] = list[j], list[i]
	end
end

-- slots: { { id = number, name = string }, ... }. rng returns a number in [0, 1).
function Sim.new(map, slots, rng)
	rng = rng or math.random
	local nests = table.clone(if #slots > #map.nests then map.bigNests else map.nests)
	shuffle(nests, rng)
	local players = {}
	local byId = {}
	for i, slot in slots do
		local p = {
			id = slot.id,
			name = slot.name,
			nest = nests[i],
			x = nests[i].x,
			y = nests[i].y,
			vx = 0,
			vy = 0,
			fx = 1,
			fy = 0,
			carrying = false,
			gather = 0,
			queued = -1,
			swing = nil, -- { windup = boolean, t, dx, dy }
			cooldown = 0,
			bonkHeld = false,
			charge = 0,
			dazed = 0,
			-- Pickpocketing: progress on the carrier `pickOn` (-1 for nobody), and how
			-- long until this one may try again after having its own seed taken.
			pick = 0,
			pickOn = -1,
			pickBlock = 0,
			steals = 0,
			chain = 0,
			chainUntil = 0,
			kills = 0,
			throws = 0,
			deaths = 0,
			seeds = 0,
		}
		players[i] = p
		byId[p.id] = p
	end
	return {
		map = map,
		tick = 0,
		time = 0,
		phase = "countdown", -- "countdown" | "playing" | "over"
		countdown = Config.COUNTDOWN,
		homeX = map.home.x2,
		nibbler = nil, -- id of whoever is at the flower's head of the line
		rng = rng,
		players = players,
		byId = byId,
		winners = {}, -- ids
		timeout = false,
		events = {},
	}
end

-- A player who left takes its hamster with it.
function Sim.remove(g, id)
	local p = g.byId[id]
	if not p then
		return
	end
	g.byId[id] = nil
	table.remove(g.players, table.find(g.players, p))
	if g.nibbler == id then
		g.nibbler = nil
	end
end

local function pickAim(g, p, mx, my, moveLen)
	local bestX, bestY
	local bestD = BONK.assist
	for _, e in g.players do
		if e ~= p and not inHome(g, e) then
			local tx = e.x + e.vx * BONK.windup - p.x
			local ty = e.y + e.vy * BONK.windup - p.y
			local d = hypot(tx, ty)
			if d < bestD and d > 1e-6 then
				bestD = d
				bestX = tx / d
				bestY = ty / d
			end
		end
	end
	if bestX then
		return bestX, bestY
	end
	if moveLen > 0.05 then
		return mx / moveLen, my / moveLen
	end
	return p.fx, p.fy
end

-- Hamsters are solid. Whoever walked into the other gives way, so standing still
-- in a lane blocks it and nobody can be shoved along.
local function separate(g)
	local players = g.players
	local min = 2 * R
	for _ = 1, 3 do
		for i = 1, #players do
			for j = i + 1, #players do
				local a = players[i]
				local b = players[j]
				local nx = b.x - a.x
				local ny = b.y - a.y
				local d = hypot(nx, ny)
				if d < min then
					if d < 1e-6 then
						nx = 1
						ny = 0
					else
						nx /= d
						ny /= d
					end
					local pa = math.max(0, a.vx * nx + a.vy * ny)
					local pb = math.max(0, -(b.vx * nx + b.vy * ny))
					local wa = if pa + pb > 1e-6 then pa / (pa + pb) else 0.5
					local overlap = min - d
					a.x -= nx * overlap * wa
					a.y -= ny * overlap * wa
					b.x += nx * overlap * (1 - wa)
					b.y += ny * overlap * (1 - wa)
					collide(g.map, a)
					collide(g.map, b)
				end
			end
		end
	end
end

local function sendHome(p)
	p.x = p.nest.x
	p.y = p.nest.y
	p.vx = 0
	p.vy = 0
	p.carrying = false
	p.gather = 0
	p.queued = -1
	p.swing = nil
	p.cooldown = 0
	p.charge = 0
	p.dazed = 0
	p.pick = 0
	p.pickOn = -1
end

local function respawn(g, p)
	sendHome(p)
	-- In overtime a knock-out costs more than the walk back.
	p.dazed = if g.time > OVERTIME.start then OVERTIME.daze else 0
	p.chain = 0
	p.chainUntil = 0
	p.deaths += 1
	table.insert(g.events, { type = "spawn", id = p.id, x = p.x, y = p.y })
end

-- Nobody brought a seed home in time: most knock-outs wins, then fewest times
-- knocked out, then most seeds picked. Players still level share the win.
local function timeoutWinners(players)
	local function better(a, b)
		local ka = a.kills + a.throws
		local kb = b.kills + b.throws
		if ka ~= kb then
			return ka > kb
		end
		if a.deaths ~= b.deaths then
			return a.deaths < b.deaths
		end
		return a.seeds > b.seeds
	end
	local top = players[1]
	for _, p in players do
		if better(p, top) then
			top = p
		end
	end
	local winners = {}
	for _, p in players do
		if not better(top, p) then
			table.insert(winners, p.id)
		end
	end
	return winners
end

-- Credits `a` with knocking out `victims`, by a bonk or a thrown seed.
local function strike(g, a, victims, bonked, thrown)
	if #victims == 0 then
		return
	end
	for _, v in victims do
		bonked[v] = true
		if thrown then
			a.throws += 1
		else
			a.kills += 1
		end
		-- `close` marks a seed stopped just short of home: a super play.
		table.insert(g.events, { type = "bonk", by = a.id, id = v.id, x = v.x, y = v.y, seed = v.carrying, close = lastStretch(g, v) })
	end
	-- Several down at once, or one after another in quick succession.
	a.chain = (if g.time <= a.chainUntil then a.chain else 0) + #victims
	a.chainUntil = g.time + BONK.chain
	if a.chain > 1 then
		table.insert(g.events, { type = "multi", by = a.id, n = a.chain })
	end
end

local function stepPlayer(g, p, inp, landing, throwing)
	-- Dazed at the nest: nothing it presses does anything until it wears off.
	if p.dazed > 0 then
		p.dazed = math.max(0, p.dazed - DT)
		inp = EMPTY_INPUT
	end
	p.cooldown = math.max(0, p.cooldown - DT)
	p.pickBlock = math.max(0, p.pickBlock - DT)

	local mx = inp.mx or 0
	local my = inp.my or 0
	local len = hypot(mx, my)
	if len > 1 then
		mx /= len
		my /= len
		len = 1
	end

	local pressed = inp.bonk and not p.bonkHeld
	p.bonkHeld = inp.bonk == true
	if pressed and not p.swing and p.cooldown <= 0 and not inHome(g, p) then
		local ax, ay = pickAim(g, p, mx, my, len)
		p.swing = { windup = true, t = 0, dx = ax, dy = ay }
		p.fx = ax
		p.fy = ay
		p.cooldown = BONK.cooldown
		table.insert(g.events, { type = "swing", id = p.id })
	end

	-- Holding the throw button with a seed winds up a throw, and letting go throws
	-- it. A swing already on its way lands first.
	local landed = not (p.swing and p.swing.windup)
	if inp.throw and p.carrying and not inHome(g, p) then
		p.charge += DT
		-- Fully wound up: it goes by itself.
		if p.charge >= THROW.max - 1e-9 and landed then
			table.insert(throwing, p)
			p.charge = 0
		end
	else
		local ready = p.charge >= THROW.charge - 1e-9 and p.carrying and not inHome(g, p)
		if ready and landed then
			table.insert(throwing, p)
		end
		p.charge = 0
	end

	local share = 1
	if p.carrying then
		share = if lastStretch(g, p) then Config.LAST_STRETCH_SPEED else Config.CARRY_SPEED
	end
	local speed = Config.SPEED * share
	local swing = p.swing
	if swing then
		swing.t += DT
		if swing.windup then
			p.vx = 0
			p.vy = 0
			if swing.t >= BONK.windup - 1e-9 then
				swing.windup = false
				swing.t = 0
				table.insert(landing, p)
			end
		else
			p.vx = mx * speed * BONK.recoveryMove
			p.vy = my * speed * BONK.recoveryMove
			if swing.t >= BONK.recovery - 1e-9 then
				p.swing = nil
			end
		end
	else
		p.vx = mx * speed
		p.vy = my * speed
		if len > 0.05 then
			p.fx = mx / len
			p.fy = my / len
		end
	end

	-- Winding up a throw, the hamster turns wherever it is steered.
	if p.charge > 0 and len > 0.05 then
		p.fx = mx / len
		p.fy = my / len
	end

	p.x += p.vx * DT
	p.y += p.vy * DT
	collide(g.map, p)
end

-- The flower feeds one hamster at a time. Whoever has waited in the ring longest
-- nibbles, and has to hold still to do it. Walking resets the progress; leaving
-- or bonking goes to the back of the line.
local function stepFlower(g)
	local players = g.players
	local f = g.map.flower
	local nibbler = nil
	for _, p in players do
		local inRing = not p.carrying and hypot(p.x - f.x, p.y - f.y) <= f.gatherR
		if not inRing or p.swing then
			p.queued = if inRing then g.tick else -1
			p.gather = 0
		else
			if p.queued < 0 then
				p.queued = g.tick
			end
			if not nibbler or p.queued < nibbler.queued then
				nibbler = p
			end
		end
	end
	g.nibbler = if nibbler then nibbler.id else nil
	for _, p in players do
		if p ~= nibbler then
			p.gather = 0
		end
	end
	if not nibbler then
		return
	end
	if hypot(nibbler.vx, nibbler.vy) > 0.1 then
		nibbler.gather = 0
		return
	end
	nibbler.gather += DT
	if nibbler.gather >= Config.gatherTime(#players, g.time) - 1e-9 then
		nibbler.gather = 0
		nibbler.queued = -1
		nibbler.carrying = true
		nibbler.seeds += 1
		g.nibbler = nil
		table.insert(g.events, { type = "seed", id = nibbler.id })
	end
end

-- Rubbing up against a rival's seed carrier fills a gauge, moving or not, and a
-- full gauge takes the seed. Only one hamster works on a carrier at a time:
-- whoever got furthest keeps at it, the rest start over. Losing touch, swinging,
-- or the carrier getting home first all reset it.
local function pickpocket(g)
	local players = g.players
	local need = Config.pickTime(#players, g.time)
	local working = {} -- [carrier] = whoever is furthest along on it
	for _, p in players do
		local on = nil
		if not p.carrying and not p.swing and p.pickBlock <= 0 and p.dazed <= 0 and not inHome(g, p) then
			local nearest = PICK.reach
			for _, c in players do
				if c ~= p and c.carrying and not inHome(g, c) then
					local d = hypot(c.x - p.x, c.y - p.y)
					if d <= nearest then
						on = c
						nearest = d
					end
				end
			end
		end
		if not on or on.id ~= p.pickOn then
			p.pick = 0
		end
		p.pickOn = if on then on.id else -1
		if on then
			local best = working[on]
			if not best or p.pick > best.pick then
				working[on] = p
			end
		end
	end
	for _, p in players do
		local c = if p.pickOn >= 0 then g.byId[p.pickOn] else nil
		if c then
			if working[c] ~= p then
				p.pick = 0
			else
				p.pick += DT
				if p.pick >= need - 1e-9 then
					c.carrying = false
					c.charge = 0
					c.pickBlock = PICK.block
					p.carrying = true
					p.pick = 0
					p.pickOn = -1
					p.steals += 1
					-- Taking it right at the door is a super play, as a bonk there is.
					table.insert(g.events, { type = "steal", by = p.id, id = c.id, x = c.x, y = c.y, close = c.x - g.homeX < Config.ALARM_RANGE })
				end
			end
		end
	end
end

local function finish(g, winners, timeout)
	g.phase = "over"
	g.winners = winners
	g.timeout = timeout
	table.insert(g.events, { type = "win", ids = winners, timeout = timeout })
end

-- inputs: { [id] = input }. Events of this tick are left in g.events.
function Sim.step(g, inputs)
	table.clear(g.events)
	if g.phase == "over" then
		return g
	end
	g.tick += 1

	if g.phase == "countdown" then
		local before = math.ceil(g.countdown - 1e-9)
		g.countdown -= DT
		if g.countdown <= 1e-9 then
			g.phase = "playing"
			table.insert(g.events, { type = "go" })
		else
			local after = math.ceil(g.countdown - 1e-9)
			if after ~= before then
				table.insert(g.events, { type = "count", n = after })
			end
		end
		return g
	end

	g.time += DT
	local map = g.map
	local players = g.players
	if g.time > OVERTIME.start then
		if g.homeX == map.home.x2 then
			table.insert(g.events, { type = "overtime" })
		end
		if g.time > OVERTIME.rush and g.time - DT <= OVERTIME.rush then
			table.insert(g.events, { type = "rush" })
		end
		-- A creep at first, then a rush. It stops over the near half of the flower's
		-- ring, where a seed is home the moment it is nibbled loose.
		local crept = (math.min(g.time, OVERTIME.rush) - OVERTIME.start) * OVERTIME.speed
		local rushed = math.max(0, g.time - OVERTIME.rush) * OVERTIME.rushSpeed
		g.homeX = math.min(map.flower.x, map.home.x2 + crept + rushed)
	end

	local landing = {}
	local throwing = {}
	for _, p in players do
		stepPlayer(g, p, inputs[p.id] or EMPTY_INPUT, landing, throwing)
	end
	separate(g)

	-- There is never a double knock-out. Hits landing on the same tick resolve one
	-- at a time in a random order, and whoever is already down loses its own hit.
	shuffle(landing, g.rng)
	shuffle(throwing, g.rng)
	local bonked = {}
	-- Thrown seeds go first: everyone on the line goes down.
	for _, a in throwing do
		if not bonked[a] then
			a.carrying = false
			a.swing = nil
			a.cooldown = BONK.cooldown
			local victims = {}
			for _, v in players do
				if v ~= a and not bonked[v] and not inHome(g, v) then
					local dx = v.x - a.x
					local dy = v.y - a.y
					local along = dx * a.fx + dy * a.fy
					if along >= 0 and along <= THROW.range and math.abs(dx * a.fy - dy * a.fx) <= THROW.width and sight(map, a, v) then
						table.insert(victims, v)
					end
				end
			end
			table.insert(g.events, { type = "throw", id = a.id, x = a.x, y = a.y, dx = a.fx, dy = a.fy, hit = #victims })
			strike(g, a, victims, bonked, true)
		end
	end
	-- A bonk lands on one hamster only: the nearest one in front.
	for _, a in landing do
		if not bonked[a] then
			local victim = nil
			local nearest = BONK.reach
			if not inHome(g, a) then
				for _, v in players do
					if v ~= a and not bonked[v] and not inHome(g, v) then
						local dx = v.x - a.x
						local dy = v.y - a.y
						local d = hypot(dx, dy)
						local inFront = d <= R or (dx * a.swing.dx + dy * a.swing.dy) / d >= BONK.arcCos
						if d <= nearest and inFront and sight(map, a, v) then
							victim = v
							nearest = d
						end
					end
				end
			end
			if victim then
				strike(g, a, { victim }, bonked, false)
			end
			table.insert(g.events, { type = "impact", id = a.id, x = a.x, y = a.y, dx = a.swing.dx, dy = a.swing.dy, hit = victim ~= nil })
		end
	end
	for _, v in players do
		if bonked[v] then
			respawn(g, v)
		end
	end

	-- A tunnel takes an empty-handed hamster straight back to its nest.
	for _, p in players do
		if not p.carrying then
			for _, w in map.warps do
				if hypot(p.x - w.x, p.y - w.y) <= w.r then
					local fromX, fromY = p.x, p.y
					sendHome(p)
					table.insert(g.events, { type = "warp", id = p.id, fromX = fromX, fromY = fromY, x = p.x, y = p.y })
					break
				end
			end
		end
	end

	for _, p in players do
		if p.carrying and inHome(g, p) then
			finish(g, { p.id }, false)
			return g
		end
	end

	pickpocket(g)

	if g.time >= OVERTIME.finish then
		finish(g, timeoutWinners(players), true)
		return g
	end

	stepFlower(g)
	return g
end

return Sim
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Snapshot</string><ProtectedString name="Source"><![CDATA[-- The world as the server sends it every tick, packed into a buffer so it stays
-- well under the size limit of an UnreliableRemoteEvent.
--
-- header (19 bytes): u8 round, u16 tick, u8 phase, f32 countdown, f32 time,
--   f32 homeX, u8 nibbler id (0 = nobody), u8 gather progress (0..255), u8 players
-- per player (16 bytes): u8 id, f32 x, f32 y, f32 facing angle, u8 flags,
--   u8 throw charge (0..255 of THROW.max), u8 pickpocket progress (0..255)

local Config = require(script.Parent:WaitForChild("Config"))

local Snapshot = {}

local HEADER = 19
local PER_PLAYER = 16
local PHASES = { "countdown", "playing", "over" }

local CARRYING, WINDUP, RECOVERY, DAZED, ALARM = 1, 2, 4, 8, 16

local function byte(fraction)
	return math.clamp(math.floor(fraction * 255 + 0.5), 0, 255)
end

-- `alarm(p)` says whether p is a carrier in the last stretch.
function Snapshot.encode(round, g, alarm)
	local players = g.players
	local b = buffer.create(HEADER + PER_PLAYER * #players)
	local gather = 0
	local pickTime = Config.pickTime(#players, g.time)
	local nibbler = g.nibbler and g.byId[g.nibbler]
	if nibbler then
		gather = nibbler.gather / Config.gatherTime(#players, g.time)
	end
	buffer.writeu8(b, 0, round % 256)
	buffer.writeu16(b, 1, g.tick % 65536)
	buffer.writeu8(b, 3, table.find(PHASES, g.phase) or 1)
	buffer.writef32(b, 4, g.countdown)
	buffer.writef32(b, 8, g.time)
	buffer.writef32(b, 12, g.homeX)
	buffer.writeu8(b, 16, g.nibbler or 0)
	buffer.writeu8(b, 17, byte(gather))
	buffer.writeu8(b, 18, #players)
	for i, p in players do
		local o = HEADER + (i - 1) * PER_PLAYER
		local flags = 0
		if p.carrying then
			flags += CARRYING
		end
		if p.swing then
			flags += if p.swing.windup then WINDUP else RECOVERY
		end
		if p.dazed > 0 then
			flags += DAZED
		end
		if alarm(p) then
			flags += ALARM
		end
		buffer.writeu8(b, o, p.id)
		buffer.writef32(b, o + 1, p.x)
		buffer.writef32(b, o + 5, p.y)
		buffer.writef32(b, o + 9, math.atan2(p.fy, p.fx))
		buffer.writeu8(b, o + 13, flags)
		buffer.writeu8(b, o + 14, byte(p.charge / Config.THROW.max))
		buffer.writeu8(b, o + 15, byte(p.pick / pickTime))
	end
	return b
end

function Snapshot.decode(b)
	local snap = {
		round = buffer.readu8(b, 0),
		tick = buffer.readu16(b, 1),
		phase = PHASES[buffer.readu8(b, 3)],
		countdown = buffer.readf32(b, 4),
		time = buffer.readf32(b, 8),
		homeX = buffer.readf32(b, 12),
		nibbler = buffer.readu8(b, 16),
		gather = buffer.readu8(b, 17) / 255,
		players = {},
	}
	for i = 1, buffer.readu8(b, 18) do
		local o = HEADER + (i - 1) * PER_PLAYER
		local flags = buffer.readu8(b, o + 13)
		local angle = buffer.readf32(b, o + 9)
		table.insert(snap.players, {
			id = buffer.readu8(b, o),
			x = buffer.readf32(b, o + 1),
			y = buffer.readf32(b, o + 5),
			fx = math.cos(angle),
			fy = math.sin(angle),
			carrying = bit32.btest(flags, CARRYING),
			windup = bit32.btest(flags, WINDUP),
			recovery = bit32.btest(flags, RECOVERY),
			dazed = bit32.btest(flags, DAZED),
			alarm = bit32.btest(flags, ALARM),
			charge = buffer.readu8(b, o + 14) / 255 * Config.THROW.max,
			pick = buffer.readu8(b, o + 15) / 255,
		})
	end
	return snap
end

return Snapshot
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript"><Properties><string name="Name">Bot</string><ProtectedString name="Source"><![CDATA[-- Computer-controlled hamster. A bot only reads the game state and returns the
-- same input a player sends, so any seat can be given to one:
--   local bot = Bot.new({ difficulty = "normal", seed = 7 })
--   inputs[id] = bot.think(g, id)   -- every tick, after Sim.step
-- Ported from the web game's src/ai/bot.js, for the meadow and everyone against
-- everyone: what it had for teams, other maps and their hazards is left out.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Sim = require(ReplicatedStorage:WaitForChild("Sim"))
local Nav = require(script.Parent:WaitForChild("BotNav"))
local Search = require(script.Parent:WaitForChild("BotSearch"))
local mulberry32 = require(script.Parent:WaitForChild("BotRng"))

local DT = Config.DT
local SPEED = Config.SPEED
local R = Config.HAMSTER_R
local BONK = Config.BONK
local THROW = Config.THROW
-- One web pixel in studs: the bot's distances are the web game's, in pixels.
local PX = Nav.PX
local inHome = Sim.inHome
local distToSegment = Nav.distToSegment

local Bot = {}

-- reaction: how stale the bot's view of others is (seconds)
-- lead: how well it makes up for that delay when timing a swing (0..1)
-- margin/jitter: how far inside its reach it wants a target before swinging
-- bait: chance to hover just out of reach, waiting for a whiff, before going in
-- hold: chance to stand its ground when charged, which is the stronger position
-- deny: chance to go after someone who picked up a seed
-- hunt: chance to clear a rival away from the flower instead of waiting in line
-- opportunism: swings per second at bystanders who happen to be in reach
-- caution: how strongly a seed carrier avoids rivals waiting near its route
-- toss: chance to throw the seed at a single rival standing in the way home
-- volley: chance to throw it when it would take down two, or a rival's seed
-- thrifty: this near home it never throws its seed away. The seed is the win; a
--   rival knocked down there is worth nothing next to it.
-- guard: carrying a seed, it swings at a rival rubbing up against it before the
--   gauge fills. A swing is the only way to shake a thief off, as nobody outruns
--   an empty-handed hamster with a seed.
-- freeze: how long it dithers before a swing it has decided on (seconds)
-- rally: whether it joins the chase after a seed it cannot head off in time
-- The rookie keeps to four simple things: go for a seed, go and stop a rival who
-- has one, carry its own seed home, and bonk whoever comes close. It is beatable
-- because it sees late and swings late, not because it stands about.
local DIFFICULTY = {
	easy = { reaction = 0.45, lead = 0, margin = 0, jitter = 9 * PX, bait = 0, hold = 0, deny = 1, hunt = 0, opportunism = 0.3, caution = 0.2, freeze = 0.3, rally = false, toss = 0, volley = 0 },
	normal = { reaction = 0.24, lead = 0.4, margin = 2 * PX, jitter = 4 * PX, bait = 0.25, hold = 0.5, deny = 0.7, hunt = 0.7, opportunism = 0.8, caution = 0.8, freeze = 0.09, rally = true, toss = 0.3, volley = 0.8 },
	hard = { reaction = 0.15, lead = 0.9, margin = 3 * PX, jitter = 1 * PX, bait = 0.55, hold = 1, deny = 1, hunt = 1, opportunism = 1.5, caution = 1.2, freeze = 0, rally = true, toss = 0.5, volley = 1, thrifty = 330 * PX, guard = true },
}
-- The top bot has hard's hands, and on top of them:
-- search: it plays each plan forward in a copy of the game and picks the best
--   (see BotSearch), instead of only following the rules below.
-- dance: up close it feints instead of walking in: a dash at the rival to draw a
--   swing, a step back out of reach so the swing misses, then in for the hit.
-- poach: with this many others better placed to stop a rival's seed, it leaves
--   that seed to them and goes for one of its own.
-- wary: it learns from being fooled. Once a rival has drawn a wasted swing out of
--   it and bonked it for that, it stops swinging at that rival just for running
--   at it. The number is how often it holds fire while it does not know the
--   rival's habit.
-- toss 0, boxed: it does not gamble its seed on one rival in the way. It throws
--   for two at once, for a rival's seed, or when one is ahead and another is
--   coming up within `boxed` behind, so the seed is as good as lost anyway.
-- trail: behind a rival that is running away it keeps this far back. A swing from
--   behind cannot reach anyone who keeps going; from here the rival's own swing
--   hits nothing, and the bot is on it while it is stuck.
-- rubAfter, rubHome: when it rubs up against a carrier for the seed all the same:
--   one that has run on this long without turning, and one that is nearly home.
-- lure: a rival nibbling still swings at whoever walks up. The bot dashes in to
--   this distance, where a swing looks sure to land, and straight back out.
-- clock: at the flower it nibbles on only while no rival can reach it before the
--   seed comes loose (with this much to spare), and goes to meet one that can.
-- ambush: a rival at its heels for this long is following, and a follower runs
--   straight into a swing: it stops dead and swings.
-- flinch: how soon after a swing starts it sees it, and steps back out of reach.
-- dodge: carrying a seed past a side lane, it steps back for this long from a
--   person who sets off to swing just as it crosses.
-- margin 7, hold 0: it swings only once a rival is well inside reach, and does
--   not stand its ground against a charge.
-- crowd: it does not swing at a rival without a seed while another one is this
--   near and ready to swing: that one would hit it while it is stuck.
DIFFICULTY.ace = table.clone(DIFFICULTY.hard)
for k, v in pairs({ margin = 7 * PX, hold = 0, crowd = 110 * PX, search = true, dance = true, poach = 1, wary = 0.5, clock = 0.15, toss = 0, boxed = 120 * PX, trail = 78 * PX, rubAfter = 1, rubHome = true, lure = 54 * PX, ambush = 0.2, dodge = 0.3, flinch = 0.15 }) do
	DIFFICULTY.ace[k] = v
end
Bot.DIFFICULTY = DIFFICULTY

local TOUCH = 2 * R
local DANGER_R = 110 * PX
local DANGER_K = 300 * PX
-- How far outside a tunnel's edge a bot stops when it does not mean to go in.
local RIM = 2 * PX
-- A seed carrier this close to home has every rival bot drop what it is doing.
local LAST_STAND = 260 * PX
local NO_TUNNELS = table.freeze({})

local function hypot(x, y)
	return math.sqrt(x * x + y * y)
end

local function dist(a, b)
	return hypot(a.x - b.x, a.y - b.y)
end

-- If `me` started a swing now, how far away would `e` be when it lands?
-- `lead` is how far ahead (seconds) to carry the target's movement on.
local function predictSwing(me, e, lead)
	local drift = if e.swing then 0 else lead
	local cx = e.x - me.x
	local cy = e.y - me.y
	local cd = hypot(cx, cy)
	local dx = cx + e.vx * drift
	local dy = cy + e.vy * drift
	local d = hypot(dx, dy)
	-- Hamsters are solid: one charging at me stops when it touches me.
	if cd > 1e-6 and ((d < TOUCH and d < cd) or dx * cx + dy * cy <= 0) then
		return math.min(cd, TOUCH)
	end
	return if d > 0 then d else 1
end

-- Which seats bots are thinking for, per game. Everyone else is a person.
local botsIn = setmetatable({}, { __mode = "k" })

function Bot.new(opts)
	opts = opts or {}
	local seed = opts.seed or 1
	local rng = mulberry32(seed)
	-- Every bot gets a slightly different temperament so they don't all play alike.
	local cfg = table.clone(DIFFICULTY[opts.difficulty] or DIFFICULTY.normal)
	for _, k in { "bait", "hold", "deny", "hunt" } do
		cfg[k] = math.clamp(cfg[k] + (rng() - 0.5) * 0.3, 0, 1)
	end
	local planner = if cfg.search then Search.new(seed, opts.stepsPerThink) else nil

	-- What the bot saw of everyone on each of the last ticks. It acts on the oldest.
	local delayTicks = math.max(1, math.round(cfg.reaction / DT))
	local frames = {}
	local frameCount = 0
	local newest = 0
	local flinchTicks = if cfg.flinch then math.round(cfg.flinch / DT) else 0

	local mem = {
		replanAt = 0,
		mode = "gather",
		path = nil,
		targetId = -1,
		entryY = -1,
		denyRolls = {},
		huntRoll = { id = -1, till = 0, yes = false },
		duel = { id = -1, bait = false, hold = false, till = 0, expires = 0 },
		spot = nil,
		nibbling = false,
		flee = { id = -1, since = 0, tick = -1 },
		tail = {},
		dodge = { id = -1, till = 0, x = 0, y = 0 },
		flinch = { id = -1, till = 0 },
		cut = nil,
		dance = { id = -1, nib = nil, out = false, turn = 0, till = 0, feints = 0, most = 0, expires = 0 },
		fooled = {},
		whiff = { id = -1, till = 0 },
		inReach = {},
		habit = {},
		patience = { id = -1, till = 0, hold = false },
		aimedAt = -1,
		noise = 0,
		noiseAt = 0,
		bonkDown = false,
		swingAt = -1,
		toss = nil, -- id of the rival a throw is being wound up for, -1 for one that is called off
		tossRoll = { id = -1, till = 0, yes = false },
		stuck = { x = 0, y = 0, at = 0 },
		nudge = { till = 0, x = 0, y = 0 },
		-- When each rival was last seen starting a swing, and whether it was winding
		-- up then: a swing cannot follow another for BONK.cooldown.
		swung = {},
	}

	-- This tick's view, shared by the helpers below.
	local g, id, me, map, nav, now, f
	local seen = {} -- the other hamsters, as they were `reaction` ago
	local laneUnits = {} -- those of them inside the lanes
	local entries = nil
	local tunnels = NO_TUNNELS
	local tunnelling = false
	local out = { mx = 0, my = 0, bonk = false, throw = false }
	local ahead = {}
	local hit = {}

	local function record()
		newest = newest % (delayTicks + 1) + 1
		frameCount = math.min(frameCount + 1, delayTicks + 1)
		local frame = frames[newest]
		if not frame then
			frame = {}
			frames[newest] = frame
		end
		local players = g.players
		for i, p in players do
			local s = frame[i]
			if not s then
				s = {}
				frame[i] = s
			end
			local swing = p.swing
			s.id = p.id
			s.x = p.x
			s.y = p.y
			s.vx = p.vx
			s.vy = p.vy
			s.carrying = p.carrying
			s.swing = if not swing then false elseif swing.windup then "windup" else "recovery"
			s.aimX = if swing then swing.dx else 0
			s.aimY = if swing then swing.dy else 0
			s.seeds = p.seeds
			s.nibbler = g.nibbler == p.id
			s.home = inHome(g, p)
			s.pickOn = p.pickOn
		end
		for i = #frame, #players + 1, -1 do
			frame[i] = nil
		end
	end

	-- The frame from `back` ticks ago, or the oldest there is.
	local function frameAgo(back)
		back = math.min(back, frameCount - 1)
		return frames[(newest - 1 - back) % (delayTicks + 1) + 1]
	end

	local function sawOf(who)
		for _, e in seen do
			if e.id == who then
				return e
			end
		end
		return nil
	end

	-- A lane with someone in it cannot be passed, so paths cost more through it.
	local function blocked(p, q)
		return Nav.blockCost(laneUnits, p, q)
	end

	local function steerTo(x, y)
		local dx = x - me.x
		local dy = y - me.y
		local d = hypot(dx, dy)
		if d < 3 * PX then
			return
		end
		out.mx = dx / d
		out.my = dy / d
	end

	local function follow(points)
		if not points or #points == 0 then
			return
		end
		-- Only a deliberate shortcut home may step into a tunnel.
		if table.find(map.warps, points[#points]) then
			tunnelling = true
		end
		local to = nav.nextTarget(me, points)
		steerTo(to.x, to.y)
	end

	-- A tunnel is part of the map like any lane: for a hamster without a seed it is
	-- a one-way hop from the flower's side to its own nest. Routes and travel
	-- distances count it whenever going in and walking on from the nest is shorter.
	local function travel(to)
		local best = nav.distance(me, to)
		for _, w in tunnels do
			-- As the crow flies is the least it could be: most targets are ruled out here.
			if dist(me, w) + dist(me.nest, to) < best then
				best = math.min(best, nav.distance(me, w) + nav.distance(me.nest, to))
			end
		end
		return best
	end

	local function route(to, extra)
		local points, cost = nav.findPath(me, to, extra)
		for _, w in tunnels do
			-- The least the tunnel way can cost; skip the search unless it could win.
			if dist(me, w) + dist(me.nest, to) < cost and nav.distance(me, w) + nav.distance(me.nest, to) < cost then
				local leg, legCost = nav.findPath(me, w, extra)
				local _, afterCost = nav.findPath(me.nest, to, extra)
				if legCost + afterCost < cost then
					points = leg
					cost = legCost + afterCost
				end
			end
		end
		return points, cost
	end

	-- The same for one of several places, after `nav.from(me, blocked)`.
	local function routeTo(to)
		local cost, via = nav.costTo(to)
		for _, w in tunnels do
			if dist(me, w) + dist(me.nest, to) < cost and nav.distance(me, w) + nav.distance(me.nest, to) < cost then
				local legCost, legVia = nav.costTo(w)
				local _, afterCost = nav.findPath(me.nest, to, blocked)
				if legCost + afterCost < cost then
					return nav.pathTo(w, legVia), legCost + afterCost
				end
			end
		end
		return nav.pathTo(to, via), cost
	end

	-- Rivals loitering near a leg of the route, e.g. at a lane mouth.
	local function danger(p, q)
		local c = 0
		for _, e in seen do
			if not e.home then
				local d = distToSegment(e.x, e.y, p.x, p.y, q.x, q.y)
				if d < DANGER_R then
					c += (if e.carrying then 0.35 else 1) * (1 - d / DANGER_R) * DANGER_K
				end
			end
		end
		return c * cfg.caution
	end

	local function wayHome(p, q)
		return blocked(p, q) + danger(p, q)
	end

	local function searchCost(p, q)
		return blocked(p, q) + (if me.carrying then danger(p, q) else 0)
	end

	local function nearestEntry(p)
		local best = entries[1]
		local bestD = nav.distance(p, best)
		for i = 2, #entries do
			local d = nav.distance(p, entries[i])
			if d < bestD then
				best = entries[i]
				bestD = d
			end
		end
		return best, bestD
	end

	local function lastStandFor(c)
		return c.x - g.homeX < LAST_STAND
	end

	-- Where could I cut off a seed carrier before it gets home?
	local function intercept(c, force)
		local entry, home = nearestEntry(c)
		local pts = nav.findPath(c, entry)
		local walked = 0
		local a = c
		for i, b in pts do
			local seg = dist(a, b)
			if seg >= 1 * PX then
				local s = if i == 1 then 40 * PX else 0
				while s <= seg do
					local P = { x = a.x + (b.x - a.x) * s / seg, y = a.y + (b.y - a.y) * s / seg }
					if P.x < g.homeX + 20 * PX then
						break
					end
					if travel(P) / SPEED <= (walked + s) / (SPEED * Config.CARRY_SPEED) then
						return P
					end
					s += 50 * PX
				end
				walked += seg
			end
			a = b
		end
		local door = { x = g.homeX + 26 * PX, y = entry.y }
		local deadline = home / (SPEED * Config.CARRY_SPEED) + 0.25
		if nav.distance(me, door) / SPEED <= deadline then
			return door
		end
		-- Too far to run: a tunnel by the flower drops me at my nest, ahead of it.
		local fromNest = nav.distance(me.nest, door) / SPEED
		local viaTunnel = nil
		local tunnelTime = math.huge
		for _, w in map.warps do
			local time = nav.distance(me, w) / SPEED + fromNest
			if time <= deadline then
				return w
			end
			if time < tunnelTime then
				tunnelTime = time
				viaTunnel = w
			end
		end
		-- Too late on paper. That is no reason to let it go: carriers get held up on
		-- the way and at the door, so head there anyway.
		if not force then
			return nil
		end
		-- Running at it shows the chase; the tunnel is only worth it when clearly quicker.
		return if nav.distance(me, door) / SPEED <= tunnelTime * 1.25 then door else viaTunnel
	end

	local function plan()
		mem.targetId = -1
		if me.carrying then
			local best, bestCost, bestVia = nil, math.huge, 0
			local kept, keptCost, keptVia = nil, math.huge, 0
			nav.from(me, wayHome)
			for _, entry in entries do
				local cost, via = nav.costTo(entry)
				if not best or cost < bestCost then
					best, bestCost, bestVia = entry, cost, via
				end
				if mem.mode == "home" and entry.y == mem.entryY then
					kept, keptCost, keptVia = entry, cost, via
				end
			end
			-- Stick with the lane already chosen unless another is clearly better.
			if kept and keptCost <= bestCost * 1.15 then
				best, bestVia = kept, keptVia
			end
			mem.mode = "home"
			mem.entryY = best.y
			mem.path = nav.pathTo(best, bestVia)
			return
		end

		-- Someone has a seed: stop it if I can get in its way.
		local target, targetAt = nil, nil
		local urgent = math.huge
		for _, c in seen do
			if not c.carrying or c.home then
				continue
			end
			-- A seed about to reach home is everybody's problem, whatever was rolled.
			local lastStand = cfg.rally and lastStandFor(c)
			local key = c.id * 1000 + c.seeds
			if mem.denyRolls[key] == nil then
				mem.denyRolls[key] = rng() < cfg.deny
			end
			if not mem.denyRolls[key] and not lastStand then
				continue
			end
			local near = dist(me, c) < 230 * PX and nav.clear(me, c)
			-- Let the others have that one. With enough of them better placed than I
			-- am to get in its way, nearer the door it is making for, the seed is
			-- theirs to stop and the flower is free: fetch a second seed and walk it
			-- home behind the commotion. Not when the first is about to get in.
			if cfg.poach and not lastStandFor(c) and not near then
				local door = { x = g.homeX + 26 * PX, y = nearestEntry(c).y }
				local mine = travel(door)
				local better = 0
				for _, e in seen do
					if e.id ~= c.id and not e.carrying and nav.distance(e, door) < mine then
						better += 1
					end
				end
				if better >= cfg.poach then
					continue
				end
			end
			-- Out of reach is no reason to shrug either: everyone keeps after the
			-- seed, except that with three or more chasers the one nearest the flower
			-- stays on it, ready to nibble the moment the seed is knocked loose.
			local chasers = 1
			local nearestFlower = true
			for _, e in seen do
				if e.id ~= c.id and not e.carrying then
					chasers += 1
					if dist(e, f) <= dist(me, f) then
						nearestFlower = false
					end
				end
			end
			local stays = chasers >= 3 and nearestFlower
			local at = if near then c else intercept(c, cfg.rally and (lastStand or not stays))
			if at and c.x < urgent then
				urgent = c.x
				target = c
				targetAt = at
			end
		end
		if target then
			mem.mode = "deny"
			mem.targetId = target.id
			-- Where to cut it off shifts a little with every step the carrier takes,
			-- and now and then jumps to another lane altogether. Do not turn round for
			-- that: stay with the spot picked a moment ago while it is still ahead of
			-- the carrier.
			local was = mem.cut
			if was and was.id ~= target.id then
				was = nil
			end
			local jumped = targetAt ~= target and (not was or dist(was.at, targetAt) > 110 * PX)
			if was and jumped and now < was.till and was.at.x < target.x - 30 * PX and not table.find(map.warps, targetAt) then
				targetAt = was.at
			elseif jumped then
				mem.cut = { id = target.id, at = targetAt, till = now + 1.2 }
			end
			mem.path = if targetAt == target then nil else (route(targetAt))
			return
		end

		-- Otherwise go for a seed. Only one hamster can nibble at a time and it has
		-- to hold still, so a rival near the flower has to be dealt with first.
		local fd = dist(me, f)
		local rival = nil
		local rivalD = math.huge
		if fd < 330 * PX and g.nibbler ~= id then
			for _, e in seen do
				if not e.carrying and not e.home and dist(e, f) <= 330 * PX then
					local d = if e.nibbler then 0 else dist(me, e)
					if d < rivalD then
						rivalD = d
						rival = e
					end
				end
			end
		end
		if rival then
			local roll = mem.huntRoll
			if roll.id ~= rival.id or now > roll.till then
				roll.id = rival.id
				roll.till = now + 2.5
				roll.yes = rng() < cfg.hunt
			end
			if roll.yes then
				mem.mode = "hunt"
				mem.targetId = rival.id
				mem.path = nil
				return
			end
		end
		mem.mode = "gather"
		if fd <= f.gatherR - 8 * PX then
			mem.path = nil
			return
		end
		-- Pick a free spot on the ring, preferably out of everyone's reach.
		local best, bestCost, bestSpot = nil, math.huge, nil
		local kept, keptCost = nil, math.huge
		nav.from(me, blocked)
		for _, spot in nav.gatherSpots do
			local crowd = 0
			for _, e in seen do
				local d = dist(e, spot)
				if d < TOUCH then
					crowd = math.huge
				elseif d < 70 * PX then
					crowd += 400 * PX
				end
			end
			if crowd ~= math.huge then
				local points, cost = routeTo(spot)
				cost += crowd
				if not best or cost < bestCost then
					best, bestCost, bestSpot = points, cost, spot
				end
				if spot == mem.spot then
					kept, keptCost = points, cost
				end
			end
		end
		-- Two spots are often as good as each other. Keep heading for the one already
		-- chosen unless another is clearly better, or the bot weaves between them.
		if kept and keptCost <= bestCost * 1.2 + 40 * PX then
			best, bestSpot = kept, mem.spot
		end
		mem.spot = bestSpot
		mem.path = best or { f }
	end

	-- Close-quarters movement against one opponent. Whoever walks into a hamster
	-- that is standing ready gets hit first, so: stand firm when charged, and when
	-- attacking, hover just out of reach to draw a swing at thin air before going in.
	local function engage(e)
		mem.targetId = e.id
		local duel = mem.duel
		if duel.id ~= e.id or now > duel.expires then
			duel.id = e.id
			duel.bait = rng() < cfg.bait
			duel.hold = rng() < cfg.hold
			duel.till = now + 0.5 + rng() * 1.1
			duel.expires = now + 2.4 + rng()
		end
		if not nav.clear(me, e) then
			follow((route(e)))
			return
		end
		local dx = e.x - me.x
		local dy = e.y - me.y
		local d = hypot(dx, dy)
		if d == 0 then
			d = 1
		end
		-- A swing that has started cannot be taken back: once it is seen, it has as
		-- good as landed, so that is the moment to go in. Without the footwork a bot
		-- waits until the rival is plainly stuck.
		if e.swing == "recovery" or (cfg.dance and e.swing and d > BONK.reach + 6 * PX) then
			steerTo(e.x, e.y)
			return
		end
		-- Right behind a rival that is running away there is nothing to hit: a swing
		-- from behind falls short of anyone who keeps going. All that can happen at
		-- its heels is that it turns and swings first. So follow a step out of that
		-- swing's reach, and be there when it has swung at nothing, or stops.
		local fleeing = cfg.trail and not e.swing and d < 140 * PX and (e.vx * dx + e.vy * dy) / d > 0.45 * SPEED
		local flee = mem.flee
		if not fleeing or flee.id ~= e.id or g.tick ~= flee.tick + 1 then
			flee.id = if fleeing then e.id else -1
			flee.since = now
		end
		flee.tick = g.tick
		-- Only one that has been going for a while: a step back in the middle of a
		-- fight is footwork, and is answered as such below.
		if fleeing and now - flee.since >= 0.35 then
			if d > cfg.trail then
				steerTo(e.x + e.vx * 0.12, e.y + e.vy * 0.12)
			end
			return
		end
		local charging = -(e.vx * dx + e.vy * dy) / d > 0.5 * SPEED
		if duel.hold and charging and d < 150 * PX then
			return
		end
		-- No feints against a rival with a seed: it is not there to fight, it is going
		-- past. Someone nibbling gets the short ones that draw its swing (see `lure`),
		-- unless its seed is about to come loose: then straight in.
		local busy = e.nibbler and hypot(e.vx, e.vy) < 20 * PX
		local hurry = busy and (not cfg.lure or Config.gatherTime(#g.players, now) - g.byId[e.id].gather < math.max(0, d - 60 * PX) / SPEED + 1.1)
		local dn = mem.dance
		if cfg.dance and busy and not hurry and (dn.id ~= e.id or now > dn.expires or not dn.nib) then
			dn.id = e.id
			dn.nib = now
			dn.out = false
			dn.turn = cfg.lure + rng() * 6 * PX
			dn.till = 0
			dn.feints = 0
			dn.most = 3
			dn.expires = now + 4
		elseif dn.nib then
			-- These feints are for the rival with its head down. Once that is well
			-- over, the next meeting gets the full footwork again.
			if busy then
				dn.nib = now
			elseif now - dn.nib > 1.5 then
				dn.id = -1
				dn.nib = nil
				dn.expires = 0
			end
		end
		if cfg.dance and not e.carrying and not hurry then
			-- Dash in to where a swing at me looks sure to land, then straight back
			-- out before it does. A few feints, and if nothing bites, go in for real.
			if dn.id ~= e.id or now > dn.expires then
				dn.id = e.id
				dn.nib = nil
				dn.out = false
				dn.turn = (58 + rng() * 10) * PX
				dn.till = 0
				dn.feints = 0
				dn.most = 2 + math.floor(rng() * 3)
				dn.expires = now + 4
			end
			if dn.feints < dn.most then
				if dn.out then
					out.mx = -dx / d
					out.my = -dy / d
					if now >= dn.till or d > 92 * PX then
						dn.out = false
						dn.turn = if dn.nib then cfg.lure + rng() * 6 * PX else (58 + rng() * 10) * PX
					end
				else
					out.mx = dx / d
					out.my = dy / d
					if d <= dn.turn then
						dn.out = true
						dn.till = now + 0.17 + rng() * 0.1
						dn.feints += 1
					end
				end
				return
			end
			steerTo(e.x + e.vx * 0.12, e.y + e.vy * 0.12)
			return
		end
		if duel.bait and now < duel.till then
			if d < 58 * PX then
				out.mx = -dx / d
				out.my = -dy / d
			elseif d > 68 * PX then
				out.mx = dx / d
				out.my = dy / d
			end
			return
		end
		steerTo(e.x + e.vx * 0.12, e.y + e.vy * 0.12)
	end

	-- Fills `into` with the rivals a seed thrown along (ax, ay) would reach,
	-- nearest first.
	local function byDistance(a, b)
		return dist(me, a) < dist(me, b)
	end
	local function inLine(into, ax, ay, reach, width)
		table.clear(into)
		for _, e in seen do
			local dx = e.x - me.x
			local dy = e.y - me.y
			local along = dx * ax + dy * ay
			if not e.home and along > 0 and along <= reach and math.abs(dx * ay - dy * ax) <= width and nav.sight(me, e) then
				table.insert(into, e)
			end
		end
		table.sort(into, byDistance)
		return into
	end

	local function face(e, k)
		local d = dist(me, e)
		if d == 0 then
			d = 1
		end
		out.mx = (e.x - me.x) / d * k
		out.my = (e.y - me.y) / d * k
	end

	-- A wind-up that has gone too far to be dropped would throw the seed at
	-- nothing, so a swing is started to swallow it instead; if no swing can start
	-- right now, it is held until one can. Returns whether to swing.
	local function swallow()
		if not me.swing and me.cooldown <= 0 and not mem.bonkDown then
			return true
		end
		mem.toss = -1
		return false
	end

	-- The same table every tick: read it before the next call.
	local function think(game_, seat)
		g = game_
		id = seat
		me = g.byId[id]
		out.mx = 0
		out.my = 0
		out.bonk = false
		out.throw = false
		if not me then
			return out
		end
		local bots = botsIn[g]
		if not bots then
			bots = {}
			botsIn[g] = bots
		end
		bots[id] = true
		record()
		if g.phase ~= "playing" then
			mem.bonkDown = false
			return out
		end

		map = g.map
		nav = Nav.get(map)
		now = g.time
		f = map.flower
		entries = nav.entries(g.homeX)
		tunnels = if me.carrying then NO_TUNNELS else map.warps
		tunnelling = false
		local meHome = inHome(g, me)

		table.clear(seen)
		for _, s in frameAgo(delayTicks) do
			if s.id ~= id and g.byId[s.id] then
				table.insert(seen, s)
				local was = mem.swung[s.id]
				local winding = s.swing == "windup"
				if winding and not (was and was.winding) then
					if was then
						was.at = now - cfg.reaction
						was.winding = true
					else
						mem.swung[s.id] = { at = now - cfg.reaction, winding = true }
					end
				elseif was then
					was.winding = winding
				end
			end
		end

		-- A thought that has just come to its end is taken up at once.
		if planner and planner.work() then
			mem.replanAt = 0
		end
		if now >= mem.replanAt then
			table.clear(laneUnits)
			for _, e in seen do
				if nav.inLanes(e) then
					table.insert(laneUnits, e)
				end
			end
			plan()
			mem.replanAt = now + (if planner then math.min(Search.every, 0.2) else 0.16 + rng() * 0.08)
			-- A rival at the flower with its head down is to be bonked, now. That is not
			-- up for a second opinion: weighing it is how a bot ends up standing and watching.
			local nibbler = if g.nibbler then g.byId[g.nibbler] else nil
			local atNibbler = mem.mode == "hunt" and nibbler ~= nil and mem.targetId == nibbler.id and hypot(nibbler.vx, nibbler.vy) < 20 * PX
			-- Nor is stopping a seed: the rule book defends, as the hard bot does. Its
			-- way of cutting a carrier off beat the look-ahead's second-guessing of it.
			local defending = mem.mode == "deny"
			-- At the flower with its own head down, the clock decides: stay if the seed
			-- comes loose before anyone can get here, otherwise deal with the first to come.
			local counted = false
			mem.nibbling = false
			if cfg.clock and g.nibbler == id and mem.mode == "gather" then
				local left = Config.gatherTime(#g.players, now) - me.gather
				local eta = math.huge
				for _, e in seen do
					if not e.home and not e.carrying then
						local way = if nav.clear(me, e) then dist(me, e) else nav.distance(me, e)
						eta = math.min(eta, math.max(0, way - BONK.reach) / SPEED + BONK.windup)
					end
				end
				if eta > left + cfg.clock then
					counted = true
					mem.nibbling = true
					mem.path = nil
				end
			end
			if planner and not atNibbler and not defending and not counted then
				local rules = { mode = mem.mode, targetId = mem.targetId, path = mem.path, entryY = mem.entryY }
				local idea = planner.choose(g, id, searchCost, rules)
				if idea ~= rules then
					mem.mode = idea.mode
					mem.targetId = idea.targetId or -1
					mem.path = idea.path
					if idea.entryY then
						mem.entryY = idea.entryY
					end
				end
			end
		end

		local target = if mem.targetId >= 0 then sawOf(mem.targetId) else nil
		if mem.mode == "home" then
			follow(mem.path)
			local met = false
			-- Someone standing in the way: fight through rather than walk into a bonk.
			for _, e in seen do
				if e.home then
					continue
				end
				local d = dist(me, e)
				if d > 150 * PX or not nav.clear(me, e) then
					continue
				end
				if (out.mx * (e.x - me.x) + out.my * (e.y - me.y)) / (if d > 0 then d else 1) < 0.5 then
					continue
				end
				out.mx = 0
				out.my = 0
				engage(e)
				met = true
				break
			end
			-- Someone in a side lane setting off for the spot I am about to cross
			-- means to be there with a swing as I pass (see `dodge`).
			if cfg.dodge and not met and (out.mx ~= 0 or out.my ~= 0) then
				local hx = out.mx
				local hy = out.my
				local lag = cfg.reaction + cfg.dodge
				local from = if now < mem.dodge.till then sawOf(mem.dodge.id) else nil
				if from and not from.home and from.swing ~= "recovery" then
					out.mx = mem.dodge.x
					out.my = mem.dodge.y
				else
					for _, e in seen do
						-- A person's trick. A bot never swings round a corner at what it
						-- cannot see, so from a bot there is nothing to step back from.
						if e.home or e.carrying or e.swing or bots[e.id] then
							continue
						end
						local dx = e.x - me.x
						local dy = e.y - me.y
						local d = hypot(dx, dy)
						if d == 0 then
							d = 1
						end
						-- From the side, that is: one ahead is met head on, one behind cannot reach.
						if d > 130 * PX or (hx * dx + hy * dy) / d < -0.2 or math.abs(e.vx * hy - e.vy * hx) < 0.4 * SPEED then
							continue
						end
						-- Only one that can have its swing there just as I cross.
						local mine = (hx * dx + hy * dy) / math.max(1 * PX, hypot(me.vx, me.vy)) - cfg.reaction
						local its = math.max(0, math.abs(hx * dy - hy * dx) - BONK.reach) / SPEED + BONK.windup
						if mine > its + 0.1 then
							continue
						end
						local atX = e.x + e.vx * lag
						local atY = e.y + e.vy * lag
						if distToSegment(atX, atY, me.x, me.y, me.x + hx * 100 * PX, me.y + hy * 100 * PX) > BONK.reach + 6 * PX then
							continue
						end
						-- Not back into somebody else.
						local behind = false
						for _, r in seen do
							if r ~= e and not r.home and dist(me, r) < 110 * PX and (r.x - me.x) * hx + (r.y - me.y) * hy < 0 then
								behind = true
								break
							end
						end
						if behind then
							continue
						end
						mem.dodge.id = e.id
						mem.dodge.till = now + cfg.dodge
						mem.dodge.x = -hx
						mem.dodge.y = -hy
						out.mx = -hx
						out.my = -hy
						break
					end
				end
			end
		elseif mem.mode == "deny" and target then
			if dist(me, target) < 230 * PX and nav.clear(me, target) then
				engage(target)
			elseif mem.path then
				follow(mem.path)
			else
				engage(target)
			end
		elseif mem.mode == "hunt" and target then
			engage(target)
		elseif mem.path then
			follow(mem.path)
		end

		-- A swing seen coming (see `flinch`): out of its reach, straight back. Nothing
		-- else it could do in that moment is worth being sent home for.
		local flinching = false
		if cfg.flinch and not me.swing and not meHome then
			for _, e in frameAgo(flinchTicks) do
				if e.id == id or e.home or not e.swing or not g.byId[e.id] then
					continue
				end
				local dx = me.x - e.x
				local dy = me.y - e.y
				local d = hypot(dx, dy)
				if d == 0 then
					d = 1
				end
				if e.swing == "windup" then
					-- Only one that would land: in reach, in its arc, nothing in between.
					if d > BONK.reach + 3 * PX or (d > R and (dx * e.aimX + dy * e.aimY) / d < BONK.arcCos - 0.1) then
						continue
					end
					if not nav.sight(me, e) then
						continue
					end
					out.mx = dx / d
					out.my = dy / d
					flinching = true
					mem.flinch.id = e.id
					mem.flinch.till = now + BONK.windup + BONK.recovery
					break
				end
				-- It has swung at nothing and is stuck: back in for the hit, unless there
				-- is a seed to take home instead.
				if e.id == mem.flinch.id and now < mem.flinch.till and not me.carrying and d < 90 * PX then
					out.mx = -dx / d
					out.my = -dy / d
					break
				end
			end
		end

		-- Break out of the rare case where steering presses into a corner.
		local stuck = mem.stuck
		if now - stuck.at > 0.6 then
			local wants = hypot(out.mx, out.my) > 0.5 and not me.swing
			if wants and hypot(me.x - stuck.x, me.y - stuck.y) < 5 * PX then
				local a = rng() * math.pi * 2
				mem.nudge.till = now + 0.3
				mem.nudge.x = math.cos(a)
				mem.nudge.y = math.sin(a)
				mem.replanAt = 0
			end
			stuck.x = me.x
			stuck.y = me.y
			stuck.at = now
		end

		-- Pickpocketing: at the heels of a seed carrier a swing falls short, but
		-- staying pressed up against it takes the seed. So a carrier that is not
		-- running at me gets rubbed up against instead of swung at, and once the gauge
		-- is going the bot keeps at it. One coming straight at me is still met with a
		-- swing. The top bot only does when the carrier cannot answer: right up
		-- against a carrier it is in reach of the carrier's swing, so otherwise it
		-- follows out of reach and punishes a swing at nothing (see `trail`). It goes
		-- in when that wait is not worth it: the carrier has just swung and cannot
		-- again before the gauge fills, it is nearly home, or it has kept running
		-- without ever turning.
		local rubbing = -1
		if not me.carrying and not meHome and me.pickBlock <= 0 and not me.swing and not flinching then
			for _, e in seen do
				if not e.carrying or e.home or not nav.clear(me, e) then
					continue
				end
				local dx = e.x - me.x
				local dy = e.y - me.y
				local d = hypot(dx, dy)
				local away = (e.vx * dx + e.vy * dy) / (if d > 0 then d else 1)
				if cfg.trail and me.pickOn ~= e.id then
					local left = Config.pickTime(#g.players, now)
					local swung = mem.swung[e.id]
					local free = if swung then math.max(0, swung.at + BONK.cooldown - now) else 0
					local unanswered = free + BONK.windup > left + 0.03
					-- Waiting for a swing only pays while there is time for one: not this
					-- close to home, nor behind one that has run on without turning.
					local runner = mem.flee.id == e.id and now - mem.flee.since >= cfg.rubAfter
					if not unanswered and not runner and not (cfg.rubHome and lastStandFor(e)) then
						continue
					end
				end
				if me.pickOn ~= e.id and (d > 110 * PX or away < -0.2 * SPEED) then
					continue
				end
				rubbing = e.id
				steerTo(e.x + e.vx * 0.15, e.y + e.vy * 0.15)
				break
			end
		end

		local wantX = out.mx
		local wantY = out.my
		if now < mem.nudge.till then
			out.mx = mem.nudge.x
			out.my = mem.nudge.y
		end

		if not me.carrying and not tunnelling then
			-- A seed carrier is safe from the tunnel it stands in, and whoever follows
			-- it in is sent home. Stop at the rim, which is still within reach of
			-- anyone inside.
			for _, w in map.warps do
				local rx = me.x - w.x
				local ry = me.y - w.y
				local d = hypot(rx, ry)
				if d == 0 then
					d = 1
				end
				local room = math.max(0, d - w.r - RIM) / (SPEED * DT)
				local inward = -(out.mx * rx + out.my * ry) / d
				if inward <= room then
					continue
				end
				out.mx += rx / d * (inward - room)
				out.my += ry / d * (inward - room)
				-- Headed straight in, that leaves it standing still: go round to the target's side.
				if target and hypot(out.mx, out.my) < 0.3 and dist(me, target) > BONK.reach - cfg.margin - cfg.jitter then
					local side = if -ry * (target.x - me.x) + rx * (target.y - me.y) < 0 then -1 else 1
					out.mx = side * -ry / d
					out.my = side * rx / d
				end
			end

			-- The last word on tunnels: a step that would end inside one is not taken.
			-- The rim logic above only cancels walking straight in. Sliding round the
			-- rim is another way in, above all between a tunnel and the map's edge,
			-- where there is no room to pass and the edge pushes a hamster inwards.
			if out.mx ~= 0 or out.my ~= 0 then
				local b = map.bounds
				local nx = math.clamp(me.x + out.mx * SPEED * DT, b.x1 + R, b.x2 - R)
				local ny = math.clamp(me.y + out.my * SPEED * DT, b.y1 + R, b.y2 - R)
				for _, w in map.warps do
					local next = hypot(nx - w.x, ny - w.y)
					if next < w.r + RIM and next < hypot(me.x - w.x, me.y - w.y) - 0.01 * PX then
						out.mx = 0
						out.my = 0
						break
					end
				end
			end
		end

		-- Seed throw. A carrier can give its seed up to knock down whoever is lined up
		-- ahead: well worth it for two at once or a rival's seed, a gamble against one
		-- hamster blocking the way. It winds up on the walk and lets go once it would hit.
		local abort = false
		if me.carrying and not meHome then
			local wl = hypot(wantX, wantY)
			local hx = if wl > 0.3 then wantX / wl else me.fx
			local hy = if wl > 0.3 then wantY / wl else me.fy
			inLine(ahead, hx, hy, THROW.range + 30 * PX, THROW.width + 6 * PX)
			-- Close to home the seed stays in its cheeks, whoever is standing there.
			local keep = cfg.thrifty and me.x - g.homeX < cfg.thrifty
			if keep and mem.toss then
				-- A wind-up begun further out is called off: dropped if it is early
				-- enough, otherwise swallowed by a swing.
				mem.toss = nil
				if me.charge >= THROW.charge - 2 * DT then
					abort = swallow()
				end
			end
			if not keep and not mem.toss and #ahead > 0 then
				local first = ahead[1]
				local roll = mem.tossRoll
				if roll.id ~= first.id or now > roll.till then
					local sure = #ahead > 1 or first.carrying
					-- Caught between one ahead and one coming up behind, the seed is lost
					-- either way: then it may as well take somebody with it.
					local boxed = false
					if cfg.boxed and not sure then
						for _, e in seen do
							if not e.home and not table.find(ahead, e) and dist(me, e) < cfg.boxed and nav.clear(me, e) and (e.x - me.x) * hx + (e.y - me.y) * hy < 0 then
								boxed = true
								break
							end
						end
					end
					roll.id = first.id
					roll.till = now + 3
					roll.yes = rng() < (if sure or boxed then cfg.volley else cfg.toss)
				end
				mem.toss = if roll.yes then first.id else nil
			end
			if mem.toss then
				out.throw = true
				-- Keep the one it wound up for in its sights, whatever the route home
				-- says, and stand off rather than walk into its reach.
				local mark = sawOf(mem.toss)
				local inSight = mark ~= nil and not mark.home and dist(me, mark) < THROW.range + 30 * PX and nav.sight(me, mark)
				if mark and inSight then
					face(mark, if dist(me, mark) < 90 * PX then 0.08 else 1)
				end
				inLine(hit, me.fx, me.fy, THROW.range - 8 * PX, THROW.width - 5 * PX)
				if me.charge >= THROW.charge and #hit > 0 then
					out.throw = false
					mem.toss = nil
					face(hit[1], 0.08)
				elseif not inSight or me.charge > THROW.max - 0.3 then
					-- It got away. A wind-up let go early is simply dropped.
					mem.toss = nil
					if me.charge < THROW.charge - 2 * DT then
						out.throw = false
					else
						abort = swallow()
					end
				end
			end
		else
			mem.toss = nil
		end

		if cfg.wary then
			-- How each rival comes at me: how near it gets before it turns away again.
			for _, e in seen do
				local dx = e.x - me.x
				local dy = e.y - me.y
				local d = hypot(dx, dy)
				if d == 0 then
					d = 1
				end
				local closing = -(e.vx * dx + e.vy * dy) / d
				local h = mem.habit[e.id]
				if not h then
					h = { coming = false, min = math.huge, turns = {} }
					mem.habit[e.id] = h
				end
				if e.home or d > 120 * PX then
					h.coming = false
				elseif closing > 0.4 * SPEED then
					h.min = if h.coming then math.min(h.min, d) else d
					h.coming = true
				elseif h.coming and closing < -0.3 * SPEED then
					table.insert(h.turns, math.min(h.min, d))
					if #h.turns > 3 then
						table.remove(h.turns, 1)
					end
					h.coming = false
				end
			end

			-- Fooled: I swung at somebody, hit nothing, and that same somebody bonked
			-- me while I was stuck. Once is enough to start treating it differently.
			for _, ev in g.events do
				if ev.type == "impact" and ev.id == id and mem.aimedAt >= 0 then
					if not ev.hit then
						mem.whiff.id = mem.aimedAt
						mem.whiff.till = now + 1
					end
					mem.aimedAt = -1
				end
			end
			for _, ev in g.events do
				if ev.type == "bonk" and ev.id == id then
					if ev.by == mem.whiff.id and now <= mem.whiff.till then
						mem.fooled[ev.by] = (mem.fooled[ev.by] or 0) + 1
					end
					break
				end
			end
		end

		-- Swing decision.
		local want = false
		local wantId = -1
		local wantDist = math.huge
		local giveX, giveY = nil, nil
		if not me.swing and me.cooldown <= 0 and not meHome then
			if now >= mem.noiseAt then
				mem.noise = (rng() * 2 - 1) * cfg.jitter
				mem.noiseAt = now + 0.4
			end
			local lead = BONK.windup + cfg.reaction * cfg.lead
			local limit = BONK.reach - cfg.margin + mem.noise
			for _, e in seen do
				-- Already rubbing away at it: a swing would only throw the gauge away.
				if e.home or (e.id == rubbing and me.pickOn == e.id) then
					continue
				end
				local reach = predictSwing(me, e, lead)
				if reach > limit or not nav.clear(me, e) then
					continue
				end
				-- A swing roots me through the hit and after it. With another rival
				-- close by and ready to swing, that is a free hit for it, so only a
				-- seed is worth it then.
				if cfg.crowd and not e.carrying and not me.carrying then
					local crowded = false
					for _, o in seen do
						if o.id ~= e.id and not o.home and o.swing ~= "recovery" and dist(o, me) < cfg.crowd then
							crowded = true
							break
						end
					end
					if crowded then
						continue
					end
				end
				local dx = e.x - me.x
				local dy = e.y - me.y
				local d = hypot(dx, dy)
				if d == 0 then
					d = 1
				end
				local closing = -((e.vx - me.vx) * dx + (e.vy - me.vy) * dy) / d
				local hostile = closing > 0.3 * SPEED or e.swing == "windup"
				-- Standing right where I am trying to go: the only way past is through.
				local inMyWay = d < BONK.reach and (wantX * dx + wantY * dy) / d > 0.5
				-- Rubbing up against my seed: that one is after it as surely as a swing is.
				local thief = cfg.guard and me.carrying and e.pickOn == id
				local wanted = thief or inMyWay or e.carrying or e.id == mem.targetId or e.swing == "recovery" or (not me.carrying and e.nibbler)
				-- At my heels, both of us running the same way, for long enough to be sure.
				local ambush = false
				if cfg.ambush then
					local tailing = not e.swing and not e.carrying and -(me.vx * dx + me.vy * dy) / d > 0.45 * SPEED and -(e.vx * dx + e.vy * dy) / d > 0.45 * SPEED
					if tailing then
						local was = mem.tail[e.id]
						if not was then
							was = { tick = -1, since = 0 }
							mem.tail[e.id] = was
						end
						if was.tick ~= g.tick - 1 then
							was.since = now
						end
						was.tick = g.tick
						ambush = now - was.since >= cfg.ambush
					end
				end
				if not hostile and not wanted and not ambush and rng() >= cfg.opportunism * DT then
					continue
				end
				-- The rival is not in reach yet, only on its way: this swing counts on it
				-- carrying on. That is exactly what a feint looks like, so a wary bot
				-- often lets it come, backing off, and swings once it is really there.
				-- A rival with a seed has to come through, so that one is swung at as
				-- ever. Not against a rival standing at the flower with its head down.
				local busy = e.nibbler and hypot(e.vx, e.vy) < 20 * PX
				if cfg.wary and not ambush and not thief and not e.swing and not e.carrying and not busy then
					local fooled = (mem.fooled[e.id] or 0) > 0
					local there = d <= BONK.reach - 3 * PX and closing > -0.2 * SPEED
					local stay = mem.inReach[e.id]
					if not stay then
						stay = { tick = -1, n = 0 }
						mem.inReach[e.id] = stay
					end
					stay.n = if not there then 0 elseif stay.tick == g.tick - 1 then stay.n + 1 else 1
					stay.tick = g.tick
					-- Where it will be when a swing started now lands, if it keeps coming.
					-- Once that is past the point of touching, the swing is too late: it
					-- will have bumped into me and may already be on its way back out.
					local inward = -(e.vx * dx + e.vy * dy) / d
					local onTime = inward > 0.5 * SPEED and d - inward * lead >= TOUCH + 1 * PX
					-- Against someone who has fooled it before, one guess per approach:
					-- take the swing, or let it come.
					local patience = mem.patience
					if patience.id ~= e.id or now > patience.till then
						patience.id = e.id
						patience.till = now + 0.7
						patience.hold = fooled and rng() < cfg.wary
					end
					-- It has shown how it comes at me. One that runs right up before it
					-- turns will be there when a well-timed swing lands, so that swing is
					-- always on. One that turns short of my reach is feinting or about to
					-- commit, and there is no telling which.
					local h = mem.habit[e.id]
					local comesClose = false
					if h and #h.turns > 0 then
						local sum = 0
						for _, t in h.turns do
							sum += t
						end
						comesClose = sum / #h.turns <= BONK.reach - 1 * PX
					end
					-- From the first meeting on, a swing at a rival running in is only ever
					-- the timely one. Once it has got as far as touching, swinging is what
					-- it wants: step back instead. A rival that is not rushing in is fair game.
					local fire = stay.n >= 3 or (onTime and (comesClose or not patience.hold)) or (not fooled and inward <= 0.5 * SPEED)
					if not fire then
						if not there then
							giveX = -dx / d
							giveY = -dy / d
						end
						continue
					end
				end
				if not want or reach < wantDist then
					want = true
					wantDist = reach
					wantId = e.id
				end
			end
		end
		if flinching then
			want = false
		end
		if giveX and not want and not mem.nibbling and not flinching and rubbing < 0 then
			out.mx = giveX
			out.my = giveY
			-- Not into a tunnel, though.
			if not me.carrying then
				for _, w in map.warps do
					if hypot(me.x + out.mx * 8 * PX - w.x, me.y + out.my * 8 * PX - w.y) < w.r + RIM + 2 * PX then
						out.mx = 0
						out.my = 0
						break
					end
				end
			end
		end

		-- A weaker bot dithers: the chance has to stay open for a moment before it swings.
		if not want then
			mem.swingAt = -1
		elseif mem.swingAt < 0 then
			mem.swingAt = now + cfg.freeze * (0.5 + rng())
		end
		if want and now < mem.swingAt then
			want = false
		end
		if abort and not want then
			want = true
			wantId = -1
		end
		if want and not mem.bonkDown then
			out.bonk = true
			mem.bonkDown = true
			mem.aimedAt = wantId
			-- A swing and a throw do not mix: the bonk goes first and the wind-up is dropped.
			out.throw = false
			mem.toss = nil
		else
			mem.bonkDown = false
		end
		return out
	end

	return { think = think }
end

return Bot
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">BotNav</string><ProtectedString name="Source"><![CDATA[-- Path finding for the bots, over a graph of waypoints: every bend, junction and
-- lane mouth of the maze, and the spots round the flower. Ported from the web
-- game's src/ai/nav.js, with the map helpers it needs (src/sim/map.js).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))

local R = Config.HAMSTER_R
-- One web pixel in studs. The bots were tuned in pixels; their distances are
-- written here as `pixels * PX`, so they follow Config and stay easy to compare.
local PX = R / 15
-- How far a walked line keeps from the hedges.
local PAD = R * 0.7
local BLOCK_COST = 900 * PX

local Nav = {}
Nav.PX = PX

local function hypot(x, y)
	return math.sqrt(x * x + y * y)
end

local function distToSegment(px, py, ax, ay, bx, by)
	local dx = bx - ax
	local dy = by - ay
	local len2 = dx * dx + dy * dy
	local t = if len2 > 1e-9 then math.clamp(((px - ax) * dx + (py - ay) * dy) / len2, 0, 1) else 0
	return hypot(px - (ax + dx * t), py - (ay + dy * t))
end
Nav.distToSegment = distToSegment

local function segmentHitsRect(ax, ay, bx, by, x1, y1, x2, y2)
	local t0 = 0
	local t1 = 1
	local dx = bx - ax
	local dy = by - ay
	if math.abs(dx) < 1e-9 then
		if ax < x1 or ax > x2 then
			return false
		end
	else
		local ta = (x1 - ax) / dx
		local tb = (x2 - ax) / dx
		t0 = math.max(t0, math.min(ta, tb))
		t1 = math.min(t1, math.max(ta, tb))
		if t0 > t1 then
			return false
		end
	end
	if math.abs(dy) < 1e-9 then
		if ay < y1 or ay > y2 then
			return false
		end
	else
		local ta = (y1 - ay) / dy
		local tb = (y2 - ay) / dy
		t0 = math.max(t0, math.min(ta, tb))
		t1 = math.min(t1, math.max(ta, tb))
		if t0 > t1 then
			return false
		end
	end
	return true
end

local function pointRectDistance(px, py, x1, y1, x2, y2)
	return hypot(px - math.clamp(px, x1, x2), py - math.clamp(py, y1, y2))
end

local function segmentRectDistance(ax, ay, bx, by, x1, y1, x2, y2)
	if segmentHitsRect(ax, ay, bx, by, x1, y1, x2, y2) then
		return 0
	end
	return math.min(
		pointRectDistance(ax, ay, x1, y1, x2, y2),
		pointRectDistance(bx, by, x1, y1, x2, y2),
		distToSegment(x1, y1, ax, ay, bx, by),
		distToSegment(x2, y1, ax, ay, bx, by),
		distToSegment(x1, y2, ax, ay, bx, by),
		distToSegment(x2, y2, ax, ay, bx, by)
	)
end

-- Extra path cost for a leg that someone is standing in. A lane is one hamster
-- wide, so whoever is in it cannot be passed and the path should go around.
-- Someone walking the same way ahead is barely an obstacle. `units` are the
-- hamsters inside the lanes (see `inLanes`).
function Nav.blockCost(units, p, q)
	local c = 0
	for _, u in units do
		if distToSegment(u.x, u.y, p.x, p.y, q.x, q.y) <= 2 * R then
			local lx = q.x - p.x
			local ly = q.y - p.y
			local len = hypot(lx, ly)
			local along = (u.vx * lx + u.vy * ly) / (if len > 0 then len else 1)
			c += if along > 0.6 * Config.SPEED then BLOCK_COST * 0.15 else BLOCK_COST
		end
	end
	return c
end

local function create(map)
	local corner = map.corner
	local flower = map.flower
	local bounds = map.bounds

	-- The hard middle of every hedge: a hedge is this, grown by the corner radius.
	local cores = {}
	-- The grid the hedges were cut from is not in the map data, but the hedges
	-- give it away: every one is a whole number of cells, one cell thick.
	local cell = math.huge
	local hedgeX1 = math.huge
	local hedgeX2 = -math.huge
	for _, r in map.rects do
		table.insert(cores, { x1 = r.x + corner, y1 = r.y + corner, x2 = r.x + r.w - corner, y2 = r.y + r.h - corner })
		cell = math.min(cell, r.w, r.h)
		hedgeX1 = math.min(hedgeX1, r.x)
		hedgeX2 = math.max(hedgeX2, r.x + r.w)
	end
	local cols = math.round((hedgeX2 - hedgeX1) / cell)
	local rows = math.round((bounds.y2 - bounds.y1) / cell)
	local wall = {}
	for r = 0, rows - 1 do
		wall[r] = {}
	end
	for _, rect in map.rects do
		local c1 = math.round((rect.x - hedgeX1) / cell)
		local r1 = math.round((rect.y - bounds.y1) / cell)
		for r = r1, r1 + math.round(rect.h / cell) - 1 do
			for c = c1, c1 + math.round(rect.w / cell) - 1 do
				wall[r][c] = true
			end
		end
	end
	local function isOpen(c, r)
		return r >= 0 and r < rows and c >= 0 and c < cols and not wall[r][c]
	end
	local function cellX(c)
		return hedgeX1 + (c + 0.5) * cell
	end
	local function cellY(r)
		return bounds.y1 + (r + 0.5) * cell
	end

	-- The hedges round each cell of the grid. A line is nearly always stopped by a
	-- hedge next to one of its ends, so those are looked at first.
	local around = {}
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			local list = {}
			local x1 = hedgeX1 + (c - 1) * cell
			local y1 = bounds.y1 + (r - 1) * cell
			for i, rect in map.rects do
				if rect.x < x1 + 3 * cell and rect.x + rect.w > x1 and rect.y < y1 + 3 * cell and rect.y + rect.h > y1 then
					table.insert(list, cores[i])
				end
			end
			around[r * cols + c] = list
		end
	end
	local function hedgesAround(x, y)
		local c = (x - hedgeX1) // cell
		local r = (y - bounds.y1) // cell
		return if c >= 0 and c < cols and r >= 0 and r < rows then around[r * cols + c] else nil
	end

	-- Which of map.rects a hamster at (x, y) could touch within a step of the
	-- game, as their places in that list: on a finer grid, the hedges within a
	-- hamster and a bit of each square. The grid reaches a cell past the hedges.
	local FINE = cell / 4
	local fineCols = (cols + 2) * 4
	local fineRows = rows * 4
	local fineX1 = hedgeX1 - cell
	local touching = {}
	for j = 0, fineRows - 1 do
		for i = 0, fineCols - 1 do
			local ids = {}
			local x1 = fineX1 + i * FINE
			local y1 = bounds.y1 + j * FINE
			for k, core in cores do
				local dx = math.max(0, core.x1 - (x1 + FINE), x1 - core.x2)
				local dy = math.max(0, core.y1 - (y1 + FINE), y1 - core.y2)
				if hypot(dx, dy) < corner + R + 10 * PX then
					table.insert(ids, k)
				end
			end
			touching[j * fineCols + i] = ids
		end
	end
	local function hedgesNear(x, y)
		local i = (x - fineX1) // FINE
		local j = (y - bounds.y1) // FINE
		return if i >= 0 and i < fineCols and j >= 0 and j < fineRows then touching[j * fineCols + i] else nil
	end

	local function blockedBy(list, ax, ay, bx, by, m)
		local lx = math.min(ax, bx) - m
		local hx = math.max(ax, bx) + m
		local ly = math.min(ay, by) - m
		local hy = math.max(ay, by) + m
		for _, r in list do
			-- Boxes apart by the margin on either axis cannot be nearer than it, nor
			-- can a line that misses the hedge's box grown by the margin.
			if r.x1 < hx and r.x2 > lx and r.y1 < hy and r.y2 > ly and segmentHitsRect(ax, ay, bx, by, r.x1 - m, r.y1 - m, r.x2 + m, r.y2 + m) then
				if segmentRectDistance(ax, ay, bx, by, r.x1, r.y1, r.x2, r.y2) < m then
					return true
				end
			end
		end
		return false
	end

	-- True when a straight line from a to b stays `pad` away from every obstacle.
	local function segmentClear(ax, ay, bx, by, pad)
		local m = corner + pad
		local nearA = hedgesAround(ax, ay)
		if nearA and blockedBy(nearA, ax, ay, bx, by, m) then
			return false
		end
		local nearB = hedgesAround(bx, by)
		if nearB and blockedBy(nearB, ax, ay, bx, by, m) then
			return false
		end
		if blockedBy(cores, ax, ay, bx, by, m) then
			return false
		end
		return distToSegment(flower.x, flower.y, ax, ay, bx, by) >= flower.r + pad
	end

	-- True when a circle of radius `pad` at (x, y) touches no obstacle.
	local function isFree(x, y, pad)
		for _, r in cores do
			if pointRectDistance(x, y, r.x1, r.y1, r.x2, r.y2) < corner + pad then
				return false
			end
		end
		return hypot(x - flower.x, y - flower.y) >= flower.r + pad
	end

	local gatherSpots = {}
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		table.insert(gatherSpots, { x = flower.x + math.cos(a) * 55 * PX, y = flower.y + math.sin(a) * 55 * PX })
	end

	-- Waypoints, in the web game's order, so that equally short paths are told
	-- apart the same way there and here.
	local nodes = {}
	local rowYs = {}
	for r = 0, rows - 1 do
		table.insert(rowYs, cellY(r))
		for c = 0, cols - 1 do
			if isOpen(c, r) then
				local w = isOpen(c - 1, r) or c == 0
				local e = isOpen(c + 1, r) or c == cols - 1
				local n = isOpen(c, r - 1)
				local s = isOpen(c, r + 1)
				local straight = (w and e and not n and not s) or (n and s and not w and not e)
				if not straight then
					table.insert(nodes, { x = cellX(c), y = cellY(r) })
				end
			end
		end
	end
	-- Rows where a lane opens on the home side: a point in front of it and one
	-- inside home.
	for r = 0, rows - 1 do
		if isOpen(0, r) then
			table.insert(nodes, { x = hedgeX1 - 30 * PX, y = cellY(r) })
			table.insert(nodes, { x = 80 * PX, y = cellY(r) })
		end
	end
	for r = 0, rows - 1 do
		if isOpen(cols - 1, r) then
			table.insert(nodes, { x = hedgeX2 + 40 * PX, y = cellY(r) })
		end
	end
	for _, spot in gatherSpots do
		table.insert(nodes, spot)
	end
	local n = #nodes

	local function clear(a, b)
		return segmentClear(a.x, a.y, b.x, b.y, PAD)
	end
	local function len(a, b)
		return hypot(a.x - b.x, a.y - b.y)
	end

	-- Which waypoints see each other, and the walking distance between every two.
	local adj = {}
	local D = {}
	for i = 1, n do
		adj[i] = {}
		D[i] = table.create(n, math.huge)
		D[i][i] = 0
	end
	for i = 1, n do
		for j = i + 1, n do
			if clear(nodes[i], nodes[j]) then
				local d = len(nodes[i], nodes[j])
				table.insert(adj[i], j)
				table.insert(adj[j], i)
				D[i][j] = d
				D[j][i] = d
			end
		end
	end
	for k = 1, n do
		local Dk = D[k]
		for i = 1, n do
			local Di = D[i]
			local ik = Di[k]
			for j = 1, n do
				if ik + Dk[j] < Di[j] then
					Di[j] = ik + Dk[j]
				end
			end
		end
	end

	-- The waypoints in plain view of a point, and how far each is. Kept per point
	-- (a hamster, a nest, a door...) for as long as it stays where it was: the same
	-- few points are asked about over and over, and looking is the costly part.
	local views = setmetatable({}, { __mode = "k" })
	local function view(p)
		local px, py = p.x, p.y
		local v = views[p]
		if v then
			if v.x == px and v.y == py then
				return v
			end
		else
			v = { x = 0, y = 0, n = 0, node = {}, leg = {} }
			views[p] = v
		end
		v.x = px
		v.y = py
		local count = 0
		for i = 1, n do
			local node = nodes[i]
			if segmentClear(px, py, node.x, node.y, PAD) then
				count += 1
				v.node[count] = i
				v.leg[count] = hypot(px - node.x, py - node.y)
			end
		end
		v.n = count
		return v
	end

	-- Walking distance between two points, ignoring everyone else.
	local function distance(a, b)
		if clear(a, b) then
			return len(a, b)
		end
		local va = view(a)
		local vb = view(b)
		local best = math.huge
		for i = 1, va.n do
			local row = D[va.node[i]]
			local da = va.leg[i]
			for j = 1, vb.n do
				local d = da + row[vb.node[j]] + vb.leg[j]
				if d < best then
					best = d
				end
			end
		end
		return best
	end

	local S = n + 1
	local G = n + 2
	local dist = table.create(n + 2, 0)
	local prev = table.create(n + 2, 0)
	local done = table.create(n + 2, false)
	local toGoal = table.create(n, false)

	local function relax(u, v, pu, pv, extra)
		local d = dist[u] + len(pu, pv) + (if extra then extra(pu, pv) else 0)
		if d < dist[v] then
			dist[v] = d
			prev[v] = u
		end
	end

	-- Shortest path from a to b, as a list of points ending in b, and its cost.
	-- `extra(p, q)` can add a cost to a leg, which is how bots steer around lanes
	-- that have a rival in them.
	local function findPath(a, b, extra)
		for i = 1, n + 2 do
			dist[i] = math.huge
			prev[i] = 0
			done[i] = false
		end
		for i = 1, n do
			toGoal[i] = false
		end
		local vb = view(b)
		for j = 1, vb.n do
			toGoal[vb.node[j]] = true
		end
		local va = view(a)
		local direct = clear(a, b)
		dist[S] = 0

		while true do
			local u = 0
			for i = 1, n + 2 do
				if not done[i] and (u == 0 or dist[i] < dist[u]) then
					u = i
				end
			end
			if u == 0 or dist[u] == math.huge or u == G then
				break
			end
			done[u] = true
			if u == S then
				for i = 1, va.n do
					relax(S, va.node[i], a, nodes[va.node[i]], extra)
				end
				if direct then
					relax(S, G, a, b, extra)
				end
			else
				local pu = nodes[u]
				for _, v in adj[u] do
					if not done[v] then
						relax(u, v, pu, nodes[v], extra)
					end
				end
				if toGoal[u] then
					relax(u, G, pu, b, extra)
				end
			end
		end

		if dist[G] == math.huge then
			return { b }, math.huge
		end
		local points = { b }
		local i = prev[G]
		while i ~= S do
			table.insert(points, 1, nodes[i])
			i = prev[i]
		end
		return points, dist[G]
	end

	-- The same search from one point to many: `from` works out the way to every
	-- waypoint once, then `costTo` and `pathTo` answer for any end point, with the
	-- answers `findPath` would give. They speak of the last `from`.
	local treeDist = table.create(n, 0)
	local treePrev = table.create(n, 0)
	local treeRank = table.create(n, 0)
	local treeA = nil
	local treeExtra = nil

	local function from(a, extra)
		treeA = a
		treeExtra = extra
		for i = 1, n do
			dist[i] = math.huge
			done[i] = false
		end
		local va = view(a)
		for i = 1, va.n do
			local v = va.node[i]
			dist[v] = va.leg[i] + (if extra then extra(a, nodes[v]) else 0)
			prev[v] = S
		end
		local rank = 0
		while true do
			local u = 0
			for i = 1, n do
				if not done[i] and (u == 0 or dist[i] < dist[u]) then
					u = i
				end
			end
			if u == 0 or dist[u] == math.huge then
				break
			end
			done[u] = true
			rank += 1
			treeRank[u] = rank
			local pu = nodes[u]
			for _, v in adj[u] do
				if not done[v] then
					relax(u, v, pu, nodes[v], extra)
				end
			end
		end
		for i = 1, n do
			treeDist[i] = dist[i]
			treePrev[i] = prev[i]
		end
	end

	-- The cost of the way to b, and the waypoint it comes in by.
	local function costTo(b)
		local a = treeA
		local extra = treeExtra
		local best = math.huge
		local via = 0
		if clear(a, b) then
			best = len(a, b) + (if extra then extra(a, b) else 0)
			via = S
		end
		local vb = view(b)
		for j = 1, vb.n do
			local u = vb.node[j]
			if treeDist[u] < math.huge then
				local d = treeDist[u] + vb.leg[j] + (if extra then extra(nodes[u], b) else 0)
				-- Of two equally short ways, the one found first.
				if d < best or (d == best and via ~= S and treeRank[u] < treeRank[via]) then
					best = d
					via = u
				end
			end
		end
		return best, via
	end

	local function pathTo(b, via)
		local points = { b }
		while via ~= S and via ~= 0 do
			table.insert(points, 1, nodes[via])
			via = treePrev[via]
		end
		return points
	end

	-- The furthest point of a path that can be walked to in a straight line.
	local function nextTarget(from, points)
		for i = #points, 2, -1 do
			if clear(from, points[i]) then
				return points[i]
			end
		end
		return points[1]
	end

	-- Spots just inside home that a seed carrier can aim for, one per open row.
	-- Home's edge moves in overtime; the spots move with it.
	local rowEntries = {}
	for i, y in rowYs do
		rowEntries[i] = { x = 0, y = y }
	end
	local entries = {}
	local entriesAt = nil
	local function entriesFor(homeX)
		if homeX ~= entriesAt then
			entriesAt = homeX
			table.clear(entries)
			for _, e in rowEntries do
				e.x = homeX - 14 * PX
				if isFree(e.x, e.y, R) then
					table.insert(entries, e)
				end
			end
		end
		return entries
	end

	return {
		gatherSpots = gatherSpots,
		clear = clear,
		-- A line of sight, as the game's bonks and throws need one.
		sight = function(a, b)
			return segmentClear(a.x, a.y, b.x, b.y, 0)
		end,
		-- Anyone standing between the two ends of the hedge is inside a lane.
		inLanes = function(u)
			return u.x > hedgeX1 - R and u.x < hedgeX2 + R
		end,
		hedgesNear = hedgesNear,
		distance = distance,
		findPath = findPath,
		from = from,
		costTo = costTo,
		pathTo = pathTo,
		nextTarget = nextTarget,
		entries = entriesFor,
	}
end

local cache = setmetatable({}, { __mode = "k" })

function Nav.get(map)
	local nav = cache[map]
	if not nav then
		nav = create(map)
		cache[map] = nav
	end
	return nav
end

return Nav
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">BotRng</string><ProtectedString name="Source"><![CDATA[-- Small seeded random number generator, so a bot with the same seed plays the
-- same way every time. The same one as the web game's (mulberry32), number for
-- number.

-- 32-bit multiply: a plain product of two 32-bit numbers does not fit a double.
local function imul(a, b)
	local al = bit32.band(a, 0xFFFF)
	local bl = bit32.band(b, 0xFFFF)
	local cross = bit32.band(bit32.rshift(a, 16) * bl + al * bit32.rshift(b, 16), 0xFFFF)
	return (al * bl + cross * 0x10000) % 0x100000000
end

-- Returns a function that gives the next number in [0, 1).
return function(seed: number): () -> number
	local a = math.floor(seed) % 0x100000000
	return function()
		a = (a + 0x6D2B79F5) % 0x100000000
		local t = imul(bit32.bxor(a, bit32.rshift(a, 15)), bit32.bor(a, 1))
		t = bit32.bxor(t, (t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))) % 0x100000000)
		return bit32.bxor(t, bit32.rshift(t, 14)) / 0x100000000
	end
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">BotSearch</string><ProtectedString name="Source"><![CDATA[-- The thinking part of the top bot. Instead of following fixed rules for what to
-- do next, it lists a handful of plans ("go for the seed", "cut that carrier off
-- at the door", "take the tunnel home"...), plays each one forward a couple of
-- seconds in a copy of the game with everyone else doing the obvious thing, and
-- takes the plan that leaves it best off. The hands stay the bot's own: this only
-- chooses the plan. Ported from the web game's src/ai/search.js.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Sim = require(ReplicatedStorage:WaitForChild("Sim"))
local Nav = require(script.Parent:WaitForChild("BotNav"))
local mulberry32 = require(script.Parent:WaitForChild("BotRng"))

local PX = Nav.PX
local R = Config.HAMSTER_R
local BONK = Config.BONK
local inHome = Sim.inHome

-- How far ahead a plan is played out, and how often the bot thinks again.
-- `edge` is how much better than the rule book's own plan another plan has to
-- look before the bot leaves the rule book; `keep` is the same for changing its
-- mind. A plan once chosen is given `commit` seconds: within that time only a
-- much better one (`jump` points) replaces it. The scores are rough, and a bot
-- that changes its mind three times a second gets nowhere.
local SEARCH = { horizon = 2.4, every = 0.3, keep = 25, edge = 60, commit = 1.2, jump = 320 }

local Search = {}
Search.every = SEARCH.every

local function dist(a, b)
	local dx = a.x - b.x
	local dy = a.y - b.y
	return math.sqrt(dx * dx + dy * dy)
end

local function copy(g, seed)
	local c = table.clone(g)
	c.players = table.create(#g.players)
	c.byId = {}
	for i, p in g.players do
		local q = table.clone(p)
		if q.swing then
			q.swing = table.clone(q.swing)
		end
		c.players[i] = q
		c.byId[q.id] = q
	end
	c.events = {}
	c.rng = mulberry32(seed)
	return c
end

-- A driver turns a hamster's situation into where to walk, cheaply: along a list
-- of points, or at somebody. It writes into `out`, the hamster's input.
local function walker(points)
	local i = 1
	return function(_, p, out)
		while i < #points and dist(p, points[i]) < 14 * PX do
			i += 1
		end
		local to = points[i]
		local d = dist(p, to)
		if d < 4 * PX then
			out.mx = 0
			out.my = 0
		else
			out.mx = (to.x - p.x) / d
			out.my = (to.y - p.y) / d
		end
	end
end

local function chaser(targetId, points)
	local walk = if points and #points > 0 then walker(points) else nil
	return function(c, p, out)
		local e = c.byId[targetId]
		local d = dist(p, e)
		-- Close enough to see: go straight at it. Otherwise keep to the path there.
		if walk and d >= 110 * PX then
			walk(c, p, out)
		elseif d < 2 * PX then
			out.mx = 0
			out.my = 0
		else
			out.mx = (e.x - p.x) / d
			out.my = (e.y - p.y) / d
		end
	end
end

local function still(_, _, out)
	out.mx = 0
	out.my = 0
end

-- Whoever is near enough gets bonked. Everyone in the daydream does this.
local function withBonk(c, p, out)
	out.bonk = false
	if p.swing or p.cooldown > 0 or inHome(c, p) then
		return
	end
	for _, e in c.players do
		if e ~= p and not inHome(c, e) and dist(e, p) <= BONK.reach - 2 * PX then
			out.bonk = true
			return
		end
	end
end

-- How good things look for hamster `id` at the end of a daydream. `used` is the
-- share of the horizon it took.
local function judge(c, id, before, used)
	local me = c.byId[id]
	local f = c.map.flower
	if c.phase == "over" and not c.timeout then
		-- Sooner is better when winning, later when losing.
		return if table.find(c.winners, id) then 2000 - 400 * used else -2000 + 400 * used
	end
	local span = f.x - c.map.home.x2
	local s = 0
	for _, p in c.players do
		local side = if p == me then 1 else -1
		local was = before[p.id]
		if p.carrying then
			-- How far along the way home the seed is, 0 at the flower and 1 at the door.
			s += side * (260 + 520 * math.clamp((f.x - p.x) / span, 0, 1))
		end
		s -= side * 70 * (p.deaths - was.deaths) * (if p == me then 1.6 else 1)
		s += side * 15 * (p.kills - was.kills)
		-- A rival left to nibble in peace is a seed on its way.
		if side < 0 then
			s -= 140 * p.gather
		end
	end
	if not me.carrying then
		-- Being at the flower and nibbling is what leads to a seed.
		s -= 0.3 / PX * math.max(0, dist(me, f) - f.gatherR)
		s += 160 * me.gather
	end
	return s
end

-- A daydream only needs the hedges its hamsters are next to, and the game spends
-- most of a step pushing hamsters out of hedges that are nowhere near them. So
-- each map gets a twin whose list of hedges is cut down, before every step, to
-- the ones somebody could touch in it. The rest of the twin is the map's own.
local twins = setmetatable({}, { __mode = "k" })

local function twinOf(map)
	local twin = twins[map]
	if not twin then
		twin = { map = table.clone(map), mark = table.create(#map.rects, false) }
		twin.map.rects = {}
		twins[map] = twin
	end
	return twin
end

local function hedgesFor(c, map, nav, twin)
	local mark = twin.mark
	local near = twin.map.rects
	table.clear(near)
	local any = false
	for _, p in c.players do
		local ids = nav.hedgesNear(p.x, p.y)
		if ids then
			any = true
			for _, i in ids do
				mark[i] = true
			end
		end
	end
	if any then
		-- In the map's own order, so that everything comes out as it would there.
		for i, rect in map.rects do
			if mark[i] then
				mark[i] = false
				table.insert(near, rect)
			end
		end
	end
end

-- `stepsPerThink` is how many steps of daydream a call to `work` may play: the
-- thinking is spread over the ticks that follow, and the answer comes that much
-- later. Without it the bot thinks it all through on the spot, as on the web;
-- that is some thousand steps of the game in one tick.
function Search.new(seed: number, stepsPerThink: number?)
	local budget = stepsPerThink or math.huge
	local last = nil
	-- Bots do not all think on the same tick: each starts a little out of step.
	local lastAt = ((seed % 9) / 9) * SEARCH.every - SEARCH.every
	local thought = 0
	local since = 0
	local inputs = {} -- [id] = that hamster's input in the daydream
	local job = nil -- the thought it is in the middle of

	-- Plays the daydreams of the thought in hand on, and settles on a plan once the
	-- last one is through. Returns true when that happens.
	local function work()
		if not job then
			return false
		end
		local base = job.base
		local id = job.id
		local map = base.map
		local nav = Nav.get(map)
		local twin = twinOf(map)
		local ticks = math.round(SEARCH.horizon * Config.TICK_RATE)
		local left = budget
		while left > 0 do
			local plan = job.plans[job.at]
			local c = job.dream
			if not c then
				c = copy(base, seed + base.tick * 31 + thought)
				thought += 1
				job.dream = c
				job.t = 0
			end
			while left > 0 and job.t < ticks and c.phase == "playing" do
				for _, p in c.players do
					local inp = inputs[p.id]
					if not inp then
						inp = { mx = 0, my = 0, bonk = false, throw = false }
						inputs[p.id] = inp
					end
					local drive = if p.id == id then plan.drive else job.drivers[p.id]
					drive(c, p, inp)
					withBonk(c, p, inp)
				end
				-- A seed thrown in the first step flies further than "next to": that
				-- step sees every hedge.
				if job.t == 0 then
					c.map = map
				else
					c.map = twin.map
					hedgesFor(c, map, nav, twin)
				end
				Sim.step(c, inputs)
				job.t += 1
				left -= 1
			end
			if job.t < ticks and c.phase == "playing" then
				return false
			end
			plan.score = judge(c, id, job.before, job.t / ticks)
			-- Stick with the current plan unless another is clearly better: no dithering.
			if last and last.label == plan.label then
				plan.score += SEARCH.keep
			end
			if plan.label == "rules" then
				plan.score += SEARCH.edge
			end
			job.dream = nil
			job.at += 1
			if job.at > #job.plans then
				break
			end
		end
		if job.at <= #job.plans then
			return false
		end

		local best = nil
		for _, plan in job.plans do
			if not best or plan.score > best.score then
				best = plan
			end
		end
		if last and job.startedAt - since < SEARCH.commit then
			for _, plan in job.plans do
				if plan.label == last.label then
					if plan ~= best and best.score < plan.score + SEARCH.jump then
						best = plan
					end
					break
				end
			end
		end
		if not last or best.label ~= last.label then
			since = job.startedAt
		end
		last = best
		job = nil
		return true
	end

	-- `rules` is what the rule book would do right now: { mode, targetId, path, entryY }.
	-- `cost(p, q)` is what a leg of a path costs on top of its length.
	local function choose(g, id, cost, rules)
		local now = g.time
		-- Between thoughts, and while one is still going on, it stays with its last
		-- choice; if that was the rule book, with whatever the rule book says now.
		if not job and now - lastAt >= SEARCH.every then
			local map = g.map
			local nav = Nav.get(map)
			local me = g.byId[id]
			local f = map.flower
			local entries = nav.entries(g.homeX)
			local function nearestEntry(p)
				local best = entries[1]
				local bestD = nav.distance(p, best)
				for i = 2, #entries do
					local d = nav.distance(p, entries[i])
					if d < bestD then
						best = entries[i]
						bestD = d
					end
				end
				return best
			end

			-- What everybody else is taken to be doing: a carrier runs home, the rest
			-- go for the nearest seed somebody is carrying, or else for the flower.
			-- These drivers keep their place on a path from one daydream to the next,
			-- as in the web game, so that both bots come to the same choices.
			local drivers = {}
			local homeRuns = {}
			for _, p in g.players do
				if p == me then
					continue
				end
				if p.carrying then
					local run = nav.findPath(p, nearestEntry(p))
					homeRuns[p.id] = run
					drivers[p.id] = walker(run)
					continue
				end
				local prey = nil
				local preyD = math.huge
				for _, c in g.players do
					if c.carrying and not inHome(g, c) and dist(p, c) < preyD then
						prey = c
						preyD = dist(p, c)
					end
				end
				if prey then
					drivers[p.id] = chaser(prey.id, (nav.findPath(p, prey)))
				elseif dist(p, f) <= f.gatherR - 6 * PX then
					drivers[p.id] = still
				else
					local spot = nav.gatherSpots[1]
					for _, s in nav.gatherSpots do
						if dist(p, s) < dist(p, spot) then
							spot = s
						end
					end
					drivers[p.id] = walker((nav.findPath(p, spot)))
				end
			end

			-- The plans worth weighing right now.
			local plans = {}
			local function add(label, intent, drive)
				table.insert(plans, { label = label, intent = intent, drive = drive, score = 0 })
			end
			local defending = rules.mode == "deny"
			-- The rule book's plan is always in the running, and has to be beaten clearly.
			local target = if rules.targetId >= 0 then g.byId[rules.targetId] else nil
			if target then
				add("rules", rules, chaser(target.id, rules.path or (nav.findPath(me, target))))
			elseif rules.path and #rules.path > 0 then
				add("rules", rules, walker(rules.path))
			else
				add("rules", rules, still)
			end
			if me.carrying then
				local runs = {}
				nav.from(me, cost)
				for _, entry in entries do
					local c, via = nav.costTo(entry)
					table.insert(runs, { entry = entry, cost = c, via = via })
				end
				table.sort(runs, function(a, b)
					return a.cost < b.cost
				end)
				for i = 1, math.min(3, #runs) do
					local run = runs[i]
					local points = nav.pathTo(run.entry, run.via)
					add("home:" .. run.entry.y, { mode = "home", entryY = run.entry.y, path = points }, walker(points))
				end
			else
				-- When the rule book says a seed has to be stopped, that is settled:
				-- looking ahead only gets to choose how.
				if not defending then
					local spot = nil
					local spotD = math.huge
					for _, s in nav.gatherSpots do
						local taken = false
						for _, e in g.players do
							if e ~= me and dist(e, s) < 2 * R then
								taken = true
								break
							end
						end
						if not taken and (not spot or nav.distance(me, s) < spotD) then
							spot = s
							spotD = nav.distance(me, s)
						end
					end
					if dist(me, f) <= f.gatherR - 8 * PX then
						add("gather", { mode = "gather", path = nil }, still)
					else
						local toSpot = nav.findPath(me, spot or f, cost)
						add("gather", { mode = "gather", path = toSpot }, walker(toSpot))
					end
				end

				local carriers = {}
				for _, c in g.players do
					if c ~= me and c.carrying and not inHome(g, c) then
						table.insert(carriers, c)
					end
				end
				table.sort(carriers, function(a, b)
					return a.x < b.x
				end)
				for i = 1, math.min(2, #carriers) do
					local c = carriers[i]
					add("chase:" .. c.id, { mode = "deny", targetId = c.id, path = nil }, chaser(c.id, (nav.findPath(me, c))))
					-- Get in front of it: at the door it is making for, on foot or by tunnel.
					local run = homeRuns[c.id]
					local door = { x = g.homeX + 26 * PX, y = run[#run].y }
					local toDoor = nav.findPath(me, door, cost)
					add("door:" .. c.id, { mode = "deny", targetId = c.id, path = toDoor }, chaser(c.id, toDoor))
					local tunnel = map.warps[1]
					for _, w in map.warps do
						if nav.distance(me, w) < nav.distance(me, tunnel) then
							tunnel = w
						end
					end
					if nav.distance(me, tunnel) < 260 * PX then
						local toTunnel = nav.findPath(me, tunnel)
						add("tunnel:" .. c.id, { mode = "deny", targetId = c.id, path = toTunnel }, walker(toTunnel))
					end
				end
				-- Clear somebody out: whoever is nearest.
				if not defending then
					local near = nil
					local nearD = 220 * PX
					for _, e in g.players do
						if e ~= me and not e.carrying and not inHome(g, e) and dist(me, e) < nearD then
							near = e
							nearD = dist(me, e)
						end
					end
					if near then
						add("hunt:" .. near.id, { mode = "hunt", targetId = near.id, path = nil }, chaser(near.id, nil))
					end
				end
			end

			-- Every plan is played out from the game as it is now, however long the
			-- thinking takes.
			local before = {}
			for _, p in g.players do
				before[p.id] = { deaths = p.deaths, kills = p.kills }
			end
			job = { base = copy(g, 0), id = id, plans = plans, drivers = drivers, before = before, at = 1, dream = nil, t = 0, startedAt = now }
			lastAt = now
			if budget == math.huge then
				work()
			end
		end
		return if not last or last.label == "rules" then rules else last.intent
	end

	return { choose = choose, work = work }
end

return Search
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">RLBot</string><ProtectedString name="Source"><![CDATA[-- The learned bot: plays with the network the web game trained for free-for-all
-- rounds (weights/, run by RLPolicy). Ported from the web game's src/ai/rl-bot.js.
-- It sees what it saw in training (RLObserve): itself as it is now and the other
-- hamsters a few ticks late. Like in training it picks a move every few ticks and
-- holds it in between.

local Map = require(game:GetService("ReplicatedStorage"):WaitForChild("Map"))
local RLObserve = require(script.Parent:WaitForChild("RLObserve"))
local RLPolicy = require(script.Parent:WaitForChild("RLPolicy"))

local RLBot = {}

local DIRS = RLObserve.DIRS

-- The web game's small seeded generator (src/sim/rng.js), so a bot with the same
-- seed makes the same choices there and here.
local function mulberry32(seed)
	local function imul(a, b)
		return (a * (b % 65536) + (a * (b // 65536)) % 65536 * 65536) % 4294967296
	end
	local a = seed % 4294967296
	return function()
		a = (a + 0x6d2b79f5) % 4294967296
		local t = imul(bit32.bxor(a, bit32.rshift(a, 15)), bit32.bor(a, 1))
		t = bit32.bxor(t, (t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))) % 4294967296)
		return bit32.bxor(t, bit32.rshift(t, 14)) / 4294967296
	end
end

-- The weights are put together once, the first time a bot is made, and the
-- map's walking distances worked out then too: both take a moment that a round
-- in play should not have to wait for.
local policy
local function loadPolicy()
	if not policy then
		RLObserve.fields(Map)
		local folder = script.Parent:WaitForChild("weights")
		local index = require(folder:WaitForChild("RLSolo"))
		local chunks = {}
		for i = 1, index.chunks do
			chunks[i] = require(folder:WaitForChild(string.format("RLSolo%02d", i)))
		end
		-- Older weights saw themselves late too; these and the ones since do not.
		assert(index.meta.selfNow, "RLBot plays weights that see themselves as they are now")
		policy = RLPolicy.load(index, chunks)
	end
	return policy
end

-- options: { seed = number, offset = number }. Returns { think(g, id) -> input },
-- to be asked every tick of the round. `offset` shifts which ticks it decides on,
-- so several bots in a round do not all run their networks on the same tick.
function RLBot.new(options)
	local brain = loadPolicy()
	local every = brain.meta.frameSkip or 4
	local temperature = brain.meta.temperature or 1
	local random = mulberry32(if options and options.seed then options.seed else 1)
	local view = table.create(RLObserve.OBS, 0)
	local tick = if options and options.offset then options.offset % every else 0
	local move, bonk, throw = 0, 0, 0

	local bot = {}

	function bot.think(g, id)
		local fresh = tick % every == 0
		tick += 1
		-- Every tick, so the late view has no gaps.
		local past = RLObserve.seenLate(g)
		if fresh then
			RLObserve.observe(g, past, id, view)
			local choice = brain.act(view, temperature, random)
			move, bonk, throw = choice[1], choice[2], choice[3]
		end
		local dir = DIRS[move + 1]
		-- A swing is one press, at the start of a choice, as in training.
		return { mx = dir[1], my = dir[2], bonk = fresh and bonk == 1, throw = throw == 1 }
	end

	return bot
end

return RLBot
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">RLObserve</string><ProtectedString name="Source"><![CDATA[-- What the trained policy sees of a round: 230 numbers for one hamster. Ported
-- from the web game's src/ai/observe.js for the one kind of round Roblox has:
-- the meadow, everyone for themselves, no trouble on the map. The numbers have to
-- be the ones the policy learned from, so what a meadow free-for-all leaves at
-- zero in the web game is left at zero here, in the same places.
-- Most of it is a share of something (of the map's width, of full speed), which
-- is the same in studs as in pixels. The walking distances are not: the policy
-- learned them on the web game's 8 pixel grid, so that part works in pixels.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Sim = require(ReplicatedStorage:WaitForChild("Sim"))

local RLObserve = {}

-- How stale the other hamsters are, in ticks: 0.15 s, as a quick person's eye.
local REACTION_TICKS = 9
local MAX_P = 8
local OBS = 230
RLObserve.OBS = OBS

-- Where each part starts, counted from 1: me, the round, the three ways to walk,
-- the walls around me, then (after the map's trouble and gates, which the meadow
-- has none of) everyone else, whom I am after, and pickpocketing. The parts for
-- teams are skipped: nobody has a team.
local ROUND = 20
local MEADOW = 31
local NAV = 38
local RAYS = 47
local OTHERS = 109
local OTHER = 13
local MARK = 200
local PICK = 220

-- The moves a policy picks from: standing still, then eight directions.
local DIRS = { { 0, 0 } }
for k = 0, 7 do
	table.insert(DIRS, { math.cos(k * math.pi / 4), math.sin(k * math.pi / 4) })
end
RLObserve.DIRS = DIRS

-- The length of (x, y) the way the web game's Math.hypot works it out, to the
-- last bit: which of two hamsters is the nearer can hang on that bit.
local function hypot(x, y)
	x = math.abs(x)
	y = math.abs(y)
	local max = math.max(x, y)
	if max == 0 then
		return 0
	end
	local a = x / max
	local b = y / max
	return math.sqrt(a * a + b * b) * max
end

-- The map as a policy knows it ----------------------------------------------

local PX = 10 -- web pixels to a stud
local CELL = 8
local RAY = 120
local INF = math.huge

-- A map length in pixels. They are whole numbers there; this keeps them so.
local function px(studs)
	return math.round(studs * PX * 1000) / 1000
end

-- Hamsters start on their nests and come back to them, and there two can be
-- exactly as far from a third. Which one the policy then sees first was settled
-- in training by the last bit of the web game's nests, so a hamster sitting on
-- its nest is put on the web game's, to the bit: these are Map.nests and
-- Map.bigNests in pixels as the web game has them.
local WEB_NESTS = {
	{ 69.098300562505258, 221.22147477075268 },
	{ 52.185239926619431, 259.20883091822407 },
	{ 52.185239926619431, 300.79116908177593 },
	{ 69.098300562505258, 338.77852522924729 },
}
local WEB_BIG_NESTS = {
	{ 119.15791961552497, 165.80681779467488 },
	{ 84.978407778635074, 188.36851602127172 },
	{ 59.925558517907746, 220.76641719087519 },
	{ 46.688675759559814, 259.52276107310780 },
	{ 46.688675759559814, 300.47723892689220 },
	{ 59.925558517907746, 339.23358280912487 },
	{ 84.978407778635074, 371.63148397872828 },
	{ 119.15791961552497, 394.19318220532512 },
}

local fieldsOf = setmetatable({}, { __mode = "k" })

-- Walking distance to the flower, to home and to the nearest tunnel from every
-- 8 pixel cell of the map, worked out once. A policy is told which way is downhill.
local function fields(map)
	local F = fieldsOf[map]
	if F then
		return F
	end
	local cols = math.ceil(px(map.world.w) / CELL)
	local rows = math.ceil(px(map.world.h) / CELL)
	local corner = px(map.corner)
	local flower = map.flower
	local fx, fy = px(flower.x), px(flower.y)
	local pad = px(Config.HAMSTER_R) * 0.8
	local cores = {}
	for _, r in map.rects do
		table.insert(cores, { px(r.x) + corner, px(r.y) + corner, px(r.x + r.w) - corner, px(r.y + r.h) - corner })
	end
	local function isFree(x, y)
		for _, c in cores do
			if hypot(x - math.clamp(x, c[1], c[3]), y - math.clamp(y, c[2], c[4])) < corner + pad then
				return false
			end
		end
		return hypot(x - fx, y - fy) >= px(flower.r) + pad
	end

	-- Cells are counted from 0, row after row.
	local free = table.create(cols * rows, false)
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			free[r * cols + c + 1] = isFree((c + 0.5) * CELL, (r + 0.5) * CELL)
		end
	end

	-- Distances are 32-bit floats, as in the web game: the sweeps below stop on
	-- differences that small, so it shows in where they stop.
	local function flood(isSource)
		local dist = buffer.create(cols * rows * 4)
		local frontier = {}
		for i = 0, cols * rows - 1 do
			local source = free[i + 1] and isSource((i % cols + 0.5) * CELL, (i // cols + 0.5) * CELL)
			buffer.writef32(dist, i * 4, if source then 0 else INF)
			if source then
				table.insert(frontier, i)
			end
		end
		-- The steps cost 1 or 1.41, so a few relaxation sweeps settle it.
		while #frontier > 0 do
			local nextUp = {}
			for _, i in frontier do
				local c = i % cols
				local r = i // cols
				for dr = -1, 1 do
					for dc = -1, 1 do
						local nc = c + dc
						local nr = r + dr
						local j = nr * cols + nc
						local diagonal = dr ~= 0 and dc ~= 0
						if
							(dr ~= 0 or dc ~= 0)
							and nc >= 0
							and nr >= 0
							and nc < cols
							and nr < rows
							and free[j + 1]
							-- No cutting a corner between two walls.
							and not (diagonal and not (free[r * cols + nc + 1] and free[nr * cols + c + 1]))
						then
							local d = buffer.readf32(dist, i * 4) + (if diagonal then 1.4142 else 1)
							if d < buffer.readf32(dist, j * 4) - 1e-4 then
								buffer.writef32(dist, j * 4, d)
								table.insert(nextUp, j)
							end
						end
					end
				end
			end
			frontier = nextUp
		end
		return dist
	end

	local nests = {} -- [nest] = where the web game has it
	for i, nest in map.nests do
		nests[nest] = WEB_NESTS[i]
	end
	for i, nest in map.bigNests do
		nests[nest] = WEB_BIG_NESTS[i]
	end

	local homeX = px(map.home.x2) - 12
	local gatherR = px(flower.gatherR) - 6
	F = {
		cols = cols,
		rows = rows,
		free = free,
		nests = nests,
		flower = flood(function(x, y)
			return hypot(x - fx, y - fy) < gatherR
		end),
		home = flood(function(x)
			return x < homeX
		end),
		warp = flood(function(x, y)
			for _, w in map.warps do
				if hypot(x - px(w.x), y - px(w.y)) < px(w.r) - 4 then
					return true
				end
			end
			return false
		end),
	}
	fieldsOf[map] = F
	return F
end
RLObserve.fields = fields

-- Where a hamster is, in the web game's pixels.
local function place(F, p)
	local nest = p.nest
	if p.x == nest.x and p.y == nest.y and F.nests[nest] then
		return F.nests[nest][1], F.nests[nest][2]
	end
	return p.x * PX, p.y * PX
end

-- The cell under a spot given in pixels, or -1.
local function cellOf(F, x, y)
	local c = math.clamp(x // CELL, 0, F.cols - 1)
	local r = math.clamp(y // CELL, 0, F.rows - 1)
	if F.free[r * F.cols + c + 1] then
		return r * F.cols + c
	end
	-- Pressed against a wall: use the nearest walkable cell.
	local best = -1
	local bestD = INF
	for dr = -2, 2 do
		for dc = -2, 2 do
			local nc = c + dc
			local nr = r + dr
			if nc >= 0 and nr >= 0 and nc < F.cols and nr < F.rows and F.free[nr * F.cols + nc + 1] and dr * dr + dc * dc < bestD then
				bestD = dr * dr + dc * dc
				best = nr * F.cols + nc
			end
		end
	end
	return best
end

-- How far the walk is from a spot in pixels, as a share of 1000 pixels.
local function fieldAt(F, dist, x, y)
	local i = cellOf(F, x, y)
	local d = if i < 0 then INF else buffer.readf32(dist, i * 4)
	return if d == INF then 1 else math.min(1, d * CELL / 1000)
end

-- Which way to walk to get nearer `dist`'s target, and how far it is.
local function hint(F, dist, x, y, out, at)
	out[at] = 0
	out[at + 1] = 0
	out[at + 2] = 1
	local i = cellOf(F, x, y)
	local here = if i < 0 then INF else buffer.readf32(dist, i * 4)
	if here == INF then
		return
	end
	local c = i % F.cols
	local r = i // F.cols
	local best = here
	local bx = 0
	local by = 0
	for dr = -1, 1 do
		for dc = -1, 1 do
			local nc = c + dc
			local nr = r + dr
			if (dr ~= 0 or dc ~= 0) and nc >= 0 and nr >= 0 and nc < F.cols and nr < F.rows then
				local d = buffer.readf32(dist, (nr * F.cols + nc) * 4)
				if d < best then
					best = d
					bx = dc
					by = dr
				end
			end
		end
	end
	local len = hypot(bx, by)
	if len == 0 then
		len = 1
	end
	out[at] = bx / len
	out[at + 1] = by / len
	out[at + 2] = math.min(1, here * CELL / 1000)
end

-- The others, seen late ------------------------------------------------------

local views = setmetatable({}, { __mode = "k" })

-- The hamsters as they were REACTION_TICKS ago, shared by every learned bot in
-- the round. Call it every tick, so the late view has no gaps.
-- Returns { nibbler = id or nil, players = { what observe reads of each } }.
function RLObserve.seenLate(g)
	local F = fields(g.map)
	local v = views[g]
	if not v then
		v = { tick = -1, past = {} }
		views[g] = v
	end
	if v.tick ~= g.tick then
		-- The oldest one has been seen; its tables hold the newest.
		local now = if #v.past > REACTION_TICKS then table.remove(v.past, 1) else { players = {} }
		now.nibbler = g.nibbler
		for i, p in g.players do
			local q = now.players[i]
			if not q then
				q = {}
				now.players[i] = q
			end
			q.id = p.id
			q.x = p.x
			q.y = p.y
			q.px, q.py = place(F, p)
			q.vx = p.vx
			q.vy = p.vy
			q.carrying = p.carrying
			q.windup = p.swing ~= nil and p.swing.windup
			q.recovery = p.swing ~= nil and not p.swing.windup
			q.cooldown = p.cooldown
			q.pick = p.pick
			q.pickOn = p.pickOn
		end
		for i = #now.players, #g.players + 1, -1 do
			now.players[i] = nil
		end
		table.insert(v.past, now)
		v.tick = g.tick
	end
	return v.past[1]
end

-- The observation ------------------------------------------------------------

local others = table.create(MAX_P)
local far = table.create(MAX_P)

-- Fills out[1..OBS] with what the hamster `id` sees: itself and the map as they
-- are now, the others as they were in `past` (from seenLate). A hamster that has
-- left since is not seen any more.
function RLObserve.observe(g, past, id, out)
	for i = 1, OBS do
		out[i] = 0
	end
	local me = g.byId[id]
	if not me then
		return
	end
	local map = g.map
	local W = map.world.w
	local H = map.world.h
	local F = fields(map)
	local flower = map.flower
	local need = Config.gatherTime(#g.players, g.time)
	local steal = Config.pickTime(#g.players, g.time)
	local nibbler = past.nibbler
	if nibbler and not g.byId[nibbler] then
		nibbler = nil
	end

	-- Everyone else, nearest first, in pixels; whoever is as near as another
	-- keeps its seat's place. `prey` is the nearest of them with a seed.
	local x, y = place(F, me)
	local n = 0
	local prey = nil
	local preyD = INF
	local seeds = 0
	local robbed = 0
	for _, p in past.players do
		if p.id ~= id and g.byId[p.id] then
			local d = hypot(p.px - x, p.py - y)
			if p.carrying then
				seeds += 1
				if d < preyD then
					prey = p
					preyD = d
				end
			end
			if p.pickOn == id then
				robbed = math.max(robbed, math.min(1, p.pick / steal))
			end
			local at = n + 1
			while at > 1 and far[at - 1] > d do
				others[at] = others[at - 1]
				far[at] = far[at - 1]
				at -= 1
			end
			others[at] = p
			far[at] = d
			n += 1
		end
	end

	local swing = me.swing
	out[1] = me.x / W
	out[2] = me.y / H
	out[3] = me.vx / Config.SPEED
	out[4] = me.vy / Config.SPEED
	out[5] = me.fx
	out[6] = me.fy
	out[7] = if me.carrying then 1 else 0
	out[8] = me.cooldown / Config.BONK.cooldown
	out[9] = if swing and swing.windup then 1 else 0
	out[10] = if swing and not swing.windup then 1 else 0
	out[11] = me.charge / Config.THROW.max
	out[12] = if me.charge >= Config.THROW.charge then 1 else 0
	out[13] = me.gather / need
	out[14] = if Sim.inHome(g, me) then 1 else 0
	out[15] = if Sim.lastStretch(g, me) then 1 else 0
	-- 16 is wet fur and 19 is standing on ice.
	out[17] = (me.x - g.homeX) / W
	out[18] = hypot(me.x - flower.x, me.y - flower.y) / W

	out[ROUND] = g.time / Config.OVERTIME.finish
	out[ROUND + 1] = if g.time > Config.OVERTIME.start then 1 else 0
	out[ROUND + 2] = g.homeX / W
	out[ROUND + 3] = if g.nibbler == id then 1 else 0
	out[ROUND + 4] = if nibbler and nibbler ~= id then 1 else 0
	out[ROUND + 5] = (n + 1) / MAX_P
	-- Then whether I am in a team.
	out[ROUND + 7] = if seeds > 0 then 1 else 0
	-- Then how many teams, night and dusk, and which of the seven maps this is.
	out[MEADOW] = 1

	hint(F, F.flower, x, y, out, NAV)
	hint(F, F.home, x, y, out, NAV + 3)
	hint(F, F.warp, x, y, out, NAV + 6)

	-- How far it is to a wall in eight directions, out to 120 pixels.
	for k = 1, 8 do
		local dir = DIRS[k + 1]
		local reach = 1
		for s = CELL, RAY, CELL do
			local c = (x + dir[1] * s) // CELL
			local r = (y + dir[2] * s) // CELL
			if c < 0 or r < 0 or c >= F.cols or r >= F.rows or not F.free[r * F.cols + c + 1] then
				reach = s / RAY
				break
			end
		end
		out[RAYS + k - 1] = reach
	end

	for k = 1, n do
		local p = others[k]
		local o = OTHERS + (k - 1) * OTHER
		out[o] = 1
		out[o + 1] = (p.x - me.x) / W
		out[o + 2] = (p.y - me.y) / H
		out[o + 3] = math.min(1, far[k] / (4 * Config.BONK.reach * PX))
		out[o + 4] = p.vx / Config.SPEED
		out[o + 5] = p.vy / Config.SPEED
		out[o + 6] = if p.carrying then 1 else 0
		-- o + 7 is whether it is on my team.
		out[o + 8] = if p.windup then 1 else 0
		out[o + 9] = if p.recovery then 1 else 0
		out[o + 10] = p.cooldown / Config.BONK.cooldown
		out[o + 11] = if Sim.inHome(g, p) then 1 else 0
		out[o + 12] = (p.x - g.homeX) / W
	end

	-- Whom I am after. On my own that is the nearest rival with a seed; the three
	-- numbers before these say which job I have in a team, and the fourth whether
	-- a teammate has a seed.
	out[MARK + 4] = seeds / 4
	if prey then
		out[MARK + 5] = 1
		out[MARK + 6] = (prey.x - me.x) / W
		out[MARK + 7] = (prey.y - me.y) / H
		out[MARK + 8] = fieldAt(F, F.home, prey.px, prey.py)
		out[MARK + 9] = math.min(1, preyD / 1000)
	end

	-- Pickpocketing: how far I am into taking a seed, how long until I may try
	-- again after losing mine, how far a rival is into taking mine, and where the
	-- nearest rival with a seed is.
	out[PICK] = math.min(1, me.pick / steal)
	out[PICK + 1] = me.pickBlock / Config.PICK.block
	out[PICK + 2] = robbed
	if prey then
		out[PICK + 3] = (prey.x - me.x) / W
		out[PICK + 4] = (prey.y - me.y) / H
		out[PICK + 5] = math.min(1, preyD / (8 * Config.PICK.reach * PX))
	end
end

return RLObserve
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">RLPolicy</string><ProtectedString name="Source"><![CDATA[--!native
-- Runs the trained policy from its packed weights (weights/, made by
-- tools/pack_weights.py). Ported from the web game's src/ai/policy.js: normalise,
-- one linear layer, residual blocks with LayerNorm, then the heads.
-- The web game keeps every layer's result as a 32-bit float and adds up in
-- doubles; this does the same in the same order, so the two give the same logits.
-- Nothing here touches the game, so it also runs outside Roblox.

local RLPolicy = {}

local readf32 = buffer.readf32
local writef32 = buffer.writef32

local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

-- Base64 text to bytes, written into `out` from `at`. Returns where it stopped.
-- The padding at the very end decodes as zero bytes, which nothing reads.
local function decode64(text, value, out, at)
	local from = buffer.fromstring(text)
	for i = 0, #text - 4, 4 do
		local n = value[buffer.readu8(from, i)] * 262144
			+ value[buffer.readu8(from, i + 1)] * 4096
			+ value[buffer.readu8(from, i + 2)] * 64
			+ value[buffer.readu8(from, i + 3)]
		buffer.writeu8(out, at, n // 65536)
		buffer.writeu8(out, at + 1, n // 256 % 256)
		buffer.writeu8(out, at + 2, n % 256)
		at += 3
	end
	return at
end

local function half(h)
	local e = h // 1024 % 32
	local f = h % 1024
	local v
	if e == 0 then
		v = math.ldexp(f, -24)
	elseif e == 31 then
		v = if f == 0 then math.huge else 0 / 0
	else
		v = math.ldexp(1 + f / 1024, e - 15)
	end
	return if h >= 32768 then -v else v
end

-- index: what weights/RLSolo returns. chunks: the base64 texts, in order.
-- Returns { meta, logits(obs), act(obs, temperature, random) }.
function RLPolicy.load(index, chunks)
	local total = 0
	local where = {} -- [tensor name] = byte offset of its first number
	for _, tensor in index.tensors do
		where[tensor[1]] = total * 4
		total += tensor[2]
	end

	local value = table.create(256, 0)
	for i = 1, #ALPHABET do
		value[string.byte(ALPHABET, i)] = i - 1
	end
	local halves = buffer.create(total * 2 + 3)
	local at = 0
	for _, text in chunks do
		at = decode64(text, value, halves, at)
	end
	assert(at >= total * 2, "the weight modules are shorter than their index says")
	local W = buffer.create(total * 4)
	for i = 0, total - 1 do
		writef32(W, i * 4, half(buffer.readu16(halves, i * 2)))
	end

	local meta = index.meta
	local heads = index.heads
	local obs = meta.obs
	local width = meta.width
	local blocks = meta.blocks
	local outputs = 0
	for _, size in heads do
		outputs += size
	end

	-- What each input is divided by after its mean is taken off.
	local spread = table.create(obs, 0)
	for i = 0, obs - 1 do
		spread[i + 1] = math.sqrt(readf32(W, where.var + i * 4) + 1e-6)
	end

	-- Every layer's result, reused from one call to the next.
	local x0 = buffer.create(obs * 4)
	local x = buffer.create(width * 4)
	local h = buffer.create(width * 4)
	local up = buffer.create(width * 8)
	local out = buffer.create(outputs * 4)
	-- Where in a row of weights the inputs that are not zero sit.
	local live = buffer.create(width * 8)

	-- out[r] = b[r] + the sum over c of w[r][c] * x[c]. Sizes are in bytes.
	local function linear(w, b, rows, cols, from, to)
		for r = 0, rows - 4, 4 do
			local s = readf32(W, b + r)
			local row = w + r * (cols // 4)
			for c = 0, cols - 16, 16 do
				s += readf32(W, row + c) * readf32(from, c)
				s += readf32(W, row + c + 4) * readf32(from, c + 4)
				s += readf32(W, row + c + 8) * readf32(from, c + 8)
				s += readf32(W, row + c + 12) * readf32(from, c + 12)
			end
			for c = cols - cols % 16, cols - 4, 4 do
				s += readf32(W, row + c) * readf32(from, c)
			end
			writef32(to, r, s)
		end
	end

	local function layerNorm(g, b, from, to)
		local mean = 0
		for i = 0, width * 4 - 4, 4 do
			mean += readf32(from, i)
		end
		mean /= width
		local varc = 0
		for i = 0, width * 4 - 4, 4 do
			local d = readf32(from, i) - mean
			varc += d * d
		end
		local std = math.sqrt(varc / width + 1e-5)
		for i = 0, width * 4 - 4, 4 do
			writef32(to, i, (readf32(from, i) - mean) / std * readf32(W, g + i) + readf32(W, b + i))
		end
	end

	-- obs: `meta.obs` numbers, counted from 1. Returns the logits as 32-bit floats
	-- in a buffer that the next call overwrites.
	local function logits(input)
		for i = 0, obs - 1 do
			-- Through the buffer first, as the web game's observation is 32-bit too.
			writef32(x0, i * 4, input[i + 1])
			local v = (readf32(x0, i * 4) - readf32(W, where.mean + i * 4)) / spread[i + 1]
			writef32(x0, i * 4, math.clamp(v, -5, 5))
		end
		linear(where["inp.weight"], where["inp.bias"], width * 4, obs * 4, x0, x)
		for k = 0, blocks - 1 do
			local name = `blocks.{k}.`
			layerNorm(where[name .. "norm.weight"], where[name .. "norm.bias"], x, h)
			linear(where[name .. "up.weight"], where[name .. "up.bias"], width * 8, width * 4, h, up)
			-- About half of these come out below zero and count for nothing, so the
			-- way back down skips them. A skipped zero adds nothing: same sum.
			local n = 0
			for c = 0, width * 8 - 4, 4 do
				if readf32(up, c) > 0 then
					buffer.writeu32(live, n, c)
					n += 4
				end
			end
			local w = where[name .. "down.weight"]
			local b = where[name .. "down.bias"]
			for r = 0, width * 4 - 4, 4 do
				local s = readf32(W, b + r)
				local row = w + r * width * 2
				for j = 0, n - 4, 4 do
					local c = buffer.readu32(live, j)
					s += readf32(W, row + c) * readf32(up, c)
				end
				-- Into a 32-bit float before it is added on, as the web game does.
				writef32(h, r, s)
				writef32(x, r, readf32(x, r) + readf32(h, r))
			end
		end
		layerNorm(where["norm.weight"], where["norm.bias"], x, h)
		linear(where["pi.weight"], where["pi.bias"], outputs * 4, width * 4, h, out)
		return out
	end

	local weight = table.create(outputs, 0)
	local picks = table.create(#heads, 0)

	-- One choice per head, counted from 0: move 0-8, bonk 0/1, throw 0/1, in a
	-- table that the next call overwrites. `temperature` 0 always takes the
	-- likeliest; 1 plays as it was trained. `random` returns a number in [0, 1).
	local function act(input, temperature, random)
		local l = logits(input)
		local first = 0
		for k, size in heads do
			local best = 0
			for i = 1, size - 1 do
				if readf32(l, (first + i) * 4) > readf32(l, (first + best) * 4) then
					best = i
				end
			end
			if temperature > 0 then
				local top = readf32(l, (first + best) * 4)
				local sum = 0
				for i = 0, size - 1 do
					weight[i + 1] = math.exp((readf32(l, (first + i) * 4) - top) / temperature)
					sum += weight[i + 1]
				end
				local roll = random() * sum
				best = size - 1
				for i = 0, size - 1 do
					roll -= weight[i + 1]
					if roll <= 0 then
						best = i
						break
					end
				end
			end
			picks[k] = best
			first += size
		end
		return picks
	end

	return { meta = meta, logits = logits, act = act }
end

return RLPolicy
]]></ProtectedString></Properties></Item><Item class="Script"><Properties><string name="Name">Round</string><ProtectedString name="Source"><![CDATA[-- Lobby and round flow. Empty seats can be filled with bots: the lobby says how
-- many and how good, and anyone in it may change that. The server owns the game: clients only send what they
-- are pressing, and get back a snapshot every tick plus the events of that tick.
--   lobby (everyone presses ready) -> round (3 s countdown, play) -> lobby, showing the result ...
-- Nothing starts by itself: a round begins once everyone in the server is ready,
-- or ten seconds after enough of them are. Whoever is not ready sits it out.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Snapshot = require(ReplicatedStorage:WaitForChild("Snapshot"))
local Map = require(ReplicatedStorage:WaitForChild("Map"))
local Sim = require(ReplicatedStorage:WaitForChild("Sim"))
local Bot = require(script.Parent:WaitForChild("Bot"))
local RLBot = require(script.Parent:WaitForChild("RLBot"))

Players.CharacterAutoLoads = false

-- In Studio one player is enough, so the game can be looked at with a plain test run.
local MIN_PLAYERS = if RunService:IsStudio() then 1 else Config.MIN_PLAYERS

-- Bot levels, weakest first: the scripted ones the web game has, then the one
-- that learned the game by playing it.
local LEVELS = {}
for _, level in { "easy", "normal", "hard", "ace" } do
	if Bot.DIFFICULTY[level] then
		table.insert(LEVELS, level)
	end
end
table.insert(LEVELS, "rl")
local LEVEL_NAMES = { easy = "쉬움", normal = "보통", hard = "어려움", ace = "고수", rl = "RL" }
local BOT_NAMES = { "도토리", "콩알", "밤톨", "호두", "땅콩", "쌀알", "잣" }

local remotes = Instance.new("Folder")
remotes.Name = "HashRushRemotes"
local inputRemote = Instance.new("RemoteEvent")
inputRemote.Name = "Input"
inputRemote.Parent = remotes
local roundRemote = Instance.new("RemoteEvent")
roundRemote.Name = "Round"
roundRemote.Parent = remotes
local readyRemote = Instance.new("RemoteEvent")
readyRemote.Name = "Ready"
readyRemote.Parent = remotes
local lobbyRemote = Instance.new("RemoteEvent")
lobbyRemote.Name = "Lobby"
lobbyRemote.Parent = remotes
local snapRemote = Instance.new("UnreliableRemoteEvent")
snapRemote.Name = "Snap"
snapRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

Map.render()

-- Wins and games played, kept across visits.
local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("HashRushStats")
	end)
	if ok then
		store = result
	else
		warn("HashRush: stats are not saved (" .. tostring(result) .. ")")
	end
end

local function record(userId, won)
	if not store then
		return
	end
	task.spawn(function()
		local ok, err = pcall(function()
			store:UpdateAsync("u" .. userId, function(old)
				old = old or { wins = 0, games = 0 }
				old.games += 1
				if won then
					old.wins += 1
				end
				return old
			end)
		end)
		if not ok then
			warn("HashRush: could not save stats for " .. userId .. ": " .. tostring(err))
		end
	end)
end

local joined = {} -- players, in the order they came in
local raw = {} -- [player] = what that player is pressing
local wins = {} -- [userId] = rounds won on this server
local ready = {} -- [player] = true once it has asked for the next round

local state = "lobby" -- "lobby" | "round"
local timer = Config.LOBBY_COUNTDOWN
local roundNo = 0
local game_ = nil -- the Sim game of the running round
local seats = {} -- [seat number] = player
local bots = {} -- [seat number] = { think, name }
local botCount = 3 -- how many the lobby has asked for
local botLevel = "normal"
local simInputs = {}
local rng = Random.new()

-- The last of each message, for whoever joins in the middle.
local lastLobby = nil
local lastStart = nil
local lastResult = nil

local function roster()
	local list = {}
	for seat, player in seats do
		local p = game_ and game_.byId[seat]
		table.insert(list, {
			id = seat,
			userId = player.UserId,
			name = player.DisplayName,
			wins = wins[player.UserId] or 0,
			kills = if p then p.kills + p.throws else 0,
		})
	end
	for seat, bot in bots do
		local p = game_ and game_.byId[seat]
		table.insert(list, {
			id = seat,
			userId = -seat,
			name = bot.name,
			wins = wins[bot.name] or 0,
			kills = if p then p.kills + p.throws else 0,
		})
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

local function readyCount()
	local n = 0
	for _ in ready do
		n += 1
	end
	return n
end

-- How many bots a round with this many people in it would get.
local function botsFor(people)
	return math.clamp(botCount, 0, Config.MAX_PLAYERS - people)
end

-- Enough to play: somebody real, and a rival for it, bot or not.
local function enough(readied)
	return readied >= 1 and readied + botsFor(readied) >= MIN_PLAYERS
end

local function sendLobby()
	local count = #joined
	local readied = readyCount()
	-- The count runs only while some, but not all, are ready.
	local left = if enough(readied) and readied < count then math.ceil(timer) else nil
	local people = {}
	local mark = { count, readied, left or -1, botCount, botLevel }
	for _, player in joined do
		table.insert(people, { name = player.DisplayName, ready = ready[player] == true })
		table.insert(mark, if ready[player] then 1 else 0)
	end
	local signature = table.concat(mark, ",")
	if lastLobby and lastLobby.signature == signature then
		return
	end
	lastLobby = {
		kind = "lobby",
		signature = signature,
		count = count,
		ready = readied,
		-- How many more people it takes before a round can start at all.
		short = math.max(0, MIN_PLAYERS - botsFor(count) - count),
		left = left,
		people = people,
		bots = botsFor(math.max(1, readied)),
		level = LEVEL_NAMES[botLevel] or botLevel,
	}
	roundRemote:FireAllClients(lastLobby)
end

local function startRound()
	roundNo += 1
	seats = {}
	simInputs = {}
	local slots = {}
	for _, player in joined do
		if ready[player] and #slots < Config.MAX_PLAYERS then
			local i = #slots + 1
			seats[i] = player
			simInputs[i] = { mx = 0, my = 0, bonk = false, throw = false }
			slots[i] = { id = i, name = player.DisplayName }
		end
	end
	table.clear(ready)
	table.clear(bots)
	for k = 1, botsFor(#slots) do
		local i = #slots + 1
		local seed = rng:NextInteger(1, 2 ^ 30)
		local brain = if botLevel == "rl" then RLBot.new({ seed = seed, offset = k }) else Bot.new({ difficulty = botLevel, seed = seed })
		bots[i] = { brain = brain, name = "🤖 " .. BOT_NAMES[k] }
		simInputs[i] = { mx = 0, my = 0, bonk = false, throw = false }
		slots[i] = { id = i, name = bots[i].name }
	end
	game_ = Sim.new(Map, slots, function()
		return rng:NextNumber()
	end)
	state = "round"
	lastStart = { kind = "start", round = roundNo, roster = roster() }
	roundRemote:FireAllClients(lastStart)
end

-- winners: seat numbers. `left` is true when the round stopped for want of players.
local function endRound(winners, timeout, left)
	for seat, bot in bots do
		if table.find(winners, seat) then
			wins[bot.name] = (wins[bot.name] or 0) + 1
		end
	end
	for seat, player in seats do
		local won = table.find(winners, seat) ~= nil
		if won then
			wins[player.UserId] = (wins[player.UserId] or 0) + 1
		end
		if not left then
			record(player.UserId, won)
		end
	end
	lastResult = { kind = "result", winners = winners, timeout = timeout, left = left, roster = roster() }
	roundRemote:FireAllClients(lastResult)
	-- Back to the lobby, where the result stays up until the next round is asked for.
	state = "lobby"
	timer = Config.LOBBY_COUNTDOWN
	game_ = nil
	seats = {}
	table.clear(bots)
	lastLobby = nil
	sendLobby()
end

local function stepRound()
	for seat, player in seats do
		local r = raw[player]
		local inp = simInputs[seat]
		inp.mx = r.mx
		inp.my = r.my
		-- A tap that came and went between two ticks still counts.
		inp.bonk = r.bonk or r.tapped
		inp.throw = r.throw
		r.tapped = false
	end
	for seat, bot in bots do
		-- A bot that trips up stands still rather than taking the round down with it.
		local ok, input = pcall(bot.brain.think, game_, seat)
		if ok and input then
			simInputs[seat] = input
		elseif not bot.broken then
			bot.broken = true
			warn("HashRush: " .. bot.name .. " stopped thinking: " .. tostring(input))
			simInputs[seat] = { mx = 0, my = 0, bonk = false, throw = false }
		end
	end
	Sim.step(game_, simInputs)
	if #game_.events > 0 then
		roundRemote:FireAllClients({ kind = "events", round = roundNo, list = table.clone(game_.events) })
	end
	snapRemote:FireAllClients(Snapshot.encode(roundNo, game_, function(p)
		return Sim.lastStretch(game_, p)
	end))
	if game_.phase == "over" then
		endRound(game_.winners, game_.timeout, false)
	end
end

local function tick()
	if state == "lobby" then
		local readied = readyCount()
		if enough(readied) and readied == #joined then
			startRound()
			return
		elseif enough(readied) then
			timer -= Config.DT
			if timer <= 0 then
				startRound()
				return
			end
		else
			timer = Config.LOBBY_COUNTDOWN
		end
		sendLobby()
	else
		stepRound()
	end
end

Players.PlayerAdded:Connect(function(player)
	table.insert(joined, player)
	raw[player] = { mx = 0, my = 0, bonk = false, throw = false, tapped = false }
end)
for _, player in Players:GetPlayers() do
	table.insert(joined, player)
	raw[player] = { mx = 0, my = 0, bonk = false, throw = false, tapped = false }
end

Players.PlayerRemoving:Connect(function(player)
	local at = table.find(joined, player)
	if at then
		table.remove(joined, at)
	end
	raw[player] = nil
	ready[player] = nil
	-- Not table.find: seats has gaps once somebody has left.
	local seat = nil
	for s, seated in seats do
		if seated == player then
			seat = s
		end
	end
	if seat then
		seats[seat] = nil
		simInputs[seat] = nil
		if state == "round" then
			Sim.remove(game_, seat)
			if #game_.players < MIN_PLAYERS or next(seats) == nil then
				endRound({}, false, true)
			end
		end
	end
end)

inputRemote.OnServerEvent:Connect(function(player, mx, my, bonk, throw)
	local r = raw[player]
	if not r or type(mx) ~= "number" or type(my) ~= "number" or mx ~= mx or my ~= my then
		return
	end
	r.mx = math.clamp(mx, -1, 1)
	r.my = math.clamp(my, -1, 1)
	if bonk == true and not r.bonk then
		r.tapped = true
	end
	r.bonk = bonk == true
	r.throw = throw == true
end)

-- A player asks for the next round, or takes that back.
readyRemote.OnServerEvent:Connect(function(player, want)
	if state ~= "lobby" or not raw[player] then
		return
	end
	ready[player] = if want == true then true else nil
end)

-- Anyone in the lobby may ask for more or fewer bots, or a different level.
lobbyRemote.OnServerEvent:Connect(function(player, what, value)
	if state ~= "lobby" or not raw[player] then
		return
	end
	if what == "bots" and type(value) == "number" then
		botCount = math.clamp(botCount + (if value > 0 then 1 else -1), 0, Config.MAX_PLAYERS - 1)
	elseif what == "level" then
		botLevel = LEVELS[(table.find(LEVELS, botLevel) or 0) % #LEVELS + 1]
	end
end)

-- A client says it is ready to draw: tell it where things stand.
roundRemote.OnServerEvent:Connect(function(player)
	if state == "lobby" then
		if lastLobby then
			roundRemote:FireClient(player, lastLobby)
		end
		return
	end
	roundRemote:FireClient(player, lastStart)
end)

local behind = 0
RunService.Heartbeat:Connect(function(dt)
	behind = math.min(behind + dt, 0.25)
	while behind >= Config.DT do
		behind -= Config.DT
		tick()
	end
end)
]]></ProtectedString></Properties></Item><Item class="Folder"><Properties><string name="Name">weights</string></Properties><Item class="ModuleScript"><Properties><string name="Name">RLSolo</string><ProtectedString name="Source"><![CDATA[-- Generated by roblox/tools/pack_weights.py from src/ai/rl-solo.bin. Do not edit.
