]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="ModuleScript"><Properties><string name="Name">Fx</string><ProtectedString name="Source"><![CDATA[-- Everything that makes a hit feel like a hit: sounds, bursts of stars and dust,
-- words that pop out of the ground, a camera that shakes and a moment where the
-- world holds still. None of it changes the game.

local Debris = game:GetService("Debris")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local FONT = Enum.Font.FredokaOne
local INK = Color3.fromRGB(58, 40, 30)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local Fx = {}

local folder = Instance.new("Folder")
folder.Name = "HashRushFx"
folder.Parent = workspace

-- Sounds --------------------------------------------------------------------
-- The web game's own sound effects and music (src/client/audio.js, music.js),
-- rendered from its synthesiser into audio files and uploaded to Roblox; see
-- Sounds. Until they are uploaded, Roblox's own sounds stand in.

local Sounds = require(script.Parent:WaitForChild("Sounds"))

local function asset(id)
	return "rbxassetid://" .. id
end

-- Stand-ins, as { sound, playback speed, volume }: published by Roblox itself or
-- by APM Music, Roblox's licensed library, so they play in any experience.
local STAND_IN = {
	swing = { asset(15675012262), 1.15, 0.5 },
	bonk = { asset(12222054), 1, 0.9 },
	toss = { asset(15675028888), 1.1, 0.6 },
	double = { asset(15675043410), 1.2, 0.6 },
	triple = { asset(15675043410), 1.4, 0.7 },
	superplay = { asset(15675043410), 1, 0.7 },
	spawn = { asset(15675055424), 1.1, 0.5 },
	seed = { asset(17208319162), 1, 0.7 },
	siren = { "rbxasset://sounds/volume_slider.ogg", 2.2, 0.3 },
	tick = { asset(15675059323), 1.2, 0.4 },
	tock = { asset(15675059323), 0.9, 0.4 },
	count = { asset(15675059323), 0.9, 0.7 },
	go = { asset(15675043410), 1, 0.7 },
	overtime = { "rbxasset://sounds/volume_slider.ogg", 1.5, 0.5 },
	win = { asset(1844584698), 1, 0.6 },
	lose = { asset(1842335078), 0.8, 0.5 },
}
local STAND_IN_MUSIC = {
	lobby = { asset(1839580471), 0.32 },
	game = { asset(1841647421), 0.26 },
}

-- All the web game's effects are in one file, each in its own stretch of it.
local effects = nil
if Sounds.effects then
	effects = Instance.new("Sound")
	effects.Name = "Effects"
	effects.SoundId = asset(Sounds.effects)
	effects.Volume = Sounds.volume
	effects.PlaybackRegionsEnabled = true
	effects.Parent = SoundService
end

local standIns = {}
for name, spec in STAND_IN do
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = spec[1]
	sound.PlaybackSpeed = spec[2]
	sound.Volume = spec[3]
	sound.Parent = SoundService
	standIns[name] = sound
end

local muted = false

function Fx.sound(name)
	if muted then
		return
	end
	local region = Sounds.sprite[name]
	if effects and region then
		local copy = effects:Clone()
		copy.PlaybackRegion = NumberRange.new(region[1], region[1] + region[2])
		copy.Parent = SoundService
		copy:Play()
		Debris:AddItem(copy, region[2] + 1)
		return
	end
	local sound = standIns[name]
	if sound then
		local copy = sound:Clone()
		copy.Parent = SoundService
		copy:Play()
		Debris:AddItem(copy, 6)
	end
end

-- The tunes. The round's are in a few files, each a run of whole tunes, played
-- one after another round and round; the lobby's is one file that loops.
local tracks = {}
local function track(id, looped)
	local sound = Instance.new("Sound")
	sound.SoundId = asset(id)
	sound.Looped = looped
	sound.Volume = 0
	sound.Parent = SoundService
	return sound
end
for name, stand in STAND_IN_MUSIC do
	local music = Sounds.music[name]
	local parts = {}
	if name == "game" then
		for _, part in music do
			if part.id then
				table.insert(parts, { sound = track(part.id, false), starts = part.starts })
			end
		end
		-- Only with every file uploaded is the web game's set complete.
		if #parts < #music then
			table.clear(parts)
		end
	elseif music.id then
		parts[1] = { sound = track(music.id, true), starts = { 0 } }
	end
	local volume = Sounds.volume
	if #parts == 0 then
		parts[1] = { sound = track(string.match(stand[1], "%d+"), true), starts = { 0 } }
		volume = stand[2]
	end
	tracks[name] = { parts = parts, volume = volume, at = 1 }
	for k, part in parts do
		-- A round file played to its end hands over to the next.
		part.sound.Ended:Connect(function()
			local t = tracks[name]
			if t.on and t.at == k and #parts > 1 then
				t.at = k % #parts + 1
				local next = parts[t.at].sound
				next.TimePosition = 0
				next.Volume = t.volume
				next:Play()
			end
		end)
	end
end
local playing = nil

-- Fades over to the named tune; nil fades to silence. A round starts at the top
-- of one of the web game's tunes, picked at random, as the web shuffles them.
function Fx.music(name)
	for key, t in tracks do
		local on = key == name and not muted
		if on and not t.on then
			t.at = math.random(#t.parts)
			local part = t.parts[t.at]
			part.sound.TimePosition = part.starts[math.random(#part.starts)]
			part.sound:Play()
		end
		t.on = on
		for k, part in t.parts do
			local sound = part.sound
			local tween = TweenService:Create(sound, TweenInfo.new(0.8), { Volume = if on and k == t.at then t.volume else 0 })
			tween:Play()
			if not on then
				tween.Completed:Once(function()
					if sound.Volume == 0 then
						sound:Stop()
					end
				end)
			end
		end
	end
	playing = name
end

function Fx.setMuted(want)
	muted = want
	Fx.music(playing)
end

function Fx.muted()
	return muted
end

-- Camera shake and hit-stop -------------------------------------------------

local trauma = 0
local frozenUntil = 0

function Fx.shake(amount)
	trauma = math.min(1.2, trauma + amount)
end

-- Holds the picture still for a moment; the bigger the hit, the longer.
function Fx.hitStop(seconds)
	frozenUntil = math.max(frozenUntil, os.clock() + seconds)
end

function Fx.frozen()
	return os.clock() < frozenUntil
end

-- Called once a frame; returns how far to push the camera.
function Fx.cameraOffset(dt)
	trauma = math.max(0, trauma - dt * 2.6)
	if trauma <= 0 then
		return Vector3.zero
	end
	local power = trauma * trauma * 1.6
	return Vector3.new((math.random() - 0.5) * 2 * power, 0, (math.random() - 0.5) * 2 * power)
end

-- Things in the world -------------------------------------------------------

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		p[key] = value
	end
	p.Parent = folder
	return p
end

local function emitter(x, y, height, props, count)
	local holder = part({ Size = Vector3.one, Transparency = 1, Position = Vector3.new(x, height, y) })
	local e = Instance.new("ParticleEmitter")
	e.Enabled = false
	e.Rate = 0
	e.LightInfluence = 0
	for key, value in props do
		e[key] = value
	end
	e.Parent = holder
	e:Emit(count)
	Debris:AddItem(holder, 1.5)
end

-- Stars flying out of a hit.
function Fx.stars(x, y, color, count)
	emitter(x, y, 2, {
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(color),
		LightEmission = 0.7,
		Lifetime = NumberRange.new(0.3, 0.6),
		Speed = NumberRange.new(14, 30),
		Drag = 5,
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-300, 300),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.2), NumberSequenceKeypoint.new(1, 0) }),
	}, count or 14)
end

-- A puff of dust kicked off the ground.
function Fx.dust(x, y, count, spread)
	emitter(x, y, 0.5, {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(246, 232, 200)),
		Lifetime = NumberRange.new(0.3, 0.55),
		Speed = NumberRange.new(2, spread or 7),
		Drag = 4,
		SpreadAngle = Vector2.new(180, 180),
		Rotation = NumberRange.new(0, 360),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 2.6) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
	}, count or 5)
end

-- A ring that races outwards along the ground.
function Fx.ring(x, y, radius, color, seconds)
	local p = part({ Shape = Enum.PartType.Cylinder, Color = color, Material = Enum.Material.Neon, Transparency = 0.15 })
	p.Size = Vector3.new(0.12, 1, 1)
	p.CFrame = CFrame.new(x, 0.45, y) * UPRIGHT
	local info = TweenInfo.new(seconds, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	TweenService:Create(p, info, { Size = Vector3.new(0.12, radius * 2, radius * 2), Transparency = 1 }):Play()
	Debris:AddItem(p, seconds + 0.1)
end

-- Words that pop out of a spot on the map, hang for a beat and float away.
function Fx.words(x, y, message, color, studs)
	studs = studs or 9
	local anchor = part({ Size = Vector3.one, Transparency = 1, Position = Vector3.new(x, 2, y) })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(studs * 2.2, studs * 0.42)
	gui.StudsOffset = Vector3.new(0, 7.4, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.5)
	label.Font = FONT
	label.TextScaled = true
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.Rotation = math.random(-9, 9)
	label.Text = message
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = INK
	stroke.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.2
	scale.Parent = label
	TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	local away = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.4)
	TweenService:Create(gui, away, { StudsOffset = Vector3.new(0, 10, 0) }):Play()
	TweenService:Create(label, away, { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, away, { Transparency = 1 }):Play()
	Debris:AddItem(anchor, 0.95)
end

-- Whoever was bonked tumbles away from the blow and is gone.
function Fx.tumble(x, y, dx, dy, color)
	local p = part({ Color = color, Size = Vector3.new(3.2, 2.4, 3) })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	p.CFrame = CFrame.new(x, 1.4, y)
	local goal = CFrame.new(x + dx * 15, 7, y + dy * 15) * CFrame.Angles(4, 3, 5)
	local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(p, info, { CFrame = goal, Size = Vector3.new(0.4, 0.3, 0.4), Transparency = 0.6 }):Play()
	Debris:AddItem(p, 0.55)
end

-- A thrown seed streaking along its line.
function Fx.seedShot(x, y, dx, dy, reach)
	local seed = part({ Color = Color3.fromRGB(52, 42, 38), Size = Vector3.new(1.7, 0.8, 1) })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = seed
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0, 0.5)
	a0.Parent = seed
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, 0, -0.5)
	a1.Parent = seed
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.18
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120))
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = seed
	local turn = CFrame.Angles(0, -math.atan2(dy, dx), 0)
	seed.CFrame = CFrame.new(x, 1.6, y) * turn
	local info = TweenInfo.new(0.16, Enum.EasingStyle.Linear)
	TweenService:Create(seed, info, { CFrame = CFrame.new(x + dx * reach, 1.6, y + dy * reach) * turn }):Play()
	Debris:AddItem(seed, 0.4)
	task.delay(0.16, function()
		seed.Transparency = 1
	end)
end

-- Paper raining down the screen for a win.
function Fx.confetti(gui)
	local colors = {
		Color3.fromRGB(255, 214, 70),
		Color3.fromRGB(255, 120, 150),
		Color3.fromRGB(110, 190, 255),
		Color3.fromRGB(150, 220, 120),
		Color3.fromRGB(255, 255, 255),
	}
	for _ = 1, 70 do
		local bit = Instance.new("Frame")
		bit.BorderSizePixel = 0
		bit.BackgroundColor3 = colors[math.random(#colors)]
		bit.Size = UDim2.fromOffset(math.random(8, 14), math.random(12, 20))
		bit.Position = UDim2.new(math.random(), 0, -0.05, 0)
		bit.Rotation = math.random(0, 360)
		bit.ZIndex = 20
		bit.Parent = gui
		local seconds = 1.4 + math.random() * 1.6
		local info = TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, math.random() * 0.6)
		TweenService:Create(bit, info, {
			Position = UDim2.new(bit.Position.X.Scale + (math.random() - 0.5) * 0.2, 0, 1.1, 0),
			Rotation = bit.Rotation + math.random(-540, 540),
		}):Play()
		Debris:AddItem(bit, seconds + 0.7)
	end
end

return Fx
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Hamster</string><ProtectedString name="Source"><![CDATA[-- One hamster as it is drawn: a round body with ears, eyes, cheeks and paws, the
-- name over its head, and the little motions that make it feel alive. It is told
-- where it is and what it is doing every frame, and decides nothing.
-- Local frame of the parts: +X is forward, +Y is up, +Z is its right.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Lang = require(ReplicatedStorage:WaitForChild("Lang"))

local R = Config.HAMSTER_R
-- Drawn a little bigger than it collides, so it reads well from far above.
local GROW = 1.22
local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)
local GOLD = Color3.fromRGB(255, 214, 70)
local RED = Color3.fromRGB(255, 86, 74)
local INK = Color3.fromRGB(58, 40, 30)
local EAR_PINK = Color3.fromHex("#f7b6b6")
local CHEEK = Color3.fromRGB(255, 130, 150)
local EYE = Color3.fromHex("#2a1c14")
local NOSE = Color3.fromHex("#e58a8a")
local SEED = Color3.fromHex("#3a3330")
local SEED_STRIPE = Color3.fromHex("#f4efe6")
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- stands a cylinder on its end

local Hamster = {}
Hamster.__index = Hamster

local function basePart(parent, color)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color
	p.Parent = parent
	return p
end

-- info: { id, name, team, bot }. `me` marks the local player's own hamster.
-- It wears its seat's look from the web game, outlined in its colour.
function Hamster.new(parent, info, me)
	local look = Config.LOOKS[info.id]
	local color = Config.colorOf(info.id, info.team)
	local model = Instance.new("Model")
	model.Name = "Hamster" .. info.id
	model.Parent = parent
	-- What gets the outline: the hamster itself, not its ring, aim or tag.
	local body = Instance.new("Model")
	body.Name = "Body"
	body.Parent = model

	local self = setmetatable({
		id = info.id,
		name = info.name,
		me = me,
		color = color,
		look = look,
		model = model,
		pieces = {}, -- { part, offset, size }
		x = nil,
		y = nil,
		yaw = 0,
		stride = 0, -- how far along its waddle it is
		pace = 0, -- smoothed speed, studs per second
		pop = 0, -- a squash that springs back
		popSpeed = 0,
		swingAt = nil, -- os.clock() when the current swing began
		landed = false,
		clock = math.random() * 10,
		puff = 0, -- cheeks, 0..1
		daze = 0,
	}, Hamster)

	local function blob(key, offset, size, tint, shadow, parent_)
		local p = basePart(parent_ or body, tint)
		p.Size = size
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
		p.CastShadow = shadow == true
		local piece = { part = p, offset = offset * GROW, size = size * GROW }
		self.pieces[key] = piece
		return piece
	end

	blob("body", Vector3.new(0, 1.3, 0), Vector3.new(3.3, 2.5, 3.1), look.fur, true)
	blob("belly", Vector3.new(0.95, 0.95, 0), Vector3.new(1.55, 1.6, 2.25), look.belly)
	blob("tail", Vector3.new(-1.65, 1.0, 0), Vector3.new(0.55, 0.55, 0.55), look.belly)
	for _, s in { -1, 1 } do
		local k = if s < 0 then "L" else "R"
		blob("ear" .. k, Vector3.new(0.35, 2.45, s * 1.1), Vector3.new(0.55, 1.15, 1.15), look.ear, true)
		blob("earIn" .. k, Vector3.new(0.5, 2.5, s * 1.1), Vector3.new(0.45, 0.68, 0.68), EAR_PINK)
		blob("eye" .. k, Vector3.new(1.2, 1.95, s * 0.62), Vector3.new(0.46, 0.52, 0.46), EYE)
		blob("glint" .. k, Vector3.new(1.33, 2.13, s * 0.52), Vector3.new(0.17, 0.17, 0.17), WHITE)
		blob("cheek" .. k, Vector3.new(1.15, 1.35, s * 1.05), Vector3.new(0.7, 0.55, 0.7), CHEEK)
		blob("pawF" .. k, Vector3.new(0.95, 0.3, s * 1.0), Vector3.new(0.8, 0.5, 0.62), look.paw)
		blob("pawB" .. k, Vector3.new(-0.95, 0.3, s * 1.0), Vector3.new(0.85, 0.5, 0.68), look.paw)
	end
	blob("nose", Vector3.new(1.74, 1.5, 0), Vector3.new(0.3, 0.26, 0.4), NOSE)
	-- The paw that does the bonking.
	blob("fist", Vector3.new(0.4, 3.3, 0), Vector3.new(1.25, 1.25, 1.25), look.paw).part.Transparency = 1
	-- The seed, held in the mouth: dark with two pale stripes, as the web game draws it.
	blob("seed", Vector3.new(1.95, 1.2, 0), Vector3.new(1.3, 0.6, 0.8), SEED).part.Transparency = 1
	blob("seedStripe", Vector3.new(1.97, 1.36, 0), Vector3.new(1.0, 0.32, 0.26), SEED_STRIPE).part.Transparency = 1
	-- Stars that circle a dazed head.
	for i = 1, 3 do
		blob("star" .. i, Vector3.zero, Vector3.new(0.6, 0.6, 0.6), GOLD, false, model).part.Transparency = 1
		self.pieces["star" .. i].part.Material = Enum.Material.Neon
	end

	-- The web game's outline round the body, in the hamster's colour.
	local outline = Instance.new("Highlight")
	outline.Adornee = body
	outline.FillTransparency = 1
	outline.OutlineColor = color
	outline.OutlineTransparency = 0
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.Parent = model
	self.outline = outline

	-- A ring underfoot: mine in white, and everyone's in its team's colour.
	if me or info.team then
		local ring = basePart(model, if me then WHITE else color)
		ring.Shape = Enum.PartType.Cylinder
		ring.Material = Enum.Material.Neon
		ring.Transparency = if me then 0.1 else 0.35
		self.ring = ring
	end

	-- Shows where a thrown seed would go while the throw winds up.
	local aim = basePart(model, WHITE)
	aim.Material = Enum.Material.Neon
	aim.Transparency = 1
	self.aim = aim

	-- The name tag rides on a part that never squashes.
	local tag = basePart(model, WHITE)
	tag.Size = Vector3.one
	tag.Transparency = 1
	self.tag = tag
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromScale(16, 5.6)
	gui.StudsOffset = Vector3.new(0, 4.2, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Parent = tag

	local function label(position, size, tint, rim)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = position
		l.Size = size
		l.Font = FONT
		l.TextScaled = true
		l.TextColor3 = tint
		l.Text = ""
		l.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2.5
		stroke.Color = rim or INK
		stroke.Parent = l
		return l
	end
	self.status = label(UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.27), GOLD)
	local barBack = Instance.new("Frame")
	barBack.AnchorPoint = Vector2.new(0.5, 0)
	barBack.Position = UDim2.fromScale(0.5, 0.31)
	barBack.Size = UDim2.fromScale(0.42, 0.11)
	barBack.BackgroundColor3 = INK
	barBack.BorderSizePixel = 0
	barBack.Visible = false
	barBack.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = barBack
	local barStroke = Instance.new("UIStroke")
	barStroke.Thickness = 2
	barStroke.Color = INK
	barStroke.Parent = barBack
	local bar = Instance.new("Frame")
	bar.Size = UDim2.fromScale(0, 1)
	bar.BackgroundColor3 = GOLD
	bar.BorderSizePixel = 0
	bar.Parent = barBack
	corner:Clone().Parent = bar
	self.barBack = barBack
	self.bar = bar
	-- The name in the hamster's colour on white, as on the web; mine says so.
	self.label = label(UDim2.fromScale(0, 0.46), UDim2.fromScale(1, 0.32), color, WHITE)
	self.label.Text = info.name
	local level = info.bot and Config.BOT_LEVELS[info.bot]
	local under = if me then { name = Lang.t("me"), color = color } elseif level then { name = Lang.t("levels")[info.bot], color = level.color } else nil
	if under then
		label(UDim2.fromScale(0, 0.78), UDim2.fromScale(1, 0.22), under.color, WHITE).Text = under.name
	end
	return self
end

function Hamster:destroy()
	self.model:Destroy()
end

-- A quick squash that springs back: landing a hit, picking a seed, popping in.
function Hamster:squash(amount)
	self.popSpeed -= amount
end

-- Starts the bonk motion now. The snapshot starts it too; whichever comes first.
function Hamster:swing()
	if not self.swingAt or os.clock() - self.swingAt > 0.3 then
		self.swingAt = os.clock()
		self.landed = false
	end
end

local function setText(label, value)
	if label.Text ~= value then
		label.Text = value
	end
end

-- p: the hamster's line of the snapshot. x, y: where to draw it (already smoothed).
-- view: { bar, status } for the tag: how full its gauge is (or nil) and the words over it.
function Hamster:draw(dt, x, y, p, view)
	local moved = 0
	if self.x then
		moved = math.sqrt((x - self.x) ^ 2 + (y - self.y) ^ 2)
		if moved > 4 then
			-- Back at the nest, or out of a burrow: it pops into place.
			moved = 0
			self.pop = 0.45
		end
	end
	self.x, self.y = x, y
	self.clock += dt
	local speed = if dt > 0 then moved / dt else 0
	self.pace += (speed - self.pace) * (1 - math.exp(-dt * 14))
	local going = math.clamp(self.pace / Config.SPEED, 0, 1)
	self.stride += dt * (4 + going * 16) * (if going > 0.05 then 1 else 0)

	-- It turns towards where it faces, the short way round.
	local want = math.atan2(p.fy, p.fx)
	local turn = (want - self.yaw + math.pi) % (2 * math.pi) - math.pi
	self.yaw += turn * (1 - math.exp(-dt * 22))

	-- The squash spring.
	self.popSpeed += (-self.pop * 260 - self.popSpeed * 16) * dt
	self.pop += self.popSpeed * dt
	self.pop = math.clamp(self.pop, -0.5, 0.6)

	if p.windup or p.recovery then
		self:swing()
	end
	local swingT = if self.swingAt then os.clock() - self.swingAt else math.huge
	local WINDUP = Config.BONK.windup
	local lean = 0 -- backwards before the hit, forwards as it lands
	local lunge = 0
	local fist = self.pieces.fist
	if swingT < WINDUP then
		local k = swingT / WINDUP
		lean = -0.3 * k
		fist.part.Transparency = 0
		fist.offset = Vector3.new(0.2 - 0.5 * k, 3.1 + 0.6 * k, 0) * GROW
		fist.size = Vector3.one * (0.9 + 0.6 * k) * GROW
	elseif swingT < WINDUP + 0.2 then
		local k = (swingT - WINDUP) / 0.2
		local hit = math.min(1, k * 3.2) -- slams down in a third of the time, then holds
		lean = 0.34 * (1 - k)
		lunge = 0.85 * (1 - k) * hit
		fist.part.Transparency = if k > 0.7 then (k - 0.7) / 0.3 else 0
		fist.offset = Vector3.new(-0.3, 3.7, 0):Lerp(Vector3.new(2.9, 0.9, 0), hit) * GROW
		fist.size = Vector3.one * 1.6 * GROW
		if not self.landed then
			self.landed = true
			self.pop = -0.16
		end
	else
		fist.part.Transparency = 1
	end

	local dazed = p.dazed
	self.daze += ((if dazed then 1 else 0) - self.daze) * (1 - math.exp(-dt * 12))
	self.puff += ((if p.carrying then 1 else 0) - self.puff) * (1 - math.exp(-dt * 14))

	-- Squash and stretch: the waddle, breathing, and the spring.
	local bob = math.abs(math.sin(self.stride)) * 0.3 * going
	local breathe = math.sin(self.clock * 2.6) * 0.018 * (1 - going)
	local tall = 1 + self.pop + breathe + bob * 0.18 - self.daze * 0.28
	local wide = 1 - self.pop * 0.5 - breathe * 0.5 + self.daze * 0.16
	local scale = Vector3.new(wide, tall, wide)
	local roll = math.sin(self.stride) * 0.11 * going
	local root = CFrame.new(x, bob, y)
		* CFrame.Angles(0, -self.yaw, 0)
		* CFrame.new(lunge, 0, 0)
		* CFrame.Angles(roll, 0, lean)

	local alpha = if dazed then 0.45 else 0
	for key, piece in self.pieces do
		local part = piece.part
		local offset = piece.offset
		local size = piece.size
		if key == "fist" then
			part.CFrame = root * CFrame.new(offset)
			part.Size = size
			continue
		elseif key == "seed" or key == "seedStripe" then
			part.Transparency = if p.carrying then 0 else 1
		elseif string.sub(key, 1, 4) == "star" then
			local i = tonumber(string.sub(key, 5))
			local a = self.clock * 6 + i * 2.094
			part.Transparency = if dazed then 0 else 1
			part.CFrame = CFrame.new(x + math.cos(a) * 2, 4.4 + math.sin(a * 2) * 0.15, y + math.sin(a) * 2)
			continue
		elseif string.sub(key, 1, 3) == "paw" then
			-- Paws patter: front and back on each side go opposite ways.
			local front = string.sub(key, 4, 4) == "F"
			local right = string.sub(key, 5, 5) == "R"
			local phase = self.stride + (if front == right then 0 else math.pi)
			offset += Vector3.new(math.sin(phase) * 0.55 * going, math.max(0, math.cos(phase)) * 0.25 * going, 0)
			part.Transparency = alpha
		elseif string.sub(key, 1, 5) == "cheek" then
			-- A mouthful of seed puffs the cheeks out.
			size *= 1 + self.puff * 0.9
			part.Color = CHEEK:Lerp(self.look.belly, self.puff * 0.8)
			part.Transparency = math.max(alpha, 0.3 * (1 - self.puff))
		elseif string.sub(key, 1, 3) == "eye" then
			-- It blinks now and then, and squeezes its eyes shut when dazed.
			local shut = dazed or (self.clock % 3.4) < 0.11
			size = Vector3.new(size.X, if shut then 0.1 else size.Y, size.Z)
			part.Transparency = alpha
		elseif string.sub(key, 1, 5) == "glint" then
			part.Transparency = if dazed or (self.clock % 3.4) < 0.11 then 1 else 0
		elseif string.sub(key, 1, 3) == "ear" then
			-- Ears flick as it runs.
			offset += Vector3.new(0, math.sin(self.stride * 2) * 0.06 * going, 0)
			part.Transparency = alpha
		else
			part.Transparency = alpha
		end
		part.Size = size * scale
		part.CFrame = root * CFrame.new(offset * scale)
	end

	if self.ring then
		-- My own ring is the wider one, and it breathes.
		local pulse = if self.me then 1.12 + math.sin(self.clock * 4) * 0.06 else 1
		self.ring.Size = Vector3.new(0.08, (R + 0.7) * 2 * pulse, (R + 0.7) * 2 * pulse)
		self.ring.CFrame = CFrame.new(x, 0.36, y) * UPRIGHT
	end
	self.tag.Position = Vector3.new(x, 1.5, y)

	local aim = self.aim
	if p.charge > 0 then
		local THROW = Config.THROW
		local ready = p.charge >= THROW.charge
		local length = THROW.range * math.min(1, p.charge / THROW.charge)
		local forward = Vector3.new(p.fx, 0, p.fy)
		aim.Size = Vector3.new(length, 0.12, if ready then THROW.width * 2 else 0.7)
		aim.CFrame = CFrame.new(Vector3.new(x, 0.5, y) + forward * (R + length / 2)) * CFrame.Angles(0, -want, 0)
		aim.Color = if p.charge > THROW.max - 0.35 then RED elseif ready then GOLD else WHITE
		aim.Transparency = if ready then 0.55 else 0.4
	else
		aim.Transparency = 1
	end

	-- A carrier close to home sets the alarm off.
	setText(self.label, (if p.alarm then "🚨 " elseif p.carrying then "🌻 " else "") .. self.name)
	self.label.TextColor3 = if p.alarm then RED else self.color
	setText(self.status, view.status)
	self.barBack.Visible = view.bar ~= nil
	if view.bar then
		self.bar.Size = UDim2.fromScale(view.bar, 1)
	end
end

return Hamster
]]></ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">Input</string><ProtectedString name="Source"><![CDATA[-- Reads what the player is pressing and tells the server: a move direction, the
-- bonk button and the throw button. Nothing here decides anything about the game.
--   PC: WASD / arrows, Space / J, F / K      pad: left stick / D-pad, A, B
--   touch: a joystick under the left thumb and two buttons under the right

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Lang = require(ReplicatedStorage:WaitForChild("Lang"))

local player = Players.LocalPlayer
Lang.pick(player)
local remote = ReplicatedStorage:WaitForChild("HashRushRemotes"):WaitForChild("Input")

-- Roblox's own movement and jump controls are not used.
GuiService.TouchControlsEnabled = false
task.spawn(function()
	local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10)
	if module then
		pcall(function()
			require(module):GetControls():Disable()
		end)
	end
end)

-- Keys and gamepad --------------------------------------------------------

local KEY_DIRS = {
	[Enum.KeyCode.W] = Vector2.new(0, -1),
	[Enum.KeyCode.Up] = Vector2.new(0, -1),
	[Enum.KeyCode.DPadUp] = Vector2.new(0, -1),
	[Enum.KeyCode.S] = Vector2.new(0, 1),
	[Enum.KeyCode.Down] = Vector2.new(0, 1),
	[Enum.KeyCode.DPadDown] = Vector2.new(0, 1),
	[Enum.KeyCode.A] = Vector2.new(-1, 0),
	[Enum.KeyCode.Left] = Vector2.new(-1, 0),
	[Enum.KeyCode.DPadLeft] = Vector2.new(-1, 0),
	[Enum.KeyCode.D] = Vector2.new(1, 0),
	[Enum.KeyCode.Right] = Vector2.new(1, 0),
	[Enum.KeyCode.DPadRight] = Vector2.new(1, 0),
}

local keysDown = {}
local padStick = Vector2.zero
local bonkKey = false
local throwKey = false

local moveKeys = { Enum.KeyCode.Thumbstick1 }
for key in KEY_DIRS do
	table.insert(moveKeys, key)
end

ContextActionService:BindAction("HashRushMove", function(_, inputState, input)
	if input.KeyCode == Enum.KeyCode.Thumbstick1 then
		local tilted = inputState == Enum.UserInputState.Change or inputState == Enum.UserInputState.Begin
		-- The stick's up is +Y; on screen up is -y.
		padStick = if tilted then Vector2.new(input.Position.X, -input.Position.Y) else Vector2.zero
	else
		keysDown[input.KeyCode] = if inputState == Enum.UserInputState.Begin then true else nil
	end
	return Enum.ContextActionResult.Sink
end, false, table.unpack(moveKeys))

ContextActionService:BindAction("HashRushBonk", function(_, inputState)
	bonkKey = inputState == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.Space, Enum.KeyCode.J, Enum.KeyCode.ButtonA)

ContextActionService:BindAction("HashRushThrow", function(_, inputState)
	throwKey = inputState == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.F, Enum.KeyCode.K, Enum.KeyCode.ButtonB)

UserInputService.WindowFocusReleased:Connect(function()
	table.clear(keysDown)
	padStick = Vector2.zero
	bonkKey = false
	throwKey = false
end)

-- Touch -------------------------------------------------------------------

local STICK_RADIUS = 60
local touchMove = Vector2.zero
local stickTouch = nil
local stickOrigin = Vector2.zero
local held = {} -- [button name] = the InputObject pressing it

-- IgnoreGuiInset stays off so that InputObject.Position lines up with the gui.
local gui = Instance.new("ScreenGui")
gui.Name = "HashRushTouch"
gui.ResetOnSpawn = false
gui.DisplayOrder = 5
gui.Enabled = UserInputService.TouchEnabled
gui.Parent = player:WaitForChild("PlayerGui")

local function round(parent)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = parent
end

local pad = Instance.new("Frame")
pad.Name = "StickArea"
pad.BackgroundTransparency = 1
pad.Position = UDim2.fromScale(0, 0.2)
pad.Size = UDim2.fromScale(0.5, 0.8)
pad.Active = true
pad.Parent = gui

local base = Instance.new("Frame")
base.AnchorPoint = Vector2.new(0.5, 0.5)
base.Size = UDim2.fromOffset(STICK_RADIUS * 2, STICK_RADIUS * 2)
base.BackgroundColor3 = Color3.fromRGB(58, 40, 30)
base.BackgroundTransparency = 0.6
base.Visible = false
base.Parent = gui
round(base)

local knob = Instance.new("Frame")
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.Size = UDim2.fromOffset(STICK_RADIUS, STICK_RADIUS)
knob.Position = UDim2.fromScale(0.5, 0.5)
knob.BackgroundColor3 = Color3.new(1, 1, 1)
knob.BackgroundTransparency = 0.35
knob.Parent = base
round(knob)

local function moveStick(position)
	local delta = (Vector2.new(position.X, position.Y) - stickOrigin) / STICK_RADIUS
	if delta.Magnitude > 1 then
		delta = delta.Unit
	end
	knob.Position = UDim2.fromScale(0.5 + delta.X / 2, 0.5 + delta.Y / 2)
	if delta.Magnitude < 0.25 then
		touchMove = Vector2.zero
		return
	end
	-- Snapped to 16 directions, so a thumb that drifts a little still runs straight.
	local step = math.pi / 8
	local angle = math.round(math.atan2(delta.Y, delta.X) / step) * step
	touchMove = Vector2.new(math.cos(angle), math.sin(angle))
end

pad.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.Touch or stickTouch then
		return
	end
	stickTouch = input
	stickOrigin = Vector2.new(input.Position.X, input.Position.Y)
	base.Position = UDim2.fromOffset(stickOrigin.X, stickOrigin.Y)
	base.Visible = true
	moveStick(input.Position)
end)

local function button(name, text, size, offsetY, color)
	local b = Instance.new("TextButton")
	b.Name = name
	b.AnchorPoint = Vector2.new(1, 1)
	b.Position = UDim2.new(1, -28, 1, offsetY)
	b.Size = UDim2.fromOffset(size, size)
	b.BackgroundColor3 = color
	b.BackgroundTransparency = 0.2
	b.AutoButtonColor = false
	b.Text = text
	b.TextSize = math.floor(size * 0.22)
	b.Font = Enum.Font.FredokaOne
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = gui
	round(b)
	local rim = Instance.new("UIStroke")
	rim.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rim.Thickness = 4
	rim.Color = Color3.fromRGB(58, 40, 30)
	rim.Parent = b
	local outline = Instance.new("UIStroke")
	outline.Thickness = 2.5
	outline.Color = Color3.fromRGB(58, 40, 30)
	outline.Parent = b
	local shine = Instance.new("UIGradient")
	shine.Rotation = 90
	shine.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205))
	shine.Parent = b
	local press = Instance.new("UIScale")
	press.Name = "Press"
	press.Parent = b
	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			held[name] = input
			b.BackgroundTransparency = 0
			press.Scale = 0.9
		end
	end)
	return b
end

local bonkButton = button("Bonk", Lang.t("bonkButton"), 124, -28, Color3.fromRGB(240, 96, 76))
-- Only there while there is a seed to throw. View keeps the attribute up to date.
local throwButton = button("Throw", Lang.t("throwButton"), 100, -172, Color3.fromRGB(240, 176, 44))
throwButton.Visible = false
player:GetAttributeChangedSignal("HRCarrying"):Connect(function()
	throwButton.Visible = player:GetAttribute("HRCarrying") == true
	if not throwButton.Visible then
		held.Throw = nil
		throwButton.BackgroundTransparency = 0.2
		throwButton.Press.Scale = 1
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == stickTouch then
		moveStick(input.Position)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input == stickTouch then
		stickTouch = nil
		touchMove = Vector2.zero
		base.Visible = false
	end
	for name, pressing in held do
		if pressing == input or (input.UserInputType == Enum.UserInputType.MouseButton1 and pressing.UserInputType == Enum.UserInputType.MouseButton1) then
			held[name] = nil
			gui[name].BackgroundTransparency = 0.2
			gui[name].Press.Scale = 1
		end
	end
end)

-- The touch controls show for whoever last touched the screen.
UserInputService.LastInputTypeChanged:Connect(function(last)
	if last == Enum.UserInputType.Touch then
		gui.Enabled = true
	elseif last == Enum.UserInputType.Keyboard or last.Name:find("Gamepad") then
		gui.Enabled = false
	end
end)

-- Sending -----------------------------------------------------------------

local function moveVector()
	local keys = Vector2.zero
	for key in keysDown do
		keys += KEY_DIRS[key]
	end
	if keys.Magnitude > 0 then
		return keys.Unit
	end
	if padStick.Magnitude > 0.2 then
		return if padStick.Magnitude > 1 then padStick.Unit else padStick
	end
	return touchMove
end

local sent = { mx = 0, my = 0, bonk = false, throw = false }
local sentAt = 0

local bonks = 0
local wasBonk = false

RunService.Heartbeat:Connect(function()
	local move = moveVector()
	local mx = math.round(move.X * 100) / 100
	local my = math.round(move.Y * 100) / 100
	local bonk = bonkKey or held.Bonk ~= nil
	local throw = throwKey or held.Throw ~= nil
	-- View draws the player's own hamster from these without waiting for the server.
	if player:GetAttribute("HRMove") ~= move then
		player:SetAttribute("HRMove", move)
	end
	if bonk and not wasBonk then
		bonks += 1
		player:SetAttribute("HRBonk", bonks)
	end
	wasBonk = bonk
	-- The tutorial plays its own round on this machine, from these.
	if player:GetAttribute("HRBonkHeld") ~= bonk then
		player:SetAttribute("HRBonkHeld", bonk)
	end
	if player:GetAttribute("HRThrowHeld") ~= throw then
		player:SetAttribute("HRThrowHeld", throw)
	end
	local buttons = bonk ~= sent.bonk or throw ~= sent.throw
	local moved = mx ~= sent.mx or my ~= sent.my
	-- Buttons go out at once; a stick being rolled around goes out 30 times a second.
	if not buttons and not (moved and os.clock() - sentAt >= 1 / 30) then
		return
	end
	sent.mx, sent.my, sent.bonk, sent.throw = mx, my, bonk, throw
	sentAt = os.clock()
	remote:FireServer(mx, my, bonk, throw)
	-- View uses this for the "hold still" hint at the flower.
	player:SetAttribute("HRMoving", mx ~= 0 or my ~= 0)
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- Where the web game's own sounds are (src/client/audio.js, music.js), as
-- tools/audio renders them and Roblox holds them once uploaded. Written by
-- tools/audio/build.py: run it again rather than editing this. Without ids
-- Fx plays Roblox's own sounds in their place.
return {
	effects = 85219973142525,
	-- One loudness for effects and music: the balance the web game has.
	volume = 1,
	-- Each effect: where it starts in the effects file and how long it is, in seconds.
	sprite = {
		swing = { 0, 0.0899 },
		bonk = { 0.3899, 0.1695 },
		toss = { 0.8594, 0.1788 },
		double = { 1.3382, 0.3982 },
		triple = { 2.0364, 0.98 },
		superplay = { 3.3164, 1 },
		spawn = { 4.6164, 0.1199 },
		seed = { 5.0363, 0.6798 },
		siren = { 6.0161, 1.0894 },
		tick = { 7.4055, 0.0546 },
		tock = { 7.7601, 0.0547 },
		count = { 8.1148, 0.2382 },
		go = { 8.653, 1.1197 },
		overtime = { 10.0727, 1.54 },
		fanfare = { 11.9127, 2.94 },
		cheer = { 15.1527, 4.8087 },
		win = { 20.2614, 0.579 },
		lose = { 21.1404, 0.6885 },
		chat = { 22.1289, 0.1697 },
	},
	music = {
		-- The round tunes back to back, in files short enough for Roblox, played
		-- one after the other; each tune starts where it says in its file.
		game = {
			{ id = 121944402092878, starts = { 0.0, 121.739, 238.406 } }, -- game, hop, sprint
			{ id = 113812252161376, starts = { 0.0, 127.273, 247.273 } }, -- tango, boogie, parade
		},
		lobby = { id = 134905893616866 },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[-- The tutorial: a round of its own, played on this machine with the game's own
-- rules (Sim), one thing at a time: walk to the flower, nibble a seed by holding
-- still, carry it home, bonk, throw, pickpocket, take a portal. Each step sets the
-- meadow up for itself and waits until the player has done it.
-- View draws it as it draws a real round, through the hooks given to `run`.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Lang = require(ReplicatedStorage:WaitForChild("Lang"))
local Map = require(ReplicatedStorage:WaitForChild("Map"))
local Sim = require(ReplicatedStorage:WaitForChild("Sim"))
local Snapshot = require(ReplicatedStorage:WaitForChild("Snapshot"))

local player = Players.LocalPlayer
local FLOWER = Map.flower
local HOME = Map.home
-- The open grass between home and the hedges, where the drills take place.
local STRIP = HOME.x2 + 3
local WARP = Map.warps[1]
local STILL = table.freeze({ mx = 0, my = 0, bonk = false, throw = false })

local function near(p, x, y, r)
	return (p.x - x) ^ 2 + (p.y - y) ^ 2 <= r * r
end

-- Each step: how to set the meadow up (nil carries on with the one before),
-- where to point, and when it is done. Its title, what to do and the word over
-- the spot are Lang's "steps", in the same order. Set-up places each seat:
-- place(seat, x, y, facing x, facing y, carrying), nil x for its nest.
local STEPS = {
	{
		setup = function(place)
			place(1, nil, nil)
		end,
		target = function()
			return Vector3.new(FLOWER.x, 0, FLOWER.y), "🌻"
		end,
		done = function(g, me)
			return near(me, FLOWER.x, FLOWER.y, FLOWER.gatherR)
		end,
	},
	{
		target = function()
			return Vector3.new(FLOWER.x, 0, FLOWER.y), "🌻"
		end,
		done = function(g, me)
			return me.carrying
		end,
	},
	{
		target = function(g, me)
			return Vector3.new(g.homeX - 3, 0, math.clamp(me.y, HOME.y1 + 4, HOME.y2 - 4)), "🏠"
		end,
		done = function(g)
			return g.phase == "over"
		end,
	},
	{
		setup = function(place)
			place(1, STRIP, 20, 0, 1)
			place(2, STRIP, 26)
		end,
		target = function(g)
			local dummy = g.byId[2]
			return Vector3.new(dummy.x, 0, dummy.y), "👊"
		end,
		event = function(e)
			return e.type == "bonk" and e.by == 1
		end,
	},
	{
		setup = function(place)
			place(1, STRIP, 11, 0, 1, true)
			place(2, STRIP, 17)
			place(3, STRIP, 21)
		end,
		target = function(g)
			local dummy = g.byId[2]
			return Vector3.new(dummy.x, 0, dummy.y), "🌻"
		end,
		event = function(e)
			return e.type == "throw" and e.id == 1 and e.hit > 0
		end,
		-- A throw that hit nobody: set it up again and say so.
		retry = function(e)
			return e.type == "throw" and e.id == 1 and e.hit == 0
		end,
	},
	{
		setup = function(place)
			place(1, STRIP, 18, 0, 1)
			place(2, STRIP, 26, nil, nil, true)
		end,
		target = function(g)
			local dummy = g.byId[2]
			return Vector3.new(dummy.x, 0, dummy.y), "🤏"
		end,
		event = function(e)
			return e.type == "steal" and e.by == 1
		end,
	},
	{
		setup = function(place)
			place(1, WARP.x - 6, WARP.y + 6)
		end,
		target = function()
			return Vector3.new(WARP.x, 0, WARP.y), "🌀"
		end,
		event = function(e)
			return e.type == "warp" and e.id == 1
		end,
	},
	{
		last = true,
	},
}

local Tutorial = {}
Tutorial.STEPS = #STEPS

--[[ hooks:
	begin(roster)            a new round is set up; seat 1 is the player
	snapshot(snap)           the round as it is now, as the server would send it
	event(e)                 something happened in it
	say(index, words, again) the step to show: { title, text, last }; `again` asks for another go
	target(at?, icon, label) where to point, or nil
	cheer()                  a step done
	finish()                 the tutorial is over
]]
function Tutorial.run(hooks)
	local game_ = nil
	local index = 0
	local acc = 0
	local rng = Random.new()
	local stopped = false
	local connection

	local function roster(count)
		local list = {}
		for seat = 1, count do
			table.insert(list, {
				id = seat,
				userId = if seat == 1 then player.UserId else -seat,
				name = if seat == 1 then player.DisplayName else Lang.t("names")[seat],
				wins = 0,
				kills = 0,
			})
		end
		return list
	end

	local function setUp(step)
		local spots = {}
		step.setup(function(seat, x, y, fx, fy, carrying)
			spots[seat] = { x = x, y = y, fx = fx, fy = fy, carrying = carrying }
		end)
		local slots = {}
		for seat = 1, #spots do
			slots[seat] = { id = seat, name = if seat == 1 then player.DisplayName else Lang.t("names")[seat] }
		end
		game_ = Sim.new(Map, slots, function()
			return rng:NextNumber()
		end)
		-- No count-down: straight into it.
		game_.phase = "playing"
		game_.countdown = 0
		for seat, spot in spots do
			local p = game_.byId[seat]
			if spot.x then
				p.x, p.y = spot.x, spot.y
			end
			if spot.fx then
				p.fx, p.fy = spot.fx, spot.fy
			end
			p.carrying = spot.carrying == true
		end
		hooks.begin(roster(#spots))
	end

	-- The step's words, in the player's language; `again` asks for another go.
	local function say(at, again)
		local words = Lang.t("steps")[at]
		hooks.say(at, { title = words.title, text = words.text, last = STEPS[at].last }, if again then words.again else nil)
	end

	local function goTo(next)
		index = next
		local step = STEPS[index]
		if not step then
			hooks.finish()
			return
		end
		if step.setup then
			setUp(step)
		end
		say(index)
	end

	local function stop()
		if stopped then
			return
		end
		stopped = true
		connection:Disconnect()
	end

	connection = RunService.Heartbeat:Connect(function(dt)
		local step = STEPS[index]
		if not step or step.last or not game_ then
			return
		end
		acc = math.min(acc + dt, 0.25)
		while acc >= Config.DT do
			acc -= Config.DT
			local move = player:GetAttribute("HRMove")
			local inputs = {
				[1] = {
					mx = if move then move.X else 0,
					my = if move then move.Y else 0,
					bonk = player:GetAttribute("HRBonkHeld") == true,
					throw = player:GetAttribute("HRThrowHeld") == true,
				},
			}
			for seat in game_.byId do
				if seat ~= 1 then
					inputs[seat] = STILL
				end
			end
			Sim.step(game_, inputs)
			-- The clock stands still: no overtime in the middle of a lesson.
			game_.time = 0
			local passed, retry = false, false
			for _, e in game_.events do
				hooks.event(e)
				passed = passed or (step.event ~= nil and step.event(e))
				retry = retry or (step.retry ~= nil and step.retry(e))
			end
			local me = game_.byId[1]
			passed = passed or (step.done ~= nil and step.done(game_, me))
			hooks.snapshot(Snapshot.decode(Snapshot.encode(0, game_, function(p)
				return Sim.lastStretch(game_, p)
			end)))
			if passed then
				hooks.cheer()
				-- A moment to see it happen before the meadow is set up again.
				local next = index + 1
				index = -1
				task.delay(if STEPS[next] and STEPS[next].setup then 1.2 else 0.4, function()
					if not stopped then
						goTo(next)
					end
				end)
				return
			elseif retry then
				local this = index
				index = -1
				task.delay(1, function()
					if not stopped then
						goTo(this)
						say(this, true)
					end
				end)
				return
			end
		end
		local at, icon = step.target(game_, game_.byId[1])
		hooks.target(at, icon, Lang.t("steps")[index].label)
	end)

	goTo(1)
	return {
		stop = stop,
		-- The last step's button: done.
		finish = function()
			stop()
			hooks.finish()
		end,
		-- The round being played, for tests.
		round = function()
			return game_
		end,
	}
end

return Tutorial
]]></ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">View</string><ProtectedString name="Source"><![CDATA[-- Everything the player sees: the camera looking down on the meadow, a hamster
-- for every seat, and the words on screen. It draws what the server says and
-- decides nothing. The one liberty it takes is drawing the player's own hamster
-- a little ahead of the server, so that the keys answer at once.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Map = require(ReplicatedStorage:WaitForChild("Map"))
local Sim = require(ReplicatedStorage:WaitForChild("Sim"))
local Snapshot = require(ReplicatedStorage:WaitForChild("Snapshot"))
local Lang = require(ReplicatedStorage:WaitForChild("Lang"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Hamster = require(script.Parent:WaitForChild("Hamster"))
local Tutorial = require(script.Parent:WaitForChild("Tutorial"))

local player = Players.LocalPlayer
Lang.pick(player)
local UserInputService = game:GetService("UserInputService")
-- A phone or tablet with no keyboard: the words name its buttons, not keys.
local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local remotes = ReplicatedStorage:WaitForChild("HashRushRemotes")
local roundRemote = remotes:WaitForChild("Round")
local readyRemote = remotes:WaitForChild("Ready")
local lobbyRemote = remotes:WaitForChild("Lobby")
local snapRemote = remotes:WaitForChild("Snap")
local mapFolder = workspace:WaitForChild("HashRushMap")
Map.label(mapFolder)

local WORLD_W = Map.world.w
local WORLD_H = Map.world.h
local HOME_X1 = Map.home.x1
local FLOWER = Map.flower
local homePart = mapFolder:WaitForChild("Home")
local homeEdge = mapFolder:WaitForChild("HomeEdge")
local sunflower = mapFolder:WaitForChild("Sunflower")
local sunflowerAt = sunflower:GetPivot()

local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)
local INK = Color3.fromRGB(58, 40, 30)
local PANEL = Color3.fromRGB(64, 44, 34)
local CREAM = Color3.fromRGB(255, 244, 222)
local RED = Color3.fromRGB(255, 86, 74)
local GOLD = Color3.fromRGB(255, 214, 70)

task.spawn(function()
	for _, kind in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu, Enum.CoreGuiType.PlayerList } do
		for _ = 1, 10 do
			if pcall(StarterGui.SetCoreGuiEnabled, StarterGui, kind, false) then
				break
			end
			task.wait(0.5)
		end
	end
end)

-- Camera ------------------------------------------------------------------
-- Waiting, watching or out of the round, it shows the whole meadow. Playing, it
-- comes in close over my hamster and keeps it in the middle, gliding after it;
-- a portal or a knock-out home cuts straight to where it went.

local FOV = 20 -- narrow, so the picture stays close to flat
local TILT_WIDE = math.rad(16) -- off straight down, enough to see the sides of things
local TILT_NEAR = math.rad(30) -- closer in, a little more from the side
local NEAR_H = 30 -- studs of meadow from the top of the screen to the bottom, close in
local NEAR_W = 36 -- and at least this many across, on a narrow screen
local FOLLOW = 3.2 -- how quickly it catches up, per second
local punch = 0 -- a hit pushes the camera in for a moment
local focus = nil -- the spot it looks at while close in
local lead = Vector3.zero -- where my hamster is heading, smoothed
local lastTarget = nil
local near = 0 -- 0 the whole meadow, 1 close in; eased between
local snapCamera = true

local function placeCamera(dt, target)
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	punch = math.max(0, punch - dt * 5)
	camera.FieldOfView = FOV - punch * 0.7
	local view = camera.ViewportSize
	local aspect = view.X / math.max(1, view.Y)
	local half = math.tan(math.rad(FOV / 2))
	local shake = Fx.cameraOffset(dt)

	-- The whole meadow, with room for the top bar.
	local wideDistance = math.max(WORLD_H * 1.2 * math.cos(TILT_WIDE) / (2 * half), WORLD_W * 1.05 / (2 * half * aspect))
	local wideCentre = Vector3.new(WORLD_W / 2, 0, WORLD_H * 0.45)

	near += ((if target then 1 else 0) - near) * (1 - math.exp(-dt * (if target then 4 else 2.5)))
	if target then
		local at = Vector3.new(target.X, 0, target.Y)
		if snapCamera or not focus or not lastTarget or (at - lastTarget).Magnitude > 12 then
			-- A portal, a knock-out or a new round: straight there.
			focus = at
			lead = Vector3.zero
			snapCamera = false
		elseif dt > 0 then
			-- Looking a little ahead of where it runs, so gliding after it does not
			-- leave it trailing behind the middle.
			local velocity = (at - lastTarget) / dt
			lead += (velocity / FOLLOW - lead) * (1 - math.exp(-dt * 6))
			focus = focus:Lerp(at + lead, 1 - math.exp(-dt * FOLLOW))
		end
		lastTarget = at
	else
		lastTarget = nil
	end

	local tilt = TILT_WIDE + (TILT_NEAR - TILT_WIDE) * near
	local nearDistance = math.max(NEAR_H * math.cos(TILT_NEAR) / (2 * half), NEAR_W / (2 * half * aspect))
	local nearCentre = wideCentre
	if focus then
		-- Not much past the fence: the view stops at the edge of the meadow.
		local halfW = nearDistance * half * aspect
		local halfH = NEAR_H / 2
		local function hold(v, lo, hi)
			return if lo > hi then (lo + hi) / 2 else math.clamp(v, lo, hi)
		end
		nearCentre = Vector3.new(hold(focus.X, halfW - 3, WORLD_W - halfW + 3), 0, hold(focus.Z, halfH - 4, WORLD_H - halfH + 3))
	end
	local distance = wideDistance + (nearDistance - wideDistance) * near
	local centre = wideCentre:Lerp(nearCentre, near) + shake
	-- Screen right is +X and screen down is +Z, the same way round as the sim.
	camera.CFrame = CFrame.lookAt(centre + Vector3.new(0, math.cos(tilt), math.sin(tilt)) * distance, centre)
end

-- Screen ------------------------------------------------------------------

local function make(className, props, parent)
	local object = Instance.new(className)
	for key, value in props do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function text(props, parent, outline)
	local label = make("TextLabel", {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = WHITE,
		TextScaled = true,
		Text = "",
	}, nil)
	for key, value in props do
		label[key] = value
	end
	label.Parent = parent
	if outline ~= false then
		make("UIStroke", { Thickness = outline or 3, Color = INK }, label)
	end
	return label
end

-- A rounded card with a dark rim.
local function panel(props, parent, radius)
	local frame = make("Frame", { BackgroundColor3 = PANEL, BorderSizePixel = 0 }, nil)
	for key, value in props do
		frame[key] = value
	end
	frame.Parent = parent
	make("UICorner", { CornerRadius = UDim.new(0, radius or 18) }, frame)
	make("UIStroke", { Thickness = 3, Color = INK }, frame)
	return frame
end

local function pop(scale, from)
	scale.Scale = from or 0.3
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local screen = make("ScreenGui", { Name = "HashRushHud", ResetOnSpawn = false, IgnoreGuiInset = true }, player:WaitForChild("PlayerGui"))
-- Everything is laid out for a screen 720 tall and scaled to the real one.
local hud = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, screen)
local hudScale = make("UIScale", {}, hud)
local function fitHud()
	local view = workspace.CurrentCamera.ViewportSize
	local s = math.clamp(math.min(view.Y / 720, view.X / 900), 0.45, 2)
	hudScale.Scale = s
	hud.Size = UDim2.fromScale(1 / s, 1 / s)
end

-- A red rim when a seed is about to get home, and a flash on a hit.
local alarmRim = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, screen)
local alarmStroke = make("UIStroke", { Thickness = 16, Color = RED, Transparency = 0.4 }, alarmRim)
local flashFrame = make("Frame", { BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 30 }, screen)
local function flash(color, strength)
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - strength
	TweenService:Create(flashFrame, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
end

local timerPanel = panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(190, 50) }, hud, 25)
local timerLabel = text({ Size = UDim2.new(1, -24, 1, -10), Position = UDim2.fromOffset(12, 5) }, timerPanel, false)
local timerScale = make("UIScale", {}, timerPanel)
local scoreRow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 68), Size = UDim2.new(1, -24, 0, 30), BackgroundTransparency = 1 }, hud)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, scoreRow)

-- Sound on and off.
local muteButton = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12), Size = UDim2.fromOffset(46, 46), BackgroundColor3 = PANEL, BorderSizePixel = 0, AutoButtonColor = false, Font = FONT, TextSize = 24, TextColor3 = WHITE, Text = "🔊" }, hud)
make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, muteButton)
make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 3, Color = INK }, muteButton)
muteButton.Activated:Connect(function()
	Fx.setMuted(not Fx.muted())
	muteButton.Text = if Fx.muted() then "🔇" else "🔊"
end)

-- Who bonked whom, newest at the top.
local feed = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 112), Size = UDim2.fromOffset(300, 200), BackgroundTransparency = 1 }, hud)
make("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, feed)
local feedCount = 0

local bigLabel = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(520, 190), Visible = false }, hud, 7)
local bigScale = make("UIScale", {}, bigLabel)
local bannerLabel = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.24), Size = UDim2.fromOffset(860, 76), TextColor3 = GOLD, Visible = false }, hud, 5)
local bannerScale = make("UIScale", {}, bannerLabel)
local noticePanel = panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.fromOffset(520, 40), Visible = false }, hud, 20)
local noticeLabel = text({ Size = UDim2.new(1, -30, 1, -14), Position = UDim2.fromOffset(15, 7) }, noticePanel, false)
local function notice(message)
	noticeLabel.Text = message
	noticePanel.Visible = message ~= ""
end

-- Nothing starts until the players say so: this is the button that says so.
local readyButton = make("TextButton", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -62),
	Size = UDim2.fromOffset(300, 64),
	BackgroundColor3 = Color3.fromRGB(96, 196, 96),
	BorderSizePixel = 0,
	AutoButtonColor = false,
	Font = FONT,
	TextSize = 30,
	TextColor3 = WHITE,
	Text = "",
	Visible = false,
}, hud)
make("UICorner", { CornerRadius = UDim.new(0, 26) }, readyButton)
make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 4, Color = INK }, readyButton)
make("UIStroke", { Thickness = 3, Color = INK }, readyButton)
local readyScale = make("UIScale", {}, readyButton)
local myReady = false
local function showReady()
	readyButton.Text = if myReady then Lang.t("ready") else Lang.t("readyPrompt") .. (if touchOnly then "" else Lang.t("readyKey"))
	readyButton.BackgroundColor3 = if myReady then Color3.fromRGB(120, 130, 140) else Color3.fromRGB(96, 196, 96)
end
local function setReady(want)
	myReady = want
	showReady()
	pop(readyScale, 0.8)
	readyRemote:FireServer(want)
end
readyButton.Activated:Connect(function()
	setReady(not myReady)
end)
ContextActionService:BindAction("HashRushReady", function(_, inputState)
	if inputState ~= Enum.UserInputState.Begin or not readyButton.Visible then
		return Enum.ContextActionResult.Pass
	end
	setReady(not myReady)
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.ButtonStart)

-- The lobby's bots: how many, and how good. Anyone may change them.
local botBar = panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -134), Size = UDim2.fromOffset(546, 46), Visible = false }, hud, 23)
local botLabel = text({ Position = UDim2.fromOffset(16, 9), Size = UDim2.fromOffset(120, 28), TextXAlignment = Enum.TextXAlignment.Left }, botBar, false)
local function barButton(label, x, width, action)
	local button = make("TextButton", { Position = UDim2.fromOffset(x, 6), Size = UDim2.fromOffset(width, 34), BackgroundColor3 = Color3.fromRGB(110, 78, 48), BorderSizePixel = 0, AutoButtonColor = false, Font = FONT, TextSize = 20, TextColor3 = CREAM, Text = label }, botBar)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, button)
	make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 2, Color = INK }, button)
	button.Activated:Connect(function()
			action()
	end)
	return button
end
barButton("−", 146, 40, function()
	lobbyRemote:FireServer("bots", -1)
end)
barButton("+", 192, 40, function()
	lobbyRemote:FireServer("bots", 1)
end)
local levelButton = barButton("", 246, 170, function()
	lobbyRemote:FireServer("level")
end)
local modeButton = barButton("", 424, 108, function()
	lobbyRemote:FireServer("teams")
end)

-- How to play and who is here, shown while waiting in the lobby.
local helpPanel = panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(820, 372), Visible = false }, hud, 28)
local peopleList = make("Frame", { Position = UDim2.fromOffset(540, 150), Size = UDim2.fromOffset(252, 200), BackgroundColor3 = Color3.fromRGB(48, 32, 24), BorderSizePixel = 0 }, helpPanel)
make("UICorner", { CornerRadius = UDim.new(0, 14) }, peopleList)
make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, peopleList)
make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 6) }, peopleList)
local function showPeople(msg)
	for _, child in peopleList:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local function line(order, message, color)
		make("TextLabel", { LayoutOrder = order, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), Font = FONT, TextSize = 18, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = message }, peopleList)
	end
	for i, person in msg.people do
		if i <= 8 then
			line(i, (if person.ready then "✅ " else "⏳ ") .. person.name, if person.ready then CREAM else Color3.fromRGB(190, 170, 150))
		end
	end
	if msg.bots > 0 and #msg.people < 8 then
		line(20, Lang.t("lobbyBots", msg.bots, Lang.t("levels")[msg.level] or msg.level), GOLD)
	end
end
text({ Position = UDim2.fromOffset(30, 18), Size = UDim2.new(1, -60, 0, 56), Text = "🐹 Hash Rush", TextColor3 = GOLD }, helpPanel, 4)
do
	local lines = Lang.t(if touchOnly then "helpTouch" else "help")
	for i, line in lines do
		local row = make("Frame", { BackgroundColor3 = Color3.fromRGB(88, 62, 46), BorderSizePixel = 0, Position = UDim2.fromOffset(28, 30 + i * 54), Size = UDim2.fromOffset(496, 46) }, helpPanel)
		make("UICorner", { CornerRadius = UDim.new(0, 14) }, row)
		text({ Position = UDim2.fromOffset(8, 5), Size = UDim2.fromOffset(40, 36), Text = line[1] }, row, false)
		text({ Position = UDim2.fromOffset(56, 9), Size = UDim2.new(1, -68, 0, 28), Text = line[2], TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = CREAM }, row, false)
	end
end

local resultPanel = panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(600, 400), Visible = false }, hud, 30)
local resultScale = make("UIScale", {}, resultPanel)
local resultTitle = text({ Position = UDim2.fromOffset(24, 18), Size = UDim2.new(1, -48, 0, 66), TextColor3 = GOLD }, resultPanel, 4)
local resultWhy = text({ Position = UDim2.fromOffset(24, 86), Size = UDim2.new(1, -48, 0, 26), TextColor3 = CREAM }, resultPanel, false)
local resultRows = make("Frame", { Position = UDim2.fromOffset(28, 126), Size = UDim2.new(1, -56, 0, 250), BackgroundTransparency = 1 }, resultPanel)
make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, resultRows)

local bannerShown = 0
local function banner(message, color)
	bannerShown += 1
	local mine = bannerShown
	bannerLabel.Text = message
	bannerLabel.TextColor3 = color or GOLD
	bannerLabel.Visible = true
	pop(bannerScale)
	task.delay(1.8, function()
		if bannerShown == mine then
			bannerLabel.Visible = false
		end
	end)
end

-- World -------------------------------------------------------------------

local viewFolder = make("Folder", { Name = "HashRushView" }, workspace)

local round = -1
local roster = {} -- [seat] = { id, userId, name, wins, kills }
local hamsters = {} -- [seat] = Hamster
local mySeat = nil
local latest = nil -- the newest snapshot of this round
local flowerKick = 0 -- the sunflower shakes when a seed comes loose
local nestsPainted = false -- each nest's rim takes the colour of whoever starts there
local alarmFor = "" -- the carrier the siren last went off for

-- A seat's colour: its team's in a team round, its own otherwise.
local function seatColor(seat)
	local info = roster[seat]
	return Config.colorOf(seat, info and info.team)
end

-- The portals spin, and each nest's rim takes the colour of whoever starts in it.
local swirls = {}
for _, child in mapFolder:GetChildren() do
	if child.Name == "Swirl" then
		table.insert(swirls, { model = child, at = child:GetPivot() })
	end
end
local nestRims = {}
for _, child in mapFolder:WaitForChild("Nests"):GetChildren() do
	if child.Name == "NestRim" then
		table.insert(nestRims, { part = child, color = child.Color })
	end
end

local function paintNests()
	for _, rim in nestRims do
		rim.part.Color = rim.color
	end
	if not latest then
		return
	end
	for _, p in latest.players do
		local best, bestD = nil, math.huge
		for _, rim in nestRims do
			local d = (Vector2.new(rim.part.Position.X, rim.part.Position.Z) - Vector2.new(p.x, p.y)).Magnitude
			if d < bestD then
				best, bestD = rim, d
			end
		end
		if best and bestD < 1.5 then
			best.part.Color = seatColor(p.id)
		end
	end
end

local function clearHamsters()
	for _, h in hamsters do
		h:destroy()
	end
	table.clear(hamsters)
end

local function drawScores()
	for _, child in scoreRow:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for seat = 1, Config.MAX_PLAYERS do
		local info = roster[seat]
		if info then
			local chip = make("Frame", { LayoutOrder = seat, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30), BackgroundColor3 = PANEL, BorderSizePixel = 0 }, scoreRow)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, chip)
			make("UIStroke", { Thickness = if seat == mySeat then 3 else 2, Color = if seat == mySeat then GOLD else seatColor(seat) }, chip)
			make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6) }, chip)
			make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 12) }, chip)
			local dot = make("Frame", { Size = UDim2.fromOffset(20, 20), BackgroundColor3 = seatColor(seat), BorderSizePixel = 0 }, chip)
			make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, dot)
			make("UIStroke", { Thickness = 2, Color = INK }, dot)
			make("TextLabel", {
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 22),
				BackgroundTransparency = 1,
				Font = FONT,
				TextSize = 18,
				TextColor3 = CREAM,
				Text = ("%s  ⭐%d"):format(info.name, info.wins),
			}, chip)
		end
	end
end

-- A bot's name in this player's language; a person's as Roblox has it.
local function localName(info)
	return if info.bot then Lang.t("names")[info.id] or info.name else info.name
end

local function setRoster(list)
	table.clear(roster)
	mySeat = nil
	for _, info in list do
		info.name = localName(info)
		roster[info.id] = info
		if info.userId == player.UserId then
			mySeat = info.id
		end
	end
	drawScores()
end

local function nameOf(seat)
	return if roster[seat] then roster[seat].name else "?"
end

local function addFeed(message)
	feedCount += 1
	local row = panel({ LayoutOrder = -feedCount, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30) }, feed, 15)
	make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, row)
	make("TextLabel", { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30), BackgroundTransparency = 1, Font = FONT, TextSize = 17, TextColor3 = CREAM, Text = message }, row)
	local scale = make("UIScale", {}, row)
	pop(scale, 0.5)
	task.delay(4, function()
		row:Destroy()
	end)
end

local MULTI = Lang.t("multi")
local predictedSwing = 0 -- os.clock() of the last swing drawn before the server said so

-- On my side: the same team in a team round.
local function mate(seat)
	local a = roster[mySeat]
	local b = roster[seat]
	return a ~= nil and b ~= nil and a.team ~= nil and a.team == b.team
end

-- Somebody has a seed now: what the web game says about it.
local function gotSeed(seat)
	if seat == mySeat then
		banner(Lang.t("gotSeedMe"))
	elseif mate(seat) then
		banner(Lang.t("gotSeedMate", nameOf(seat)))
	else
		banner(Lang.t("gotSeedFoe", nameOf(seat)), RED)
	end
end

local function showEvent(e)
	local h = e.id and hamsters[e.id]
	if e.type == "swing" then
		if h then
			h:swing()
		end
		-- My own swing is heard as the key goes down; the others' are not, as on the web.
		if e.id == mySeat and os.clock() - predictedSwing > 0.4 then
			Fx.sound("swing")
		end
	elseif e.type == "impact" then
		if not e.hit then
			Fx.dust(e.x + e.dx * 2.8, e.y + e.dy * 2.8, 6, 9)
		end
	elseif e.type == "bonk" then
		local mine = e.by == mySeat or e.id == mySeat
		local by = hamsters[e.by]
		local dx, dy = 1, 0
		if by and by.x then
			local len = math.sqrt((e.x - by.x) ^ 2 + (e.y - by.y) ^ 2)
			if len > 0.01 then
				dx, dy = (e.x - by.x) / len, (e.y - by.y) / len
			end
			by:squash(5)
		end
		Fx.stars(e.x, e.y, GOLD, 20)
		Fx.dust(e.x, e.y, 8, 12)
		Fx.ring(e.x, e.y, 7, WHITE, 0.3)
		Fx.words(e.x, e.y, Lang.t("bonkWord"), RED, 9)
		Fx.tumble(e.x, e.y, dx, dy, seatColor(e.id))
		Fx.sound("bonk")
		Fx.shake(if mine then 0.75 else 0.4)
		Fx.hitStop(if mine then 0.1 else 0.05)
		punch = if mine then 1 else 0.5
		if e.id == mySeat then
			flash(RED, 0.4)
			if e.seed then
				banner(Lang.t("lostSeed"), RED)
			end
		elseif e.by == mySeat then
			flash(WHITE, 0.22)
		end
		addFeed(Lang.t("feedBonk", nameOf(e.by), e.seed == true, nameOf(e.id)))
		if e.close then
			banner(Lang.t("superplay", nameOf(e.by)))
			Fx.sound("superplay")
		end
	elseif e.type == "throw" then
		Fx.words(e.x, e.y, Lang.t("throwWord"), GOLD, 8)
		Fx.seedShot(e.x, e.y, e.dx, e.dy, Config.THROW.range)
		Fx.sound("toss")
		Fx.shake(0.2)
		if h then
			h:squash(4)
		end
	elseif e.type == "multi" then
		local name = MULTI[math.min(e.n, #MULTI + 1) - 1]
		banner(Lang.t("multiBanner", nameOf(e.by), name, e.n >= 3))
		Fx.sound(if e.n >= 3 then "triple" else "double")
	elseif e.type == "seed" then
		if h and h.x then
			Fx.stars(h.x, h.y, GOLD, 12)
			Fx.words(h.x, h.y, Lang.t("seedWord"), GOLD, 9)
			h:squash(-5)
		end
		Fx.sound("seed")
		flowerKick = 1
		gotSeed(e.id)
	elseif e.type == "steal" then
		local by = hamsters[e.by]
		Fx.stars(e.x, e.y, CREAM, 10)
		Fx.words(e.x, e.y, Lang.t("stealWord"), CREAM, 8)
		Fx.sound("seed")
		if by then
			by:squash(-4)
		end
		addFeed(Lang.t("feedSteal", nameOf(e.by), nameOf(e.id)))
		if e.id == mySeat then
			banner(Lang.t("gotStolen"), RED)
		else
			gotSeed(e.by)
		end
		if e.close then
			banner(Lang.t("superplay", nameOf(e.by)))
			Fx.sound("superplay")
		end
	elseif e.type == "spawn" then
		Fx.dust(e.x, e.y, 6, 8)
		if e.id == mySeat then
			snapCamera = true
			Fx.sound("spawn")
		end
	elseif e.type == "warp" then
		Fx.dust(e.fromX, e.fromY, 7, 9)
		Fx.ring(e.fromX, e.fromY, 5, Color3.fromRGB(190, 150, 255), 0.3)
		Fx.dust(e.x, e.y, 6, 8)
		Fx.words(e.fromX, e.fromY, Lang.t("warpWord"), CREAM, 7)
		if e.id == mySeat then
			snapCamera = true
			Fx.sound("spawn")
		end
	elseif e.type == "count" then
		Fx.sound("count")
	elseif e.type == "go" then
		Fx.sound("go")
	elseif e.type == "overtime" then
		banner(Lang.t("overtime"), RED)
		Fx.sound("overtime")
	elseif e.type == "rush" then
		banner(Lang.t("rush"), RED)
		Fx.sound("overtime")
	end
end

local MEDALS = { "🥇", "🥈", "🥉" }

local function showResult(msg)
	setRoster(msg.roster)
	local names = {}
	local iWon = false
	for _, seat in msg.winners do
		table.insert(names, nameOf(seat))
		iWon = iWon or seat == mySeat
	end
	local winner = roster[msg.winners[1]]
	local wholeTeam = winner and winner.team ~= nil
	for _, seat in msg.winners do
		wholeTeam = wholeTeam and roster[seat] and roster[seat].team == winner.team
	end
	if wholeTeam then
		resultTitle.Text = Lang.t("teamWin", Lang.t("teams")[winner.team])
		resultTitle.TextColor3 = Config.TEAMS[winner.team].color
	else
		resultTitle.Text = if #names > 0 then Lang.t("win", table.concat(names, " · "), #names) else Lang.t("noWinner")
		resultTitle.TextColor3 = GOLD
	end
	resultWhy.Text = Lang.t(if msg.left then "whyLeft" elseif msg.timeout then "whyTimeout" else "whyHome")
	local sorted = table.clone(msg.roster)
	table.sort(sorted, function(a, b)
		if a.wins ~= b.wins then
			return a.wins > b.wins
		end
		return a.id < b.id
	end)
	for _, child in resultRows:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	local rowHeight = math.min(42, math.floor(250 / math.max(1, #sorted)) - 6)
	for i, info in sorted do
		local me = info.id == mySeat
		local row = make("Frame", { LayoutOrder = i, BackgroundColor3 = if me then Color3.fromRGB(110, 78, 48) else Color3.fromRGB(88, 62, 46), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, rowHeight) }, resultRows)
		make("UICorner", { CornerRadius = UDim.new(0, 12) }, row)
		if me then
			make("UIStroke", { Thickness = 2, Color = GOLD }, row)
		end
		text({ Position = UDim2.fromOffset(8, 3), Size = UDim2.new(0, 36, 1, -6), Text = MEDALS[i] or tostring(i) }, row, false)
		local dot = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 52, 0.5, 0), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = seatColor(info.id), BorderSizePixel = 0 }, row)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, dot)
		make("UIStroke", { Thickness = 2, Color = INK }, dot)
		text({ Position = UDim2.fromOffset(84, 6), Size = UDim2.new(1, -280, 1, -12), Text = info.name, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = CREAM }, row, false)
		text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -100, 0, 6), Size = UDim2.new(0, 84, 1, -12), Text = Lang.t("wins", info.wins), TextColor3 = GOLD }, row, false)
		text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 6), Size = UDim2.new(0, 80, 1, -12), Text = ("👊 %d"):format(info.kills), TextColor3 = CREAM }, row, false)
	end
	resultPanel.Visible = true
	pop(resultScale, 0.6)
	bigLabel.Visible = false
	alarmRim.Visible = false
	Fx.music(nil)
	-- As on the web: the winner's tune for whoever won, and for whoever only watched.
	if iWon or not mySeat then
		Fx.sound("win")
	else
		Fx.sound("lose")
	end
	if iWon then
		Fx.confetti(screen)
	end
	-- The lobby tune comes back once the sting has had its say.
	task.delay(4, function()
		if resultPanel.Visible then
			Fx.music("lobby")
		end
	end)
end

-- A new round to draw: the server's, or the tutorial's own.
local function beginRound(list, number)
	round = number
	latest = nil
	clearHamsters()
	setRoster(list)
	for _, info in list do
		hamsters[info.id] = Hamster.new(viewFolder, info, info.id == mySeat)
	end
	resultPanel.Visible = false
	helpPanel.Visible = false
	readyButton.Visible = false
	botBar.Visible = false
	snapCamera = true
	nestsPainted = false
	alarmFor = ""
end

-- Tutorial ------------------------------------------------------------------
-- While it runs, the server's round is not drawn: the tutorial's own is.

local tutorPanel = panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 108), Size = UDim2.fromOffset(700, 132), Visible = false }, hud, 22)
local tutorScale = make("UIScale", {}, tutorPanel)
local tutorTitle = text({ Position = UDim2.fromOffset(22, 12), Size = UDim2.new(1, -200, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = GOLD }, tutorPanel, 3)
local tutorText = text({ Position = UDim2.fromOffset(22, 54), Size = UDim2.new(1, -44, 0, 66), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextColor3 = CREAM, TextScaled = true }, tutorPanel, false)
local tutorButton = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 12), Size = UDim2.fromOffset(164, 38), BackgroundColor3 = Color3.fromRGB(110, 78, 48), BorderSizePixel = 0, AutoButtonColor = false, Font = FONT, TextSize = 20, TextColor3 = CREAM, Text = "" }, tutorPanel)
make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, tutorButton)
make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 2, Color = INK }, tutorButton)

-- A bouncing arrow over where to go next.
local marker = make("Part", { Name = "TutorialMarker", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.one }, viewFolder)
local markerGui = make("BillboardGui", { Size = UDim2.fromScale(7, 7), AlwaysOnTop = true, LightInfluence = 0, Enabled = false }, marker)
text({ Size = UDim2.fromScale(1, 0.62), Text = "⬇", TextColor3 = GOLD }, markerGui, 4)
local markerLabel = text({ Position = UDim2.fromScale(-0.5, 0.6), Size = UDim2.fromScale(2, 0.3), TextColor3 = GOLD }, markerGui, 3)

local tutorial = nil -- the one running, if any
local tutorTarget = nil -- { at, icon, label }
local onLastStep = false

local function endTutorial()
	if tutorial then
		tutorial.stop()
	end
	tutorial = nil
	tutorTarget = nil
	tutorPanel.Visible = false
	markerGui.Enabled = false
	round = -1
	latest = nil
	clearHamsters()
	setRoster({})
	paintNests()
	-- The lobby, or the round going on, as the server has it now.
	readyButton.Visible = false
	roundRemote:FireServer()
end

local function startTutorial()
	if tutorial then
		return
	end
	if myReady then
		setReady(false)
	end
	helpPanel.Visible = false
	readyButton.Visible = false
	botBar.Visible = false
	resultPanel.Visible = false
	notice("")
	Fx.music("game")
	tutorial = Tutorial.run({
		begin = function(list)
			beginRound(list, -2)
		end,
		snapshot = function(snap)
			latest = snap
		end,
		event = showEvent,
		say = function(index, step, again)
			onLastStep = step.last == true
			tutorPanel.Visible = true
			tutorTitle.Text = ("🎓 %d/%d · %s"):format(index, Tutorial.STEPS, step.title)
			tutorText.Text = again or step.text
			tutorButton.Text = Lang.t(if onLastStep then "tutorStart" else "tutorSkip")
			tutorButton.BackgroundColor3 = if onLastStep then Color3.fromRGB(96, 196, 96) else Color3.fromRGB(110, 78, 48)
			pop(tutorScale, 0.85)
			if onLastStep then
				tutorTarget = nil
			end
		end,
		target = function(at, icon, label)
			tutorTarget = if at then { at = at, icon = icon, label = label } else nil
		end,
		cheer = function()
			banner(Lang.t("cheer"))
			Fx.sound("double")
			tutorTarget = nil
		end,
		finish = endTutorial,
	})
end

tutorButton.Activated:Connect(function()
	endTutorial()
end)

-- Whoever has never played a round is taken through it once, on arrival.
local offered = false
local function offerTutorial()
	if offered or tutorial or player:GetAttribute("HRGames") ~= 0 or round ~= -1 or resultPanel.Visible then
		return
	end
	offered = true
	startTutorial()
end
player:GetAttributeChangedSignal("HRGames"):Connect(offerTutorial)

local tutorialButton = make("TextButton", { Position = UDim2.fromOffset(540, 88), Size = UDim2.fromOffset(252, 50), BackgroundColor3 = Color3.fromRGB(240, 176, 44), BorderSizePixel = 0, AutoButtonColor = false, Font = FONT, TextSize = 24, TextColor3 = WHITE, Text = Lang.t("tutorial") }, helpPanel)
make("UICorner", { CornerRadius = UDim.new(0, 16) }, tutorialButton)
make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 3, Color = INK }, tutorialButton)
make("UIStroke", { Thickness = 2.5, Color = INK }, tutorialButton)
tutorialButton.Activated:Connect(startTutorial)

roundRemote.OnClientEvent:Connect(function(msg)
	if tutorial then
		return
	end
	if msg.kind == "lobby" then
		-- After a round the result stays up, with the hamsters where they stood.
		if not resultPanel.Visible then
			round = -1
			latest = nil
			clearHamsters()
			setRoster({})
			paintNests()
			helpPanel.Visible = true
			Fx.music("lobby")
		end
		bigLabel.Visible = false
		alarmRim.Visible = false
		timerLabel.Text = Lang.t("waiting")
		timerLabel.TextColor3 = WHITE
		timerScale.Scale = 1
		if not readyButton.Visible then
			myReady = false
			showReady()
			readyButton.Visible = true
		end
		botBar.Visible = true
		botLabel.Text = Lang.t("botCount", msg.bots)
		levelButton.Text = Lang.t("level", Lang.t("levels")[msg.level] or msg.level)
		modeButton.Text = Lang.t(if msg.teams then "teamMode" else "solo")
		showPeople(msg)
		offerTutorial()
		if msg.left then
			notice(Lang.t("startsIn", msg.left, msg.ready, msg.count))
		elseif msg.short > 0 then
			notice(Lang.t("needRival", msg.short))
		else
			notice(Lang.t("allReady", msg.ready, msg.count))
		end
	elseif msg.kind == "start" then
		beginRound(msg.roster, msg.round)
		Fx.music("game")
		Fx.sound("count")
		notice(if mySeat then "" else Lang.t("watching"))
	elseif msg.kind == "events" then
		if msg.round == round then
			for _, e in msg.list do
				showEvent(e)
			end
		end
	elseif msg.kind == "result" then
		showResult(msg)
	end
end)

snapRemote.OnClientEvent:Connect(function(packed)
	if tutorial then
		return
	end
	local snap = Snapshot.decode(packed)
	if snap.round ~= round % 256 then
		return
	end
	-- Unreliable: an older snapshot can turn up after a newer one.
	if latest and (snap.tick - latest.tick) % 65536 >= 32768 then
		return
	end
	latest = snap
end)

-- The bonk key answers at once: the paw goes up before the server has heard.
player:GetAttributeChangedSignal("HRBonk"):Connect(function()
	local h = mySeat and hamsters[mySeat]
	local me = nil
	if latest then
		for _, p in latest.players do
			if p.id == mySeat then
				me = p
			end
		end
	end
	if not h or not me or latest.phase ~= "playing" or me.dazed or me.x < latest.homeX then
		return
	end
	if os.clock() - predictedSwing < Config.BONK.cooldown then
		return
	end
	predictedSwing = os.clock()
	h:swing()
	Fx.sound("swing")
end)

-- Where to draw my own hamster: where the server last saw it, plus what the keys
-- have asked for since then that the server cannot have heard about yet.
local moves = {} -- { t, dx, dy }, oldest first
local function ahead(p, dt)
	local now = os.clock()
	local move = player:GetAttribute("HRMove")
	local speed = Config.SPEED
	if p.carrying then
		speed *= if p.alarm then Config.LAST_STRETCH_SPEED else Config.CARRY_SPEED
	end
	if latest.phase ~= "playing" or p.dazed or p.windup or now - predictedSwing < Config.BONK.windup then
		speed = 0
	elseif p.recovery then
		speed *= Config.BONK.recoveryMove
	end
	if typeof(move) == "Vector2" and speed > 0 then
		table.insert(moves, { t = now, dx = move.X * speed * dt, dy = move.Y * speed * dt })
	end
	local window = math.clamp(player:GetNetworkPing() * 2 + 0.02, 0.02, 0.25)
	while moves[1] and now - moves[1].t > window do
		table.remove(moves, 1)
	end
	local spot = { x = p.x, y = p.y }
	for _, m in moves do
		spot.x += m.dx
		spot.y += m.dy
	end
	Sim.collide(Map, spot)
	return spot.x, spot.y
end

local function clock(seconds)
	return ("%d:%02d"):format(seconds // 60, seconds % 60)
end

local time = 0
local shownCount = nil
local tickBeat = -1
local stepDust = {}

-- Pointers at the edge of the screen for what matters but is out of sight: a
-- rival or a team-mate running with a seed, and where to go next.
local pointerLayer = make("Frame", { Name = "Pointers", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5 }, screen)
local pointers = {} -- [key] = its frames, and whether it is wanted this frame

local function pointer(key)
	local ptr = pointers[key]
	if not ptr then
		local frame = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = PANEL, BorderSizePixel = 0, ZIndex = 5 }, pointerLayer)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, frame)
		local rim = make("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 4, Color = INK }, frame)
		local icon = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.66, 0.66), ZIndex = 6 }, frame, false)
		local caption = text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 3), Size = UDim2.fromScale(2.4, 0.42), ZIndex = 6 }, frame, 2)
		local arrow = text({ AnchorPoint = Vector2.new(0.5, 0.5), Text = "▲", ZIndex = 6 }, pointerLayer, 2)
		ptr = { frame = frame, rim = rim, icon = icon, caption = caption, arrow = arrow }
		pointers[key] = ptr
	end
	ptr.wanted = true
	return ptr
end

-- Shows a pointer for `world` only while it is off the screen.
local function pointTo(key, world, icon, caption, color, urgent)
	local camera = workspace.CurrentCamera
	local view = camera.ViewportSize
	local scale = hudScale.Scale
	local margin = 62 * scale
	local at, onScreen = camera:WorldToViewportPoint(world)
	if onScreen and at.X > margin * 0.6 and at.X < view.X - margin * 0.6 and at.Y > margin * 0.6 and at.Y < view.Y - margin * 0.6 then
		return
	end
	local middle = view / 2
	local away = Vector2.new(at.X, at.Y) - middle
	if at.Z < 0 then
		away = -away
	end
	if away.Magnitude < 1 then
		return
	end
	-- Where the line from the middle of the screen to it leaves the screen.
	local reach = math.min((view.X / 2 - margin) / math.max(1e-3, math.abs(away.X)), (view.Y / 2 - margin) / math.max(1e-3, math.abs(away.Y)))
	local spot = middle + away * reach
	local unit = away.Unit
	local ptr = pointer(key)
	ptr.frame.Size = UDim2.fromOffset(54 * scale, 54 * scale)
	ptr.frame.Position = UDim2.fromOffset(spot.X, spot.Y)
	ptr.frame.Visible = true
	ptr.frame.BackgroundColor3 = if urgent and math.sin(time * 12) > 0 then RED else PANEL
	ptr.rim.Color = color
	ptr.icon.Text = icon
	ptr.caption.Text = caption
	ptr.caption.TextColor3 = color
	ptr.arrow.Visible = true
	ptr.arrow.Size = UDim2.fromOffset(26 * scale, 26 * scale)
	ptr.arrow.Position = UDim2.fromOffset(spot.X + unit.X * 42 * scale, spot.Y + unit.Y * 42 * scale)
	ptr.arrow.Rotation = math.deg(math.atan2(unit.Y, unit.X)) + 90
	ptr.arrow.TextColor3 = color
end

local function showPointers()
	for _, ptr in pointers do
		ptr.wanted = false
	end
	if latest and not resultPanel.Visible and latest.phase ~= "over" then
		local mine = nil
		for _, p in latest.players do
			local h = hamsters[p.id]
			if p.id == mySeat then
				mine = p
			elseif p.carrying and h and h.x then
				local side = Lang.t(if mate(p.id) then "cover" else "block")
				pointTo("carrier" .. p.id, Vector3.new(h.x, 1, h.y), if p.alarm then "🚨" else "🌻", nameOf(p.id) .. " · " .. side, seatColor(p.id), p.alarm)
			end
		end
		-- Where to go: the tutorial says; otherwise the flower for a seed, then home with it.
		local h = mySeat and hamsters[mySeat]
		if tutorial then
			if tutorTarget then
				pointTo("tutorial", tutorTarget.at, tutorTarget.icon, tutorTarget.label, GOLD, false)
			end
		elseif mine and h and h.x and not mine.dazed then
			if mine.carrying then
				pointTo("home", Vector3.new(latest.homeX - 2, 0, math.clamp(h.y, Map.bounds.y1 + 4, Map.bounds.y2 - 4)), "🏠", Lang.t("toHome"), GOLD, false)
			else
				pointTo("flower", Vector3.new(FLOWER.x, 1, FLOWER.y), "🌻", Lang.t("flower"), GOLD, false)
			end
		end
	end
	for _, ptr in pointers do
		if not ptr.wanted then
			ptr.frame.Visible = false
			ptr.arrow.Visible = false
		end
	end
end

RunService:BindToRenderStep("HashRushView", Enum.RenderPriority.Camera.Value + 1, function(dt)
	time += dt
	fitHud()
	-- Close in over my own hamster while I am in a round; the whole meadow otherwise.
	local mine = mySeat and hamsters[mySeat]
	local target = if mine and mine.x and latest and latest.phase ~= "over" and not resultPanel.Visible then Vector2.new(mine.x, mine.y) else nil
	placeCamera(dt, target)
	showPointers()
	markerGui.Enabled = tutorTarget ~= nil
	if tutorTarget then
		marker.Position = tutorTarget.at + Vector3.new(0, 5 + math.abs(math.sin(time * 4)) * 1.5, 0)
		markerLabel.Text = tutorTarget.label
	end
	for k, swirl in swirls do
		swirl.model:PivotTo(swirl.at * CFrame.Angles(0, -time * 2.4 * (if k % 2 == 0 then -1 else 1), 0))
	end
	-- The sunflower nods in the breeze, and shakes when it is being nibbled.
	flowerKick = math.max(0, flowerKick - dt * 2.5)
	local busy = if latest and latest.nibbler ~= 0 then 1 else 0
	local sway = 0.05 + busy * 0.06 + flowerKick * 0.25
	local rate = 1.6 + busy * 9 + flowerKick * 14
	sunflower:PivotTo(sunflowerAt * CFrame.Angles(math.sin(time * rate) * sway, time * 0.25, math.cos(time * rate * 0.83) * sway))

	if not latest then
		return
	end
	-- A big hit holds the world still for a moment.
	if Fx.frozen() then
		return
	end
	-- The nests are coloured from where everyone starts, once a round.
	if not nestsPainted and latest.phase == "countdown" then
		nestsPainted = true
		paintNests()
	end

	local seen = {}
	local carrying = false
	local alarm = false
	for _, p in latest.players do
		local h = hamsters[p.id]
		if h then
			seen[p.id] = true
			local x, y = p.x, p.y
			-- The tutorial's round is played here already: nothing to get ahead of.
			if h.me and not tutorial then
				x, y = ahead(p, dt)
				carrying = p.carrying
			end
			-- It slides to where it should be rather than jumping, unless it is far.
			if h.x and math.abs(x - h.x) + math.abs(y - h.y) <= 5 then
				local k = 1 - math.exp(-dt * (if h.me then 45 else 30))
				x = h.x + (x - h.x) * k
				y = h.y + (y - h.y) * k
			end
			alarm = alarm or p.alarm

			local status = ""
			local nibbling = latest.nibbler == p.id
			local bar = if nibbling then latest.gather else nil
			if p.dazed then
				status = Lang.t("dazed")
			elseif nibbling then
				status = Lang.t("digging")
			elseif p.pick > 0 then
				-- Rubbing up against a carrier to take its seed.
				status = Lang.t("snatching")
				bar = p.pick
			end
			-- Hints only its own player sees.
			if h.me and p.carrying and latest.phase == "playing" then
				for _, warp in Map.warps do
					if (Vector2.new(p.x, p.y) - Vector2.new(warp.x, warp.y)).Magnitude <= warp.r + 0.5 then
						status = Lang.t("noWarpCarrying")
					end
				end
			end
			if h.me and not p.carrying and not p.dazed then
				local inRing = (Vector2.new(p.x, p.y) - Vector2.new(FLOWER.x, FLOWER.y)).Magnitude <= FLOWER.gatherR
				if inRing and (nibbling or latest.nibbler == 0) and player:GetAttribute("HRMoving") then
					status = Lang.t("holdStill")
				elseif inRing and not nibbling and latest.nibbler ~= 0 then
					status = Lang.t("queue")
				end
			end
			h:draw(dt, x, y, p, { bar = bar, status = status })

			-- Dust under running feet.
			if h.pace > Config.SPEED * 0.5 then
				local last = stepDust[p.id] or 0
				if time - last > 0.16 then
					stepDust[p.id] = time
					Fx.dust(x - p.fx * 1.2, y - p.fy * 1.2, 1, 3)
				end
			end
		end
	end
	-- Whoever left the game took its hamster along.
	for seat, h in hamsters do
		if not seen[seat] then
			h:destroy()
			hamsters[seat] = nil
		end
	end
	-- Input shows the throw button while this is set.
	if player:GetAttribute("HRCarrying") ~= carrying then
		player:SetAttribute("HRCarrying", carrying)
	end

	-- In overtime home grows towards the flower.
	if homeEdge.Position.X ~= latest.homeX then
		local size = homePart.Size
		local at = homePart.Position
		homePart.Size = Vector3.new(latest.homeX - HOME_X1, size.Y, size.Z)
		homePart.Position = Vector3.new((HOME_X1 + latest.homeX) / 2, at.Y, at.Z)
		homeEdge.Position = Vector3.new(latest.homeX, homeEdge.Position.Y, homeEdge.Position.Z)
	end
	local overtime = latest.time > Config.OVERTIME.start
	homeEdge.Transparency = if overtime then 0.1 + (math.sin(time * 10) + 1) * 0.25 else 0.15

	-- A seed is nearly home: everyone gets the red rim, and once per seed the
	-- siren and a word on who it is, as on the web.
	alarm = alarm and latest.phase == "playing"
	alarmRim.Visible = alarm
	if alarm then
		alarmStroke.Transparency = 0.35 + (math.sin(time * 12) + 1) * 0.3
	end
	local carrier = nil
	for _, p in latest.players do
		if p.alarm and latest.phase == "playing" then
			carrier = p
		end
	end
	local key = if carrier then tostring(carrier.id) else ""
	if key ~= "" and key ~= alarmFor then
		if carrier.id == mySeat then
			banner(Lang.t("alarmMe"), RED)
		elseif mate(carrier.id) then
			banner(Lang.t("alarmMate", nameOf(carrier.id)), RED)
		else
			banner(Lang.t("alarmFoe", nameOf(carrier.id)), RED)
		end
		Fx.sound("siren")
	end
	-- Stepping back out and in again does not repeat it; a new seed does.
	local anyCarrier = false
	for _, p in latest.players do
		anyCarrier = anyCarrier or p.carrying
	end
	if key ~= "" or not anyCarrier then
		alarmFor = key
	end

	-- The clock is heard ticking all through overtime, twice a second.
	local beat = if overtime and latest.phase == "playing" then math.floor(latest.time * 2) else -1
	if beat ~= tickBeat then
		tickBeat = beat
		if beat >= 0 then
			Fx.sound(if beat % 2 == 1 then "tock" else "tick")
		end
	end

	-- The count before the start, then "go" for a moment.
	local counting = latest.phase == "countdown"
	local big = if counting then tostring(math.max(1, math.ceil(latest.countdown))) elseif latest.phase == "playing" and latest.time < 0.8 then Lang.t("go") else nil
	bigLabel.Visible = big ~= nil and not resultPanel.Visible and not tutorial
	if big ~= shownCount then
		shownCount = big
		if big then
			bigLabel.Text = big
			bigLabel.TextColor3 = if counting then WHITE else GOLD
			pop(bigScale, 0.2)
		end
	end
	if tutorial then
		timerLabel.Text = Lang.t("practice")
		timerLabel.TextColor3 = WHITE
		timerScale.Scale = 1
	elseif counting then
		timerLabel.Text = Lang.t("getReady")
		timerLabel.TextColor3 = WHITE
		timerScale.Scale = 1
	else
		timerLabel.Text = (if overtime then "🔥 " else "⏱ ") .. clock(math.floor(latest.time))
		timerLabel.TextColor3 = if overtime then RED else WHITE
		timerScale.Scale = if overtime then 1 + math.max(0, math.sin(time * 6)) * 0.06 else 1
	end
end)

fitHud()
placeCamera(0)
-- Ready to draw: ask the server where things stand.
roundRemote:FireServer()
]]></ProtectedString></Properties></Item></Item></Item></roblox>